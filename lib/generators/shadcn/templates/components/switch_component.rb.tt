# frozen_string_literal: true

module Ui
  class SwitchComponent < BaseComponent
    # @param name [String] The switch name attribute
    # @param checked [Boolean] Whether the switch is checked
    # @param disabled [Boolean] Whether the switch is disabled
    # @param id [String] The switch ID
    # @param class_name [String] Additional CSS classes
    # @param html_options [Hash] Additional HTML attributes
    def initialize(name: nil, checked: false, disabled: false, id: nil, class_name: nil, **html_options)
      @name = name
      @checked = checked
      @disabled = disabled
      @id = id || "switch-#{SecureRandom.hex(4)}"
      @class_name = class_name
      @html_options = html_options
    end

    def call
      tag.button(
        type: "button",
        role: "switch",
        "aria-checked": @checked.to_s,
        "data-state": @checked ? "checked" : "unchecked",
        disabled: @disabled,
        class: switch_classes,
        id: @id,
        "data-controller": "switch",
        "data-action": "click->switch#toggle",
        **@html_options
      ) do
        hidden_input + thumb
      end
    end

    private

    def switch_classes
      cn(
        # Matching shadcn/ui switch
        "peer inline-flex h-5 w-9 shrink-0 cursor-pointer items-center rounded-full border-2 border-transparent shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:cursor-not-allowed disabled:opacity-50 data-[state=checked]:bg-primary data-[state=unchecked]:bg-input",
        @class_name
      )
    end

    def hidden_input
      tag.input(
        type: "hidden",
        name: @name,
        value: @checked ? "1" : "0",
        "data-switch-target": "input"
      )
    end

    def thumb
      tag.span(
        class: "pointer-events-none block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform data-[state=checked]:translate-x-4 data-[state=unchecked]:translate-x-0",
        "data-state": @checked ? "checked" : "unchecked",
        "data-switch-target": "thumb"
      )
    end
  end
end
