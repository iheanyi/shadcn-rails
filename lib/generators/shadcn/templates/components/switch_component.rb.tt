# frozen_string_literal: true

module Ui
  class SwitchComponent < BaseComponent
    attr_reader :name, :checked, :disabled, :id, :class_name, :html_options

    # @param name [String] The switch name attribute
    # @param checked [Boolean] Whether the switch is checked
    # @param disabled [Boolean] Whether the switch is disabled
    # @param id [String] The switch ID
    # @param class_name [String] Additional CSS classes
    # @param html_options [Hash] Additional HTML attributes
    def initialize(
      name: nil,
      checked: false,
      disabled: false,
      id: nil,
      class_name: nil,
      **html_options
    )
      @name = name
      @checked = checked
      @disabled = disabled
      @id = id || generate_id("switch")
      @class_name = class_name
      @html_options = html_options
    end

    def call
      tag.label(class: "relative inline-flex items-center cursor-pointer", for: id) do
        safe_join([
          hidden_field,
          checkbox_input,
          switch_track
        ])
      end
    end

    private

    def hidden_field
      return unless name

      tag.input(type: "hidden", name: name, value: "0")
    end

    def checkbox_input
      tag.input(
        type: "checkbox",
        name: name,
        value: "1",
        checked: checked,
        disabled: disabled,
        id: id,
        class: "peer sr-only",
        **html_options
      )
    end

    def switch_track
      tag.span(class: switch_classes) do
        tag.span(class: thumb_classes)
      end
    end

    def switch_classes
      cn(
        "peer inline-flex h-6 w-11 shrink-0 cursor-pointer items-center rounded-full border-2 border-transparent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:cursor-not-allowed disabled:opacity-50 peer-checked:bg-primary bg-input",
        class_name
      )
    end

    def thumb_classes
      "pointer-events-none block h-5 w-5 rounded-full bg-background shadow-lg ring-0 transition-transform peer-checked:translate-x-5 translate-x-0"
    end
  end
end
