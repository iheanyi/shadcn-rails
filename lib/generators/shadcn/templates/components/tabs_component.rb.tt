# frozen_string_literal: true

module Ui
  class TabsComponent < BaseComponent
    renders_many :tabs, "TabComponent"
    renders_many :panels, "PanelComponent"

    # @param default_value [String] The default active tab value
    # @param class_name [String] Additional CSS classes
    # @param html_options [Hash] Additional HTML attributes
    def initialize(default_value: nil, class_name: nil, **html_options)
      @default_value = default_value
      @class_name = class_name
      @html_options = html_options
    end

    def call
      tag.div(
        class: cn("w-full", @class_name),
        "data-controller": "tabs",
        "data-tabs-default-value": @default_value,
        **@html_options
      ) do
        tabs_list + panels_content
      end
    end

    private

    def tabs_list
      tag.div(
        class: "inline-flex h-9 items-center justify-center rounded-lg bg-muted p-1 text-muted-foreground",
        role: "tablist"
      ) do
        safe_join(tabs)
      end
    end

    def panels_content
      safe_join(panels)
    end

    class TabComponent < BaseComponent
      # @param value [String] The tab value (must match panel value)
      # @param class_name [String] Additional CSS classes
      # @param html_options [Hash] Additional HTML attributes
      def initialize(value:, class_name: nil, **html_options)
        @value = value
        @class_name = class_name
        @html_options = html_options
      end

      def call
        tag.button(
          content,
          type: "button",
          role: "tab",
          class: tab_classes,
          "data-tabs-target": "tab",
          "data-action": "click->tabs#select",
          "data-value": @value,
          **@html_options
        )
      end

      private

      def tab_classes
        cn(
          # Matching shadcn/ui tabs trigger
          "inline-flex items-center justify-center whitespace-nowrap rounded-md px-3 py-1 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 data-[state=active]:bg-background data-[state=active]:text-foreground data-[state=active]:shadow",
          @class_name
        )
      end
    end

    class PanelComponent < BaseComponent
      # @param value [String] The panel value (must match tab value)
      # @param class_name [String] Additional CSS classes
      # @param html_options [Hash] Additional HTML attributes
      def initialize(value:, class_name: nil, **html_options)
        @value = value
        @class_name = class_name
        @html_options = html_options
      end

      def call
        tag.div(
          content,
          role: "tabpanel",
          class: panel_classes,
          "data-tabs-target": "panel",
          "data-value": @value,
          hidden: true,
          **@html_options
        )
      end

      private

      def panel_classes
        cn(
          "mt-2 ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2",
          @class_name
        )
      end
    end
  end
end
