# frozen_string_literal: true

module Ui
  class SpinnerComponent < BaseComponent
    SIZES = {
      sm: "h-4 w-4",
      default: "h-6 w-6",
      lg: "h-8 w-8",
      xl: "h-12 w-12"
    }.freeze

    attr_reader :size, :class_name, :html_options

    # @param size [Symbol] The spinner size (:sm, :default, :lg, :xl)
    # @param class_name [String] Additional CSS classes
    # @param html_options [Hash] Additional HTML attributes
    def initialize(size: :default, class_name: nil, **html_options)
      @size = size.to_sym
      @class_name = class_name
      @html_options = html_options
    end

    def call
      tag.svg(
        xmlns: "http://www.w3.org/2000/svg",
        fill: "none",
        viewBox: "0 0 24 24",
        class: spinner_classes,
        **html_options
      ) do
        safe_join([
          tag.circle(
            class: "opacity-25",
            cx: "12",
            cy: "12",
            r: "10",
            stroke: "currentColor",
            "stroke-width": "4"
          ),
          tag.path(
            class: "opacity-75",
            fill: "currentColor",
            d: "M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
          )
        ])
      end
    end

    private

    def spinner_classes
      cn(
        "animate-spin",
        SIZES[size],
        class_name
      )
    end
  end
end
