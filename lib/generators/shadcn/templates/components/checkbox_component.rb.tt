# frozen_string_literal: true

module Ui
  class CheckboxComponent < BaseComponent
    # @param name [String] The checkbox name attribute
    # @param value [String] The checkbox value
    # @param checked [Boolean] Whether the checkbox is checked
    # @param disabled [Boolean] Whether the checkbox is disabled
    # @param id [String] The checkbox ID
    # @param class_name [String] Additional CSS classes
    # @param html_options [Hash] Additional HTML attributes
    def initialize(name: nil, value: "1", checked: false, disabled: false, id: nil, class_name: nil, **html_options)
      @name = name
      @value = value
      @checked = checked
      @disabled = disabled
      @id = id || "checkbox-#{SecureRandom.hex(4)}"
      @class_name = class_name
      @html_options = html_options
    end

    def call
      tag.button(
        type: "button",
        role: "checkbox",
        "aria-checked": @checked.to_s,
        "data-state": @checked ? "checked" : "unchecked",
        disabled: @disabled,
        class: checkbox_classes,
        id: @id,
        "data-controller": "checkbox",
        "data-action": "click->checkbox#toggle",
        **@html_options
      ) do
        # Hidden input for form submission
        hidden_input + checkmark_icon
      end
    end

    private

    def checkbox_classes
      cn(
        # Matching shadcn/ui checkbox
        "peer h-4 w-4 shrink-0 rounded-sm border border-primary shadow focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50 data-[state=checked]:bg-primary data-[state=checked]:text-primary-foreground",
        @class_name
      )
    end

    def hidden_input
      tag.input(
        type: "hidden",
        name: @name,
        value: @checked ? @value : "",
        "data-checkbox-target": "input"
      )
    end

    def checkmark_icon
      tag.span(class: "flex items-center justify-center text-current #{@checked ? '' : 'hidden'}", "data-checkbox-target": "icon") do
        tag.svg(
          xmlns: "http://www.w3.org/2000/svg",
          viewBox: "0 0 24 24",
          fill: "none",
          stroke: "currentColor",
          "stroke-width": "2",
          "stroke-linecap": "round",
          "stroke-linejoin": "round",
          class: "h-3 w-3"
        ) do
          tag.polyline(points: "20 6 9 17 4 12")
        end
      end
    end
  end
end
