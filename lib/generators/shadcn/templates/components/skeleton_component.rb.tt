# frozen_string_literal: true

module Ui
  class SkeletonComponent < BaseComponent
    # @param class_name [String] Additional CSS classes
    # @param html_options [Hash] Additional HTML attributes
    def initialize(class_name: nil, **html_options)
      @class_name = class_name
      @html_options = html_options
    end

    def call
      tag.div(class: skeleton_classes, **@html_options)
    end

    private

    def skeleton_classes
      cn(
        # Matching shadcn/ui skeleton
        "animate-pulse rounded-md bg-primary/10",
        @class_name
      )
    end
  end
end
