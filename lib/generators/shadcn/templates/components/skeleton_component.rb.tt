# frozen_string_literal: true

module Ui
  class SkeletonComponent < BaseComponent
    attr_reader :class_name, :html_options

    # @param class_name [String] Additional CSS classes (use to set dimensions)
    # @param html_options [Hash] Additional HTML attributes
    def initialize(class_name: nil, **html_options)
      @class_name = class_name
      @html_options = html_options
    end

    def call
      tag.div(class: skeleton_classes, **html_options)
    end

    private

    def skeleton_classes
      cn(
        "animate-pulse rounded-md bg-muted",
        class_name
      )
    end
  end
end
