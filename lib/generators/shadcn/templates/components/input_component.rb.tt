# frozen_string_literal: true

module Ui
  class InputComponent < BaseComponent
    attr_reader :type, :name, :value, :placeholder, :disabled, :required, :readonly,
                :autocomplete, :class_name, :html_options

    # @param type [String] The input type (text, email, password, number, etc.)
    # @param name [String] The input name attribute
    # @param value [String] The input value
    # @param placeholder [String] The placeholder text
    # @param disabled [Boolean] Whether the input is disabled
    # @param required [Boolean] Whether the input is required
    # @param readonly [Boolean] Whether the input is readonly
    # @param autocomplete [String] The autocomplete attribute
    # @param class_name [String] Additional CSS classes
    # @param html_options [Hash] Additional HTML attributes
    def initialize(
      type: "text",
      name: nil,
      value: nil,
      placeholder: nil,
      disabled: false,
      required: false,
      readonly: false,
      autocomplete: nil,
      class_name: nil,
      **html_options
    )
      @type = type
      @name = name
      @value = value
      @placeholder = placeholder
      @disabled = disabled
      @required = required
      @readonly = readonly
      @autocomplete = autocomplete
      @class_name = class_name
      @html_options = html_options
    end

    def call
      tag.input(
        type: type,
        name: name,
        value: value,
        placeholder: placeholder,
        disabled: disabled,
        required: required,
        readonly: readonly,
        autocomplete: autocomplete,
        class: input_classes,
        **html_options
      )
    end

    private

    def input_classes
      cn(
        base_classes,
        disabled_classes,
        class_name
      )
    end

    def base_classes
      "flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
    end

    def disabled_classes
      "cursor-not-allowed opacity-50" if disabled
    end
  end
end
