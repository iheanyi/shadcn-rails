# frozen_string_literal: true

module Ui
  class InputComponent < BaseComponent
    # @param type [String] The input type
    # @param name [String] The input name attribute
    # @param value [String] The input value
    # @param placeholder [String] Placeholder text
    # @param disabled [Boolean] Whether the input is disabled
    # @param class_name [String] Additional CSS classes
    # @param html_options [Hash] Additional HTML attributes
    def initialize(type: "text", name: nil, value: nil, placeholder: nil, disabled: false, class_name: nil, **html_options)
      @type = type
      @name = name
      @value = value
      @placeholder = placeholder
      @disabled = disabled
      @class_name = class_name
      @html_options = html_options
    end

    def call
      tag.input(
        type: @type,
        name: @name,
        value: @value,
        placeholder: @placeholder,
        disabled: @disabled,
        class: input_classes,
        **@html_options
      )
    end

    private

    def input_classes
      cn(
        # Base classes matching shadcn/ui
        "flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50",
        @class_name
      )
    end
  end
end
