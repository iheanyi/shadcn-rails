# frozen_string_literal: true

module Ui
  class AvatarComponent < BaseComponent
    SIZES = {
      sm: "h-8 w-8",
      default: "h-10 w-10",
      lg: "h-14 w-14",
      xl: "h-20 w-20"
    }.freeze

    renders_one :image, "ImageComponent"
    renders_one :fallback, "FallbackComponent"

    attr_reader :size, :class_name, :html_options

    # @param size [Symbol] The avatar size (:sm, :default, :lg, :xl)
    # @param class_name [String] Additional CSS classes
    # @param html_options [Hash] Additional HTML attributes
    def initialize(size: :default, class_name: nil, **html_options)
      @size = size.to_sym
      @class_name = class_name
      @html_options = html_options
    end

    def call
      tag.span(class: avatar_classes, **html_options) do
        safe_join([image, fallback].compact)
      end
    end

    private

    def avatar_classes
      cn(
        "relative flex shrink-0 overflow-hidden rounded-full",
        SIZES[size],
        class_name
      )
    end

    class ImageComponent < BaseComponent
      attr_reader :src, :alt, :class_name, :html_options

      def initialize(src:, alt: "", class_name: nil, **html_options)
        @src = src
        @alt = alt
        @class_name = class_name
        @html_options = html_options
      end

      def call
        tag.img(
          src: src,
          alt: alt,
          class: cn("aspect-square h-full w-full object-cover", class_name),
          loading: "lazy",
          **html_options
        )
      end
    end

    class FallbackComponent < BaseComponent
      attr_reader :class_name, :html_options

      def initialize(class_name: nil, **html_options)
        @class_name = class_name
        @html_options = html_options
      end

      def call
        tag.span(
          content,
          class: cn("flex h-full w-full items-center justify-center rounded-full bg-muted text-muted-foreground font-medium", class_name),
          **html_options
        )
      end
    end
  end
end
