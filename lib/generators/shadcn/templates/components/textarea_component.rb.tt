# frozen_string_literal: true

module Ui
  class TextareaComponent < BaseComponent
    attr_reader :name, :value, :placeholder, :rows, :disabled, :required, :readonly,
                :class_name, :html_options

    # @param name [String] The textarea name attribute
    # @param value [String] The textarea value
    # @param placeholder [String] The placeholder text
    # @param rows [Integer] Number of visible text lines
    # @param disabled [Boolean] Whether the textarea is disabled
    # @param required [Boolean] Whether the textarea is required
    # @param readonly [Boolean] Whether the textarea is readonly
    # @param class_name [String] Additional CSS classes
    # @param html_options [Hash] Additional HTML attributes
    def initialize(
      name: nil,
      value: nil,
      placeholder: nil,
      rows: 3,
      disabled: false,
      required: false,
      readonly: false,
      class_name: nil,
      **html_options
    )
      @name = name
      @value = value
      @placeholder = placeholder
      @rows = rows
      @disabled = disabled
      @required = required
      @readonly = readonly
      @class_name = class_name
      @html_options = html_options
    end

    def call
      tag.textarea(
        value,
        name: name,
        placeholder: placeholder,
        rows: rows,
        disabled: disabled,
        required: required,
        readonly: readonly,
        class: textarea_classes,
        **html_options
      )
    end

    private

    def textarea_classes
      cn(
        base_classes,
        disabled_classes,
        class_name
      )
    end

    def base_classes
      "flex min-h-[80px] w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
    end

    def disabled_classes
      "cursor-not-allowed opacity-50" if disabled
    end
  end
end
