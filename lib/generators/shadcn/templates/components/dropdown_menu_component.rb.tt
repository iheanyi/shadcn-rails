# frozen_string_literal: true

module Ui
  class DropdownMenuComponent < BaseComponent
    renders_one :trigger, "TriggerComponent"
    renders_many :items, "ItemComponent"
    renders_many :separators, "SeparatorComponent"

    # @param align [Symbol] Alignment of the dropdown (:start, :center, :end)
    # @param class_name [String] Additional CSS classes
    # @param html_options [Hash] Additional HTML attributes
    def initialize(align: :start, class_name: nil, **html_options)
      @align = align.to_sym
      @class_name = class_name
      @html_options = html_options
    end

    def call
      tag.div(
        class: cn("relative inline-block text-left", @class_name),
        "data-controller": "dropdown",
        **@html_options
      ) do
        safe_join([trigger, menu_content].compact)
      end
    end

    private

    def menu_content
      tag.div(
        class: menu_classes,
        role: "menu",
        "data-dropdown-target": "menu"
      ) do
        tag.div(class: "py-1") do
          safe_join(items.zip(separators.to_a + [nil]).flatten.compact)
        end
      end
    end

    def menu_classes
      cn(
        # Matching shadcn/ui dropdown menu
        "absolute z-50 mt-1 hidden min-w-[8rem] overflow-hidden rounded-md border bg-popover p-1 text-popover-foreground shadow-md",
        alignment_classes
      )
    end

    def alignment_classes
      case @align
      when :start
        "left-0"
      when :center
        "left-1/2 -translate-x-1/2"
      when :end
        "right-0"
      end
    end

    class TriggerComponent < BaseComponent
      def initialize(class_name: nil, **html_options)
        @class_name = class_name
        @html_options = html_options
      end

      def call
        tag.span(
          content,
          class: @class_name,
          "data-dropdown-target": "trigger",
          "data-action": "click->dropdown#toggle",
          **@html_options
        )
      end
    end

    class ItemComponent < BaseComponent
      # @param href [String] Link URL (optional, makes item a link)
      # @param disabled [Boolean] Whether the item is disabled
      # @param class_name [String] Additional CSS classes
      # @param html_options [Hash] Additional HTML attributes
      def initialize(href: nil, disabled: false, class_name: nil, **html_options)
        @href = href
        @disabled = disabled
        @class_name = class_name
        @html_options = html_options
      end

      def call
        if @href
          tag.a(content, href: @href, class: item_classes, role: "menuitem", **@html_options)
        else
          tag.button(content, type: "button", class: item_classes, role: "menuitem", disabled: @disabled, **@html_options)
        end
      end

      private

      def item_classes
        cn(
          "relative flex w-full cursor-pointer select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none transition-colors hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground data-[disabled]:pointer-events-none data-[disabled]:opacity-50",
          @class_name
        )
      end
    end

    class SeparatorComponent < BaseComponent
      def call
        tag.div(class: "-mx-1 my-1 h-px bg-border")
      end
    end
  end
end
