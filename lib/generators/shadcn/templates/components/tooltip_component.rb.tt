# frozen_string_literal: true

module Ui
  class TooltipComponent < BaseComponent
    POSITIONS = {
      top: "bottom-full left-1/2 -translate-x-1/2 mb-2",
      bottom: "top-full left-1/2 -translate-x-1/2 mt-2",
      left: "right-full top-1/2 -translate-y-1/2 mr-2",
      right: "left-full top-1/2 -translate-y-1/2 ml-2"
    }.freeze

    renders_one :trigger
    renders_one :content_slot, "ContentComponent"

    attr_reader :position, :delay, :class_name, :html_options

    # @param position [Symbol] The tooltip position (:top, :bottom, :left, :right)
    # @param delay [Integer] Delay in milliseconds before showing tooltip
    # @param class_name [String] Additional CSS classes
    # @param html_options [Hash] Additional HTML attributes
    def initialize(position: :top, delay: 200, class_name: nil, **html_options)
      @position = position.to_sym
      @delay = delay
      @class_name = class_name
      @html_options = html_options
    end

    def call
      tag.div(
        class: cn("group relative inline-block", class_name),
        data: {
          controller: "tooltip",
          tooltip_delay_value: delay
        },
        **html_options
      ) do
        safe_join([trigger, content_slot].compact)
      end
    end

    class ContentComponent < BaseComponent
      attr_reader :position, :class_name, :html_options

      def initialize(position: :top, class_name: nil, **html_options)
        @position = position.to_sym
        @class_name = class_name
        @html_options = html_options
      end

      def call
        tag.div(
          content,
          role: "tooltip",
          class: tooltip_classes,
          data: { tooltip_target: "content" },
          **html_options
        )
      end

      private

      def tooltip_classes
        cn(
          "invisible group-hover:visible absolute z-50 overflow-hidden rounded-md border bg-popover px-3 py-1.5 text-sm text-popover-foreground shadow-md animate-in fade-in-0 zoom-in-95",
          POSITIONS[position],
          class_name
        )
      end
    end
  end
end
