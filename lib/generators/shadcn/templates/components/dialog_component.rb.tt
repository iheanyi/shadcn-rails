# frozen_string_literal: true

module Ui
  class DialogComponent < BaseComponent
    renders_one :trigger, "TriggerComponent"
    renders_one :dialog_content, "ContentComponent"

    # @param open [Boolean] Whether the dialog is open
    # @param class_name [String] Additional CSS classes
    # @param html_options [Hash] Additional HTML attributes
    def initialize(open: false, class_name: nil, **html_options)
      @open = open
      @class_name = class_name
      @html_options = html_options
    end

    def call
      tag.div(
        class: @class_name,
        "data-controller": "dialog",
        "data-dialog-open-value": @open.to_s,
        **@html_options
      ) do
        safe_join([trigger, dialog_content].compact)
      end
    end

    class TriggerComponent < BaseComponent
      def initialize(class_name: nil, **html_options)
        @class_name = class_name
        @html_options = html_options
      end

      def call
        tag.span(
          content,
          class: @class_name,
          "data-dialog-target": "trigger",
          "data-action": "click->dialog#open",
          **@html_options
        )
      end
    end

    class ContentComponent < BaseComponent
      renders_one :header, "HeaderComponent"
      renders_one :title, "TitleComponent"
      renders_one :description, "DescriptionComponent"
      renders_one :footer, "FooterComponent"

      def initialize(class_name: nil, **html_options)
        @class_name = class_name
        @html_options = html_options
      end

      def call
        # Overlay
        overlay = tag.div(
          class: "fixed inset-0 z-50 bg-black/80 hidden",
          "data-dialog-target": "overlay",
          "data-action": "click->dialog#close"
        )

        # Content
        dialog_content = tag.div(
          role: "dialog",
          "aria-modal": "true",
          class: content_classes,
          "data-dialog-target": "content",
          **@html_options
        ) do
          safe_join([header, title, description, content, footer, close_button].compact)
        end

        overlay + dialog_content
      end

      private

      def content_classes
        cn(
          # Matching shadcn/ui dialog content
          "fixed left-[50%] top-[50%] z-50 hidden w-full max-w-lg translate-x-[-50%] translate-y-[-50%] gap-4 border bg-background p-6 shadow-lg sm:rounded-lg",
          @class_name
        )
      end

      def close_button
        tag.button(
          type: "button",
          class: "absolute right-4 top-4 rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:pointer-events-none",
          "data-action": "click->dialog#close"
        ) do
          tag.svg(
            xmlns: "http://www.w3.org/2000/svg",
            viewBox: "0 0 24 24",
            fill: "none",
            stroke: "currentColor",
            "stroke-width": "2",
            "stroke-linecap": "round",
            "stroke-linejoin": "round",
            class: "h-4 w-4"
          ) do
            tag.path(d: "M18 6 6 18") + tag.path(d: "m6 6 12 12")
          end +
            tag.span("Close", class: "sr-only")
        end
      end

      class HeaderComponent < BaseComponent
        def initialize(class_name: nil, **html_options)
          @class_name = class_name
          @html_options = html_options
        end

        def call
          tag.div(content, class: cn("flex flex-col space-y-1.5 text-center sm:text-left", @class_name), **@html_options)
        end
      end

      class TitleComponent < BaseComponent
        def initialize(class_name: nil, **html_options)
          @class_name = class_name
          @html_options = html_options
        end

        def call
          tag.h2(content, class: cn("text-lg font-semibold leading-none tracking-tight", @class_name), **@html_options)
        end
      end

      class DescriptionComponent < BaseComponent
        def initialize(class_name: nil, **html_options)
          @class_name = class_name
          @html_options = html_options
        end

        def call
          tag.p(content, class: cn("text-sm text-muted-foreground", @class_name), **@html_options)
        end
      end

      class FooterComponent < BaseComponent
        def initialize(class_name: nil, **html_options)
          @class_name = class_name
          @html_options = html_options
        end

        def call
          tag.div(content, class: cn("flex flex-col-reverse sm:flex-row sm:justify-end sm:space-x-2", @class_name), **@html_options)
        end
      end
    end
  end
end
