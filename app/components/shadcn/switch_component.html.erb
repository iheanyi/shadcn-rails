<% if has_label? %>
  <label class="flex items-center gap-3 cursor-pointer">
    <span class="inline-flex items-center"
          data-controller="shadcn--switch"
          data-shadcn--switch-checked-value="<%= @checked %>">
      <% if hidden_input? %>
        <%= tag.input(**hidden_input_attributes) %>
      <% end %>
      <% if @name %>
        <%= tag.input(**checkbox_input_attributes) %>
      <% end %>
      <%= tag.button(**button_attributes) do %>
        <span class="<%= THUMB_CLASSES %>"
              data-state="<%= state %>"
              data-shadcn--switch-target="thumb"></span>
      <% end %>
    </span>
    <span class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">
      <%= content %>
    </span>
  </label>
<% else %>
  <span class="inline-flex items-center"
        data-controller="shadcn--switch"
        data-shadcn--switch-checked-value="<%= @checked %>">
    <% if hidden_input? %>
      <%= tag.input(**hidden_input_attributes) %>
    <% end %>
    <% if @name %>
      <%= tag.input(**checkbox_input_attributes) %>
    <% end %>
    <%= tag.button(**button_attributes) do %>
      <span class="<%= THUMB_CLASSES %>"
            data-state="<%= state %>"
            data-shadcn--switch-target="thumb"></span>
    <% end %>
  </span>
<% end %>
