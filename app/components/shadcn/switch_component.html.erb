<% if has_label? %>
  <label class="flex items-center gap-3 cursor-pointer">
    <%= tag.span(**wrapper_attributes) do %>
      <% if hidden_input? %>
        <%= tag.input(**hidden_input_attributes) %>
      <% end %>
      <% if @name %>
        <%= tag.input(**checkbox_input_attributes) %>
      <% end %>
      <%= tag.button(**button_attributes) do %>
        <%= tag.span(**thumb_attributes) %>
      <% end %>
    <% end %>
    <span class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">
      <%= content %>
    </span>
  </label>
<% else %>
  <%= tag.span(**wrapper_attributes) do %>
    <% if hidden_input? %>
      <%= tag.input(**hidden_input_attributes) %>
    <% end %>
    <% if @name %>
      <%= tag.input(**checkbox_input_attributes) %>
    <% end %>
    <%= tag.button(**button_attributes) do %>
      <%= tag.span(**thumb_attributes) %>
    <% end %>
  <% end %>
<% end %>
