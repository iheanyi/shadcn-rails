<input type="range"
       <%= "name=\"#{ERB::Util.html_escape_once(@name)}\"".html_safe if @name %>
       value="<%= @value %>"
       min="<%= @min %>"
       max="<%= @max %>"
       step="<%= @step %>"
       <%= "disabled" if @disabled %>
       class="<%= slider_classes %>"
       style="<%= slider_style %>"
       data-controller="shadcn--slider"
       data-action="input->shadcn--slider#updateStyle"
       <%= tag_attributes %> />
