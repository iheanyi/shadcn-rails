<div class="<%= context_menu_classes %>"
     data-slot="context-menu"
     data-controller="<%= context_menu_data_attrs[:controller] %>"
     data-action="<%= context_menu_data_attrs[:action] %>"
     <%= tag_attributes %>>
  <% if trigger? %>
    <div data-slot="context-menu-trigger" data-shadcn--context-menu-target="trigger" data-action="contextmenu->shadcn--context-menu#show:prevent">
      <%= trigger %>
    </div>
  <% end %>
  <%= menu if menu? %>
</div>
