<span data-slot="avatar" data-size="<%= @size %>" class="<%= avatar_classes %>" <%= tag_attributes %>>
  <% if has_image? %>
    <span class="contents" data-controller="shadcn--avatar">
      <img src="<%= @src %>"
           alt="<%= @alt %>"
           data-slot="avatar-image"
           class="<%= IMAGE_CLASSES %>"
           data-shadcn--avatar-target="image"
           data-action="error->shadcn--avatar#handleError" />
      <span data-slot="avatar-fallback" class="<%= FALLBACK_CLASSES %> hidden" data-shadcn--avatar-target="fallback">
        <%= fallback_text %>
      </span>
    </span>
  <% elsif has_fallback_slot? %>
    <%= fallback %>
  <% else %>
    <span data-slot="avatar-fallback" class="<%= FALLBACK_CLASSES %>">
      <%= fallback_text %>
    </span>
  <% end %>
</span>
