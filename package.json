{
  "name": "shadcn-rails-stimulus",
  "version": "0.2.1",
  "type": "module",
  "description": "Stimulus controllers for shadcn-rails ViewComponents",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./controllers": {
      "types": "./dist/controllers/index.d.ts",
      "import": "./dist/controllers/index.esm.js",
      "require": "./dist/controllers/index.js"
    },
    "./controllers/*": {
      "types": "./dist/controllers/*.d.ts",
      "import": "./dist/controllers/*.js"
    },
    "./styles": "./app/assets/stylesheets/shadcn/index.css",
    "./styles/base": "./app/assets/stylesheets/shadcn/base.css",
    "./styles/components": "./app/assets/stylesheets/shadcn/components.css",
    "./styles/tailwind-v4": "./app/assets/stylesheets/shadcn/tailwind-v4.css",
    "./styles/themes/*": "./app/assets/stylesheets/shadcn/themes/*.css"
  },
  "files": [
    "dist",
    "app/components/shadcn",
    "app/assets/javascripts/shadcn",
    "app/assets/stylesheets/shadcn"
  ],
  "scripts": {
    "build": "rm -rf dist .tsbuild && tsc -p tsconfig.build.json && rollup -c && cp .tsbuild/controllers/*_controller.js dist/controllers/ && mkdir -p dist/utils && cp .tsbuild/utils/*.js dist/utils/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "watch": "rollup -c -w",
    "test": "npm run typecheck && NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iheanyi/shadcn-rails.git"
  },
  "keywords": [
    "shadcn",
    "rails",
    "stimulus",
    "viewcomponent",
    "tailwindcss",
    "ui"
  ],
  "author": "Iheanyi Ekechukwu",
  "license": "MIT",
  "homepage": "https://github.com/iheanyi/shadcn-rails#readme",
  "bugs": {
    "url": "https://github.com/iheanyi/shadcn-rails/issues"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.0",
    "stimulus-use": "^0.52.3"
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.0.0",
    "chart.js": "^4.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.29.7",
    "@hotwired/stimulus": "^3.2.2",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "rollup": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "peerDependenciesMeta": {
    "chart.js": {
      "optional": true
    }
  }
}
