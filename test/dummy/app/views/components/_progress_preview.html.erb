<div class="flex flex-col gap-8 max-w-md">
  <div>
    <h4 class="text-sm font-medium mb-4">Default</h4>
    <%= render Ui::ProgressComponent.new(value: 60) %>
  </div>

  <div>
    <h4 class="text-sm font-medium mb-4">Various Values</h4>
    <div class="grid gap-4">
      <div class="grid gap-2">
        <div class="flex justify-between text-sm">
          <span>0%</span>
        </div>
        <%= render Ui::ProgressComponent.new(value: 0) %>
      </div>
      <div class="grid gap-2">
        <div class="flex justify-between text-sm">
          <span>25%</span>
        </div>
        <%= render Ui::ProgressComponent.new(value: 25) %>
      </div>
      <div class="grid gap-2">
        <div class="flex justify-between text-sm">
          <span>50%</span>
        </div>
        <%= render Ui::ProgressComponent.new(value: 50) %>
      </div>
      <div class="grid gap-2">
        <div class="flex justify-between text-sm">
          <span>75%</span>
        </div>
        <%= render Ui::ProgressComponent.new(value: 75) %>
      </div>
      <div class="grid gap-2">
        <div class="flex justify-between text-sm">
          <span>100%</span>
        </div>
        <%= render Ui::ProgressComponent.new(value: 100) %>
      </div>
    </div>
  </div>
</div>
