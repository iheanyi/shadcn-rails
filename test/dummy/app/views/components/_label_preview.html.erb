<div class="flex flex-col gap-4">
  <div class="grid gap-1.5">
    <%= render Ui::LabelComponent.new(for_id: "email") { "Email" } %>
    <%= render Ui::InputComponent.new(type: "email", id: "email", placeholder: "Enter email") %>
  </div>
  <div class="grid gap-1.5">
    <%= render Ui::LabelComponent.new(for_id: "name", required: true) { "Name" } %>
    <%= render Ui::InputComponent.new(id: "name", placeholder: "Enter name") %>
  </div>
</div>
