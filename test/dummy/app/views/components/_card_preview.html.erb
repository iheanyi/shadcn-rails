<div class="grid gap-8 md:grid-cols-2">
  <div>
    <%= render Ui::CardComponent.new do |card| %>
      <% card.with_header do %>
        <% card.with_title { "Card Title" } %>
        <% card.with_description { "Card description goes here." } %>
      <% end %>
      <% card.with_card_content do %>
        <p class="text-sm text-muted-foreground">
          This is the card content area where you can put any content you want.
        </p>
      <% end %>
      <% card.with_footer do %>
        <%= render Ui::ButtonComponent.new(variant: :outline) { "Cancel" } %>
        <%= render Ui::ButtonComponent.new(class_name: "ml-2") { "Save" } %>
      <% end %>
    <% end %>
  </div>

  <div>
    <%= render Ui::CardComponent.new do |card| %>
      <% card.with_header do %>
        <% card.with_title { "Create account" } %>
        <% card.with_description { "Enter your email to create your account." } %>
      <% end %>
      <% card.with_card_content do %>
        <div class="grid gap-4">
          <div class="grid gap-2">
            <%= render Ui::LabelComponent.new(for_id: "email") { "Email" } %>
            <%= render Ui::InputComponent.new(type: "email", id: "email", placeholder: "m@example.com") %>
          </div>
          <div class="grid gap-2">
            <%= render Ui::LabelComponent.new(for_id: "password") { "Password" } %>
            <%= render Ui::InputComponent.new(type: "password", id: "password") %>
          </div>
        </div>
      <% end %>
      <% card.with_footer do %>
        <%= render Ui::ButtonComponent.new(class_name: "w-full") { "Create account" } %>
      <% end %>
    <% end %>
  </div>
</div>
