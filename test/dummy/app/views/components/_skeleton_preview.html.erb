<div class="flex flex-col gap-8">
  <div>
    <h4 class="text-sm font-medium mb-4">Default</h4>
    <div class="flex items-center space-x-4">
      <%= render Ui::SkeletonComponent.new(class_name: "h-12 w-12 rounded-full") %>
      <div class="space-y-2">
        <%= render Ui::SkeletonComponent.new(class_name: "h-4 w-[250px]") %>
        <%= render Ui::SkeletonComponent.new(class_name: "h-4 w-[200px]") %>
      </div>
    </div>
  </div>

  <div>
    <h4 class="text-sm font-medium mb-4">Card Loading State</h4>
    <div class="flex flex-col space-y-3">
      <%= render Ui::SkeletonComponent.new(class_name: "h-[125px] w-[250px] rounded-xl") %>
      <div class="space-y-2">
        <%= render Ui::SkeletonComponent.new(class_name: "h-4 w-[250px]") %>
        <%= render Ui::SkeletonComponent.new(class_name: "h-4 w-[200px]") %>
      </div>
    </div>
  </div>
</div>
