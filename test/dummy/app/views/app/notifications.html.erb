<% content_for :page_title, "Notifications" %>

<div class="max-w-3xl space-y-6">
  <%= render Shadcn::Sonner.new(id: "app-notifications-sonner", duration: 5000) do %>
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold tracking-tight">Notifications</h2>
        <p class="text-muted-foreground">
          <%= @notifications_marked_read ? "You're all caught up." : "You have 3 unread notifications." %>
        </p>
      </div>
      <%= render Shadcn::Button.new(
        variant: :outline,
        size: :sm,
        data: {
          action: "click->shadcn--sonner#demo",
          title: "Notifications marked as read",
          description: "All unread notifications are now cleared.",
          variant: "success"
        }
      ) do %>
        Mark all as read
      <% end %>
    </div>
  <% end %>

  <div class="space-y-4">
    <% [
      {
        unread: true,
        initials: "OM",
        title: "Olivia Martin commented on your post",
        description: '"Great work on the new feature! The UI looks really polished."',
        time: "2 minutes ago",
        actions: ["Mark as read", "Delete notification"]
      },
      {
        unread: true,
        icon: :payment,
        title: "Payment received",
        description: "You received a payment of $1,999.00 from Jackson Lee.",
        time: "1 hour ago",
        actions: ["View details", "Mark as read", "Delete notification"]
      },
      {
        unread: true,
        icon: :team,
        title: "New team member",
        description: "Sofia Davis has joined your team.",
        time: "3 hours ago",
        actions: ["View profile", "Mark as read", "Delete notification"]
      }
    ].each do |notification| %>
      <%= render Shadcn::Card.new(class: @notifications_marked_read ? "" : "border-l-4 border-l-primary") do |card| %>
        <% card.with_content_slot(standalone: true) do %>
          <div class="flex items-start gap-4">
            <% if notification[:initials] %>
              <%= render Shadcn::Avatar.new(src: nil, alt: notification[:title], size: :sm) do |avatar| %>
                <% avatar.with_fallback { notification[:initials] } %>
              <% end %>
            <% else %>
              <div class="w-9 h-9 rounded-full <%= notification[:icon] == :payment ? 'bg-green-100' : 'bg-blue-100' %> flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 <%= notification[:icon] == :payment ? 'text-green-600' : 'text-blue-600' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <% if notification[:icon] == :payment %>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  <% else %>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                  <% end %>
                </svg>
              </div>
            <% end %>
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-2">
                <div>
                  <p class="font-medium"><%= notification[:title] %></p>
                  <p class="text-sm text-muted-foreground mt-1"><%= notification[:description] %></p>
                </div>
                <%= render Shadcn::DropdownMenu.new do |menu| %>
                  <% menu.with_trigger do %>
                    <%= render Shadcn::Button.new(variant: :ghost, size: :icon, class: "h-8 w-8") do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"/>
                      </svg>
                    <% end %>
                  <% end %>
                  <% menu.with_menu do |content| %>
                    <% notification[:actions].each do |action| %>
                      <% content.with_item { action } %>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
              <p class="text-xs text-muted-foreground mt-2"><%= notification[:time] %></p>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <%= render Shadcn::Separator.new(class: "my-6") %>

    <p class="text-sm text-muted-foreground">Earlier</p>

    <% [
      { initials: "WK", title: "William Kim mentioned you in a comment", description: '"@johndoe Can you review this PR when you get a chance?"', time: "Yesterday at 2:30 PM" },
      { icon: :warning, title: "Security alert", description: "New sign-in detected from Chrome on macOS.", time: "2 days ago" },
      { icon: :report, title: "Weekly report ready", description: "Your weekly analytics report is ready to view.", time: "3 days ago" }
    ].each do |notification| %>
      <%= render Shadcn::Card.new(class: "opacity-70") do |card| %>
        <% card.with_content_slot(standalone: true) do %>
          <div class="flex items-start gap-4">
            <% if notification[:initials] %>
              <%= render Shadcn::Avatar.new(src: nil, alt: notification[:title], size: :sm) do |avatar| %>
                <% avatar.with_fallback { notification[:initials] } %>
              <% end %>
            <% else %>
              <div class="w-9 h-9 rounded-full <%= notification[:icon] == :warning ? 'bg-yellow-100' : 'bg-purple-100' %> flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 <%= notification[:icon] == :warning ? 'text-yellow-600' : 'text-purple-600' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <% if notification[:icon] == :warning %>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                  <% else %>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                  <% end %>
                </svg>
              </div>
            <% end %>
            <div class="flex-1 min-w-0">
              <p class="font-medium"><%= notification[:title] %></p>
              <p class="text-sm text-muted-foreground mt-1"><%= notification[:description] %></p>
              <p class="text-xs text-muted-foreground mt-2"><%= notification[:time] %></p>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div class="text-center">
    <%= render Shadcn::Button.new(variant: :outline) { "Load more notifications" } %>
  </div>
</div>
