<% content_for :page_title, "Dashboard" %>

<div class="space-y-6">
  <!-- Stats Cards -->
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
    <%= render Shadcn::CardComponent.new do |card| %>
      <% card.with_header do |header| %>
        <div class="flex items-center justify-between">
          <p class="text-sm font-medium text-muted-foreground">Total Revenue</p>
          <svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
      <% end %>
      <% card.with_content_slot do %>
        <div class="text-2xl font-bold">$45,231.89</div>
        <p class="text-xs text-muted-foreground">+20.1% from last month</p>
      <% end %>
    <% end %>

    <%= render Shadcn::CardComponent.new do |card| %>
      <% card.with_header do |header| %>
        <div class="flex items-center justify-between">
          <p class="text-sm font-medium text-muted-foreground">Subscriptions</p>
          <svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </div>
      <% end %>
      <% card.with_content_slot do %>
        <div class="text-2xl font-bold">+2,350</div>
        <p class="text-xs text-muted-foreground">+180.1% from last month</p>
      <% end %>
    <% end %>

    <%= render Shadcn::CardComponent.new do |card| %>
      <% card.with_header do |header| %>
        <div class="flex items-center justify-between">
          <p class="text-sm font-medium text-muted-foreground">Sales</p>
          <svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </div>
      <% end %>
      <% card.with_content_slot do %>
        <div class="text-2xl font-bold">+12,234</div>
        <p class="text-xs text-muted-foreground">+19% from last month</p>
      <% end %>
    <% end %>

    <%= render Shadcn::CardComponent.new do |card| %>
      <% card.with_header do |header| %>
        <div class="flex items-center justify-between">
          <p class="text-sm font-medium text-muted-foreground">Active Now</p>
          <svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
          </svg>
        </div>
      <% end %>
      <% card.with_content_slot do %>
        <div class="text-2xl font-bold">+573</div>
        <p class="text-xs text-muted-foreground">+201 since last hour</p>
      <% end %>
    <% end %>
  </div>

  <!-- Main content grid -->
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-7">
    <!-- Recent Transactions -->
    <%= render Shadcn::CardComponent.new(class: "lg:col-span-4") do |card| %>
      <% card.with_header do |header| %>
        <% header.with_title { "Recent Transactions" } %>
        <% header.with_description { "You made 265 transactions this month." } %>
      <% end %>
      <% card.with_content_slot do %>
        <%= render Shadcn::TableComponent.new do |table| %>
          <% table.with_header do |header| %>
            <% header.with_row do |row| %>
              <% row.with_head { "Customer" } %>
              <% row.with_head { "Status" } %>
              <% row.with_head { "Date" } %>
              <% row.with_head(class: "text-right") { "Amount" } %>
            <% end %>
          <% end %>
          <% table.with_body do |body| %>
            <% body.with_row do |row| %>
              <% row.with_cell do %>
                <div class="flex items-center gap-3">
                  <%= render Shadcn::AvatarComponent.new(size: :sm) do |avatar| %>
                    <% avatar.with_fallback { "OM" } %>
                  <% end %>
                  <div>
                    <p class="font-medium">Olivia Martin</p>
                    <p class="text-sm text-muted-foreground">olivia@email.com</p>
                  </div>
                </div>
              <% end %>
              <% row.with_cell do %>
                <%= render Shadcn::BadgeComponent.new(variant: :outline) do %>Completed<% end %>
              <% end %>
              <% row.with_cell(class: "text-muted-foreground") { "Nov 24, 2024" } %>
              <% row.with_cell(class: "text-right font-medium") { "+$1,999.00" } %>
            <% end %>

            <% body.with_row do |row| %>
              <% row.with_cell do %>
                <div class="flex items-center gap-3">
                  <%= render Shadcn::AvatarComponent.new(size: :sm) do |avatar| %>
                    <% avatar.with_fallback { "JL" } %>
                  <% end %>
                  <div>
                    <p class="font-medium">Jackson Lee</p>
                    <p class="text-sm text-muted-foreground">jackson@email.com</p>
                  </div>
                </div>
              <% end %>
              <% row.with_cell do %>
                <%= render Shadcn::BadgeComponent.new(variant: :secondary) do %>Pending<% end %>
              <% end %>
              <% row.with_cell(class: "text-muted-foreground") { "Nov 23, 2024" } %>
              <% row.with_cell(class: "text-right font-medium") { "+$39.00" } %>
            <% end %>

            <% body.with_row do |row| %>
              <% row.with_cell do %>
                <div class="flex items-center gap-3">
                  <%= render Shadcn::AvatarComponent.new(size: :sm) do |avatar| %>
                    <% avatar.with_fallback { "IN" } %>
                  <% end %>
                  <div>
                    <p class="font-medium">Isabella Nguyen</p>
                    <p class="text-sm text-muted-foreground">isabella@email.com</p>
                  </div>
                </div>
              <% end %>
              <% row.with_cell do %>
                <%= render Shadcn::BadgeComponent.new(variant: :outline) do %>Completed<% end %>
              <% end %>
              <% row.with_cell(class: "text-muted-foreground") { "Nov 22, 2024" } %>
              <% row.with_cell(class: "text-right font-medium") { "+$299.00" } %>
            <% end %>

            <% body.with_row do |row| %>
              <% row.with_cell do %>
                <div class="flex items-center gap-3">
                  <%= render Shadcn::AvatarComponent.new(size: :sm) do |avatar| %>
                    <% avatar.with_fallback { "WK" } %>
                  <% end %>
                  <div>
                    <p class="font-medium">William Kim</p>
                    <p class="text-sm text-muted-foreground">will@email.com</p>
                  </div>
                </div>
              <% end %>
              <% row.with_cell do %>
                <%= render Shadcn::BadgeComponent.new(variant: :destructive) do %>Failed<% end %>
              <% end %>
              <% row.with_cell(class: "text-muted-foreground") { "Nov 21, 2024" } %>
              <% row.with_cell(class: "text-right font-medium") { "+$99.00" } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <!-- Recent Sales -->
    <%= render Shadcn::CardComponent.new(class: "lg:col-span-3") do |card| %>
      <% card.with_header do |header| %>
        <% header.with_title { "Recent Sales" } %>
        <% header.with_description { "You made 265 sales this month." } %>
      <% end %>
      <% card.with_content_slot do %>
        <div class="space-y-6">
          <% [
            { name: "Olivia Martin", email: "olivia.martin@email.com", amount: "+$1,999.00", initials: "OM" },
            { name: "Jackson Lee", email: "jackson.lee@email.com", amount: "+$39.00", initials: "JL" },
            { name: "Isabella Nguyen", email: "isabella.nguyen@email.com", amount: "+$299.00", initials: "IN" },
            { name: "William Kim", email: "will@email.com", amount: "+$99.00", initials: "WK" },
            { name: "Sofia Davis", email: "sofia.davis@email.com", amount: "+$39.00", initials: "SD" }
          ].each do |sale| %>
            <div class="flex items-center">
              <%= render Shadcn::AvatarComponent.new(size: :sm) do |avatar| %>
                <% avatar.with_fallback { sale[:initials] } %>
              <% end %>
              <div class="ml-4 space-y-1">
                <p class="text-sm font-medium leading-none"><%= sale[:name] %></p>
                <p class="text-sm text-muted-foreground"><%= sale[:email] %></p>
              </div>
              <div class="ml-auto font-medium"><%= sale[:amount] %></div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <!-- Quick Actions -->
  <div class="flex gap-4">
    <%= render Shadcn::DialogComponent.new do |dialog| %>
      <% dialog.with_trigger do %>
        <%= render Shadcn::ButtonComponent.new do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          New Transaction
        <% end %>
      <% end %>
      <% dialog.with_body do |body| %>
        <% body.with_header do |header| %>
          <% header.with_title { "Create Transaction" } %>
          <% header.with_description { "Add a new transaction to your records." } %>
        <% end %>
        <form data-remote="true" class="space-y-4">
          <div class="space-y-2">
            <%= render Shadcn::LabelComponent.new(for: "customer") { "Customer" } %>
            <%= render Shadcn::InputComponent.new(id: "customer", placeholder: "Customer name") %>
          </div>
          <div class="space-y-2">
            <%= render Shadcn::LabelComponent.new(for: "amount") { "Amount" } %>
            <%= render Shadcn::InputComponent.new(id: "amount", type: "number", placeholder: "0.00") %>
          </div>
          <div class="flex justify-end gap-3">
            <%= render Shadcn::ButtonComponent.new(variant: :outline, type: "button", data: { action: "click->shadcn--dialog#close" }) do %>Cancel<% end %>
            <%= render Shadcn::ButtonComponent.new(type: "submit") do %>Create<% end %>
          </div>
        </form>
      <% end %>
    <% end %>

    <%= render Shadcn::ButtonComponent.new(variant: :outline) do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
      </svg>
      Export Data
    <% end %>
  </div>
</div>
