<% content_for :page_title, "Dashboard" %>

<div class="space-y-6">
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
    <% @dashboard_stats.each do |stat| %>
      <%= render Shadcn::Card.new do |card| %>
        <% card.with_header do %>
          <div class="flex items-center justify-between">
            <p class="text-sm font-medium text-muted-foreground"><%= stat[:label] %></p>
            <svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <% case stat[:icon] %>
              <% when :revenue %>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              <% when :users %>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
              <% when :sales %>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
              <% else %>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
              <% end %>
            </svg>
          </div>
        <% end %>
        <% card.with_content_slot do %>
          <div class="text-2xl font-bold"><%= stat[:value] %></div>
          <p class="text-xs text-muted-foreground"><%= stat[:change] %></p>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div class="grid gap-4 lg:grid-cols-7">
    <%= render Shadcn::Card.new(class_name: "lg:col-span-4") do |card| %>
      <% card.with_header do |header| %>
        <% header.with_title { "Overview" } %>
        <% header.with_description { "Revenue and sales for the last six months." } %>
      <% end %>
      <% card.with_content_slot do %>
        <%= render Shadcn::Chart.new(
          type: :bar,
          data: @sales_chart_data,
          config: @sales_chart_config,
          aria_label: "Revenue and sales overview"
        ) %>
      <% end %>
    <% end %>

    <%= render Shadcn::Card.new(class_name: "lg:col-span-3") do |card| %>
      <% card.with_header do |header| %>
        <% header.with_title { "Recent Sales" } %>
        <% header.with_description { "You made 265 sales this month." } %>
      <% end %>
      <% card.with_content_slot do %>
        <div class="space-y-6">
          <% @recent_sales.each do |sale| %>
            <div class="flex items-center">
              <%= render Shadcn::Avatar.new(size: :sm) do |avatar| %>
                <% avatar.with_fallback { sale[:initials] } %>
              <% end %>
              <div class="ml-4 space-y-1">
                <p class="text-sm font-medium leading-none"><%= sale[:customer] %></p>
                <p class="text-sm text-muted-foreground"><%= sale[:email] %></p>
              </div>
              <div class="ml-auto font-medium"><%= number_to_currency(sale[:amount_cents] / 100.0, sign_before_symbol: true) %></div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <%= render Shadcn::Card.new do |card| %>
    <% card.with_header do |header| %>
      <% header.with_title { "Transactions" } %>
      <% header.with_description { "Search, filter, sort, and page real controller data." } %>
    <% end %>
    <% card.with_content_slot do %>
      <div class="space-y-4">
        <%= form_with url: app_dashboard_path, method: :get, local: true, class: "grid gap-3 md:grid-cols-[1fr_220px_auto]" do %>
          <%= render Shadcn::Input.new(
            name: "q",
            value: @dashboard_search,
            placeholder: "Search customers...",
            aria: { label: "Search transactions" }
          ) %>

          <%= render Shadcn::NativeSelect.new(name: "status", aria: { label: "Filter by status" }) do |select| %>
            <% select.with_option(value: "", selected: @dashboard_status.blank?) { "All statuses" } %>
            <% %w[Completed Pending Processing Failed].each do |status| %>
              <% select.with_option(value: status, selected: @dashboard_status == status) { status } %>
            <% end %>
          <% end %>

          <div class="flex gap-2">
            <%= render Shadcn::Button.new(type: "submit", class: "px-8") { "Apply" } %>
            <%= render Shadcn::Button.new(href: app_dashboard_path, variant: :outline) { "Reset" } %>
          </div>
        <% end %>

        <%= render Shadcn::DataTable.new(
          rows: @transactions,
          sort: @dashboard_sort,
          dir: @dashboard_dir,
          params: request.query_parameters,
          path: app_dashboard_path,
          caption: "#{pluralize(@transactions_total_count, 'transaction')} found"
        ) do |table| %>
          <% table.with_column(:customer, label: "Customer", sortable: true) do |transaction| %>
            <div class="flex items-center gap-3">
              <%= render Shadcn::Avatar.new(size: :sm) do |avatar| %>
                <% avatar.with_fallback { transaction[:initials] } %>
              <% end %>
              <div>
                <p class="font-medium"><%= transaction[:customer] %></p>
                <p class="text-sm text-muted-foreground"><%= transaction[:email] %></p>
              </div>
            </div>
          <% end %>
          <% table.with_column(:status, sortable: true) do |transaction| %>
            <% variant = transaction[:status] == "Pending" ? :secondary : (transaction[:status] == "Failed" ? :destructive : :outline) %>
            <%= render Shadcn::Badge.new(variant: variant, class: "px-4") { transaction[:status] } %>
          <% end %>
          <% table.with_column(:date, sortable: true) do |transaction| %>
            <span class="text-muted-foreground"><%= transaction[:date].strftime("%b %-d, %Y") %></span>
          <% end %>
          <% table.with_column(:amount, label: "Amount", sortable: true, align: :end) do |transaction| %>
            <span class="font-medium"><%= number_to_currency(transaction[:amount_cents] / 100.0, sign_before_symbol: true) %></span>
          <% end %>

          <% table.with_footer do %>
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <p class="text-sm text-muted-foreground">
                Page <%= @transactions_page.current_page %> of <%= @transactions_page.total_pages %>
              </p>
              <%= shadcn_paginate @transactions, url_builder: ->(page) { app_dashboard_path(**request.query_parameters.merge("page" => page).symbolize_keys) } %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <div class="flex gap-4">
    <%= render Shadcn::Dialog.new do |dialog| %>
      <% dialog.with_trigger do %>
        <%= render Shadcn::Button.new do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          New Transaction
        <% end %>
      <% end %>
      <% dialog.with_body do |body| %>
        <% body.with_header do |header| %>
          <% header.with_title { "Create Transaction" } %>
          <% header.with_description { "Add a new transaction to your records." } %>
        <% end %>
        <%= form_with scope: :transaction, url: app_dashboard_path, method: :get, builder: Shadcn::FormBuilder, local: true, class: "space-y-4" do |f| %>
          <%= f.field :customer, label: "Customer", as: :text_field, placeholder: "Customer name" %>
          <%= f.field :amount, label: "Amount", as: :number_field, placeholder: "0.00", step: "0.01" %>
          <%= render Shadcn::ButtonGroup.new(class_name: "flex justify-end") do |group| %>
            <% group.with_button(variant: :outline, type: "button", data: { action: "click->shadcn--dialog#close" }) { "Cancel" } %>
            <% group.with_button(type: "submit") { "Save" } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= render Shadcn::Button.new(variant: :outline) do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
      </svg>
      Export Data
    <% end %>
  </div>
</div>
