<% content_for :page_title, "Profile" %>

<div class="max-w-4xl space-y-6">
  <div>
    <h2 class="text-2xl font-bold tracking-tight">Profile</h2>
    <p class="text-muted-foreground">Manage your public profile information.</p>
  </div>

  <%= render Shadcn::CardComponent.new do |card| %>
    <% card.with_content_slot(standalone: true) do %>
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:items-start">
        <%= render Shadcn::AvatarComponent.new(size: :lg, class: "h-24 w-24") do |avatar| %>
          <% avatar.with_fallback(class: "text-2xl") { "JD" } %>
        <% end %>
        <div class="flex-1 text-center sm:text-left">
          <h3 class="text-xl font-semibold">John Doe</h3>
          <p class="text-muted-foreground">@johndoe</p>
          <p class="mt-2 text-sm">Senior Software Engineer at Acme Inc. Building great products with Ruby on Rails.</p>
          <div class="mt-4 flex flex-wrap justify-center gap-2 sm:justify-start">
            <%= render Shadcn::BadgeComponent.new(variant: :secondary) do %>Rails<% end %>
            <%= render Shadcn::BadgeComponent.new(variant: :secondary) do %>Ruby<% end %>
            <%= render Shadcn::BadgeComponent.new(variant: :secondary) do %>JavaScript<% end %>
            <%= render Shadcn::BadgeComponent.new(variant: :secondary) do %>PostgreSQL<% end %>
          </div>
        </div>
        <%= render Shadcn::DialogComponent.new do |dialog| %>
          <% dialog.with_trigger do %>
            <%= render Shadcn::ButtonComponent.new(variant: :outline) do %>Edit Profile<% end %>
          <% end %>
          <% dialog.with_body do |body| %>
            <% body.with_header do |header| %>
              <% header.with_title { "Edit Profile" } %>
              <% header.with_description { "Make changes to your profile here." } %>
            <% end %>
            <form data-remote="true" class="space-y-4">
              <div class="flex justify-center">
                <%= render Shadcn::AvatarComponent.new(size: :lg, class: "h-20 w-20") do |avatar| %>
                  <% avatar.with_fallback(class: "text-xl") { "JD" } %>
                <% end %>
              </div>
              <div class="space-y-2">
                <%= render Shadcn::LabelComponent.new(for: "display_name") { "Display name" } %>
                <%= render Shadcn::InputComponent.new(id: "display_name", value: "John Doe") %>
              </div>
              <div class="space-y-2">
                <%= render Shadcn::LabelComponent.new(for: "username") { "Username" } %>
                <%= render Shadcn::InputComponent.new(id: "username", value: "johndoe") %>
              </div>
              <div class="space-y-2">
                <%= render Shadcn::LabelComponent.new(for: "bio") { "Bio" } %>
                <%= render Shadcn::TextareaComponent.new(id: "bio", rows: 3) { "Senior Software Engineer at Acme Inc. Building great products with Ruby on Rails." } %>
              </div>
              <div class="flex justify-end gap-3">
                <%= render Shadcn::ButtonComponent.new(variant: :outline, type: "button", data: { action: "click->shadcn--dialog#close" }) do %>Cancel<% end %>
                <%= render Shadcn::ButtonComponent.new(type: "submit") do %>Save Changes<% end %>
              </div>
            </form>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <div class="grid gap-6 md:grid-cols-2">
    <%= render Shadcn::CardComponent.new do |card| %>
      <% card.with_header do |header| %>
        <% header.with_title { "Statistics" } %>
      <% end %>
      <% card.with_content_slot do %>
        <div class="grid grid-cols-2 gap-4">
          <div class="text-center p-4 rounded-lg bg-muted/50">
            <p class="text-3xl font-bold">142</p>
            <p class="text-sm text-muted-foreground">Projects</p>
          </div>
          <div class="text-center p-4 rounded-lg bg-muted/50">
            <p class="text-3xl font-bold">1.2k</p>
            <p class="text-sm text-muted-foreground">Followers</p>
          </div>
          <div class="text-center p-4 rounded-lg bg-muted/50">
            <p class="text-3xl font-bold">89</p>
            <p class="text-sm text-muted-foreground">Following</p>
          </div>
          <div class="text-center p-4 rounded-lg bg-muted/50">
            <p class="text-3xl font-bold">4.9</p>
            <p class="text-sm text-muted-foreground">Rating</p>
          </div>
        </div>
      <% end %>
    <% end %>

    <%= render Shadcn::CardComponent.new do |card| %>
      <% card.with_header do |header| %>
        <% header.with_title { "Social Links" } %>
      <% end %>
      <% card.with_content_slot do %>
        <div class="space-y-3">
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-muted-foreground" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            <span class="text-sm">github.com/johndoe</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-muted-foreground" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
            <span class="text-sm">@johndoe</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-muted-foreground" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            <span class="text-sm">linkedin.com/in/johndoe</span>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <%= render Shadcn::CardComponent.new do |card| %>
    <% card.with_header do |header| %>
      <% header.with_title { "Recent Activity" } %>
      <% header.with_description { "Your recent actions and updates." } %>
    <% end %>
    <% card.with_content_slot do %>
      <div class="space-y-4">
        <% [
          { action: "Created a new project", project: "shadcn-rails", time: "2 hours ago", icon: "folder" },
          { action: "Pushed 3 commits to", project: "main branch", time: "5 hours ago", icon: "git" },
          { action: "Commented on", project: "Issue #42", time: "1 day ago", icon: "comment" },
          { action: "Merged pull request in", project: "feature/dark-mode", time: "2 days ago", icon: "merge" }
        ].each do |activity| %>
          <div class="flex items-start gap-4">
            <div class="w-8 h-8 rounded-full bg-muted flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm">
                <span class="text-muted-foreground"><%= activity[:action] %></span>
                <span class="font-medium"> <%= activity[:project] %></span>
              </p>
              <p class="text-xs text-muted-foreground"><%= activity[:time] %></p>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
