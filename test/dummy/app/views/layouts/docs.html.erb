    // Slider Controller
    Stimulus.register("shadcn--slider", class extends Controller {
      static targets = ["output"]
      static values = { outputFormat: { type: String, default: "{value}" } }

      updateStyle(event) {
        const input = event.target
        const value = parseFloat(input.value)
        const min = parseFloat(input.min) || 0
        const max = parseFloat(input.max) || 100
        const percentage = ((value - min) / (max - min)) * 100
        input.style.setProperty("--slider-fill", `${percentage}%`)

        // Check for output target within controller scope
        if (this.hasOutputTarget) {
          const formattedValue = this.outputFormatValue.replace("{value}", value).replace("{percent}", Math.round(percentage))
          this.outputTarget.textContent = formattedValue
        }

        // Also check for external output target via data attribute on input
        const outputTargetId = input.dataset.outputTarget
        if (outputTargetId) {
          const outputEl = document.getElementById(outputTargetId)
          if (outputEl) {
            const format = input.dataset.outputFormat || "{value}"
            const formattedValue = format.replace("{value}", value).replace("{percent}", Math.round(percentage))
            outputEl.textContent = formattedValue
          }
        }

        this.dispatch("change", { detail: { value: value, percentage: percentage } })
      }
    })

    // Switch Controller
    Stimulus.register("shadcn--switch", class extends Controller {
      static targets = ["button", "thumb", "input"]
