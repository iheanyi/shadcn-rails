        if (item.dataset.disabled !== undefined) return
        this.valueValue = item.dataset.value
        this.updateDisplay()
        this.close()
        this.dispatch("change", { detail: { value: this.valueValue } })
      }

      updateDisplay() {
        if (this.hasValueTarget) {
          const selectedItem = this.itemTargets.find(item => item.dataset.value === this.valueValue)
          this.valueTarget.textContent = selectedItem ? selectedItem.textContent.trim() : this.placeholderValue
        }
        if (this.hasHiddenInputTarget) this.hiddenInputTarget.value = this.valueValue || ""
        this.itemTargets.forEach(item => { item.dataset.selected = item.dataset.value === this.valueValue ? "true" : "false" })
      }

