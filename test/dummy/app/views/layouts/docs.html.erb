<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= content_for?(:title) ? "#{yield(:title)} - " : "" %>shadcn-rails Documentation</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag rescue nil %>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            border: "hsl(var(--border))",
            input: "hsl(var(--input))",
            ring: "hsl(var(--ring))",
            background: "hsl(var(--background))",
            foreground: "hsl(var(--foreground))",
            primary: {
              DEFAULT: "hsl(var(--primary))",
              foreground: "hsl(var(--primary-foreground))",
            },
            secondary: {
              DEFAULT: "hsl(var(--secondary))",
              foreground: "hsl(var(--secondary-foreground))",
            },
            destructive: {
              DEFAULT: "hsl(var(--destructive))",
              foreground: "hsl(var(--destructive-foreground))",
            },
            muted: {
              DEFAULT: "hsl(var(--muted))",
              foreground: "hsl(var(--muted-foreground))",
            },
            accent: {
              DEFAULT: "hsl(var(--accent))",
              foreground: "hsl(var(--accent-foreground))",
            },
            popover: {
              DEFAULT: "hsl(var(--popover))",
              foreground: "hsl(var(--popover-foreground))",
            },
            card: {
              DEFAULT: "hsl(var(--card))",
              foreground: "hsl(var(--card-foreground))",
            },
          },
          borderRadius: {
            sm: "calc(var(--radius) - 4px)",
            md: "calc(var(--radius) - 2px)",
            lg: "var(--radius)",
            xl: "calc(var(--radius) + 4px)",
            "2xl": "calc(var(--radius) + 8px)",
            "3xl": "calc(var(--radius) + 16px)",
          },
          keyframes: {
            "accordion-down": {
              from: { height: "0" },
              to: { height: "var(--radix-accordion-content-height)" },
            },
            "accordion-up": {
              from: { height: "var(--radix-accordion-content-height)" },
              to: { height: "0" },
            },
            "fade-in": {
              from: { opacity: "0" },
              to: { opacity: "1" },
            },
            "fade-out": {
              from: { opacity: "1" },
              to: { opacity: "0" },
            },
            "zoom-in": {
              from: { opacity: "0", transform: "scale(0.95)" },
              to: { opacity: "1", transform: "scale(1)" },
            },
            "zoom-out": {
              from: { opacity: "1", transform: "scale(1)" },
              to: { opacity: "0", transform: "scale(0.95)" },
            },
            "slide-in-from-top": {
              from: { transform: "translateY(-100%)" },
              to: { transform: "translateY(0)" },
            },
            "slide-in-from-bottom": {
              from: { transform: "translateY(100%)" },
              to: { transform: "translateY(0)" },
            },
            "slide-in-from-left": {
              from: { transform: "translateX(-100%)" },
              to: { transform: "translateX(0)" },
            },
            "slide-in-from-right": {
              from: { transform: "translateX(100%)" },
              to: { transform: "translateX(0)" },
            },
          },
          animation: {
            "accordion-down": "accordion-down 0.2s ease-out",
            "accordion-up": "accordion-up 0.2s ease-out",
            "fade-in": "fade-in 0.2s ease-out",
            "fade-out": "fade-out 0.2s ease-out",
            "zoom-in": "zoom-in 0.2s ease-out",
            "zoom-out": "zoom-out 0.2s ease-out",
            "slide-in-from-top": "slide-in-from-top 0.3s ease-out",
            "slide-in-from-bottom": "slide-in-from-bottom 0.3s ease-out",
            "slide-in-from-left": "slide-in-from-left 0.3s ease-out",
            "slide-in-from-right": "slide-in-from-right 0.3s ease-out",
          },
        },
      },
    }
  </script>
  <%= javascript_include_tag "application", "data-turbo-track": "reload" %>
  <%= shadcn_theme %>
  <style>
    /* Native Radio Button Styling */
    input[type="radio"] {
      -webkit-appearance: none;
      appearance: none;
      background-color: transparent;
      margin: 0;
      position: relative;
    }

    input[type="radio"]::before {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 50%;
      transform: translate(-50%, -50%) scale(0);
      background-color: hsl(var(--primary-foreground));
      transition: transform 0.15s ease-in-out;
    }

    input[type="radio"]:checked::before {
      transform: translate(-50%, -50%) scale(1);
    }

    /* Native Checkbox Styling */
    input[type="checkbox"].shadcn-checkbox {
      -webkit-appearance: none;
      appearance: none;
      background-color: transparent;
      margin: 0;
      position: relative;
    }

    input[type="checkbox"].shadcn-checkbox:checked {
      background-color: hsl(var(--primary));
      border-color: hsl(var(--primary));
    }

    input[type="checkbox"].shadcn-checkbox::before {
      content: "";
      position: absolute;
      top: 45%;
      left: 50%;
      width: 0.25rem;
      height: 0.5rem;
      border: solid hsl(var(--primary-foreground));
      border-width: 0 2px 2px 0;
      transform: translate(-50%, -50%) rotate(45deg) scale(0);
      transition: transform 0.15s ease-in-out;
    }

    input[type="checkbox"].shadcn-checkbox:checked::before {
      transform: translate(-50%, -50%) rotate(45deg) scale(1);
    }

    /* Native Switch Styling */
    input[type="checkbox"].shadcn-switch {
      -webkit-appearance: none;
      appearance: none;
      width: 2.75rem;
      height: 1.5rem;
      border-radius: 9999px;
      background-color: hsl(var(--input));
      position: relative;
      cursor: pointer;
      transition: background-color 0.2s ease-in-out;
    }

    input[type="checkbox"].shadcn-switch::before {
      content: "";
      position: absolute;
      top: 2px;
      left: 2px;
      width: 1.25rem;
      height: 1.25rem;
      border-radius: 50%;
      background-color: hsl(var(--background));
      box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
      transition: transform 0.2s ease-in-out;
    }

    input[type="checkbox"].shadcn-switch:checked {
      background-color: hsl(var(--primary));
    }

    input[type="checkbox"].shadcn-switch:checked::before {
      transform: translateX(1.25rem);
    }

    input[type="checkbox"].shadcn-switch:focus-visible {
      outline: none;
      ring: 2px;
      ring-color: hsl(var(--ring));
      ring-offset: 2px;
    }

    input[type="checkbox"].shadcn-switch:disabled {
      cursor: not-allowed;
      opacity: 0.5;
    }

    /* Button-based Switch Component (data-state) */
    button[role="switch"] {
      background-color: hsl(var(--input));
      transition: background-color 0.2s ease-in-out;
    }

    button[role="switch"][data-state="checked"] {
      background-color: hsl(var(--primary));
    }

    button[role="switch"][data-state="unchecked"] {
      background-color: hsl(var(--input));
    }

    button[role="switch"] > span[data-state="checked"] {
      transform: translateX(1rem);
    }

    button[role="switch"] > span[data-state="unchecked"] {
      transform: translateX(0);
    }

    /* tailwindcss-animate utilities */
    @keyframes enter {
      from {
        opacity: var(--tw-enter-opacity, 1);
        transform: translate3d(var(--tw-enter-translate-x, 0), var(--tw-enter-translate-y, 0), 0) scale3d(var(--tw-enter-scale, 1), var(--tw-enter-scale, 1), var(--tw-enter-scale, 1));
      }
    }
    @keyframes exit {
      to {
        opacity: var(--tw-exit-opacity, 1);
        transform: translate3d(var(--tw-exit-translate-x, 0), var(--tw-exit-translate-y, 0), 0) scale3d(var(--tw-exit-scale, 1), var(--tw-exit-scale, 1), var(--tw-exit-scale, 1));
      }
    }

    .animate-in {
      animation-name: enter;
      animation-duration: 150ms;
      --tw-enter-opacity: initial;
      --tw-enter-scale: initial;
      --tw-enter-translate-x: initial;
      --tw-enter-translate-y: initial;
    }
    .animate-out {
      animation-name: exit;
      animation-duration: 150ms;
      --tw-exit-opacity: initial;
      --tw-exit-scale: initial;
      --tw-exit-translate-x: initial;
      --tw-exit-translate-y: initial;
    }

    /* Fade animations */
    .fade-in-0 { --tw-enter-opacity: 0; }
    .fade-out-0 { --tw-exit-opacity: 0; }

    /* Zoom animations */
    .zoom-in-95 { --tw-enter-scale: .95; }
    .zoom-out-95 { --tw-exit-scale: .95; }

    /* Slide animations */
    .slide-in-from-top { --tw-enter-translate-y: -100%; }
    .slide-in-from-bottom { --tw-enter-translate-y: 100%; }
    .slide-in-from-left { --tw-enter-translate-x: -100%; }
    .slide-in-from-right { --tw-enter-translate-x: 100%; }

    .slide-out-to-top { --tw-exit-translate-y: -100%; }
    .slide-out-to-bottom { --tw-exit-translate-y: 100%; }
    .slide-out-to-left { --tw-exit-translate-x: -100%; }
    .slide-out-to-right { --tw-exit-translate-x: 100%; }

    /* Duration utilities */
    .duration-200 { animation-duration: 200ms; }
    .duration-300 { animation-duration: 300ms; }

    /* Input OTP caret blink animation */
    @keyframes caret-blink {
      0%, 70%, 100% { opacity: 1; }
      20%, 50% { opacity: 0; }
    }
    .animate-caret-blink {
      animation: caret-blink 1.2s ease-out infinite;
    }

    /* Data state selectors for animations */
    [data-state="open"].animate-in,
    [data-state="open"] .animate-in { animation-name: enter; }
    [data-state="closed"].animate-out,
    [data-state="closed"] .animate-out { animation-name: exit; }

    /* Portal styles */
    .shadcn-dialog-portal [data-shadcn--dialog-target="overlay"] {
      position: fixed;
      inset: 0;
      z-index: 50;
      background-color: rgb(0 0 0 / 0.8);
    }

    .shadcn-dialog-portal [data-shadcn--dialog-target="content"] {
      position: fixed;
      left: 50%;
      top: 50%;
      z-index: 50;
      display: grid;
      width: 100%;
      max-width: 32rem;
      transform: translate(-50%, -50%);
      gap: 1rem;
      border: 1px solid hsl(var(--border));
      background-color: hsl(var(--background));
      padding: 1.5rem;
      box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
      border-radius: 0.5rem;
    }

    .shadcn-dialog-portal [data-state="open"],
    .shadcn-sheet-portal [data-state="open"] {
      animation: enter 200ms ease-out;
    }

    .shadcn-dialog-portal [data-state="closed"],
    .shadcn-sheet-portal [data-state="closed"] {
      animation: exit 300ms ease-in forwards;
    }

    .shadcn-dialog-portal [data-shadcn--dialog-target="overlay"][data-state="open"] {
      --tw-enter-opacity: 0;
    }

    .shadcn-dialog-portal [data-shadcn--dialog-target="overlay"][data-state="closed"] {
      --tw-exit-opacity: 0;
    }

    .shadcn-dialog-portal [data-shadcn--dialog-target="content"][data-state="open"] {
      --tw-enter-opacity: 0;
      --tw-enter-scale: 0.95;
    }

    .shadcn-dialog-portal [data-shadcn--dialog-target="content"][data-state="closed"] {
      --tw-exit-opacity: 0;
      --tw-exit-scale: 0.95;
    }

    /* Code block styling */
    .code-block {
      background-color: hsl(var(--muted));
      border-radius: 0.5rem;
      padding: 1rem;
      padding-right: 4.5rem; /* Space for absolutely positioned Copy button */
      overflow-x: auto;
      font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 0.875rem;
      line-height: 1.5;
    }

    .code-block code {
      color: hsl(var(--foreground));
    }

    /* Sidebar navigation */
    .docs-sidebar {
      position: sticky;
      top: 4rem;
      height: calc(100vh - 4rem);
      overflow-y: auto;
    }

    .docs-sidebar::-webkit-scrollbar {
      width: 4px;
    }

    .docs-sidebar::-webkit-scrollbar-track {
      background: transparent;
    }

    .docs-sidebar::-webkit-scrollbar-thumb {
      background: hsl(var(--border));
      border-radius: 2px;
    }

    /* Component preview */
    .component-preview {
      border: 1px solid hsl(var(--border));
      border-radius: 0.5rem;
      padding: 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 150px;
      background-color: hsl(var(--background));
      overflow: visible;
    }
  </style>
</head>
<body class="min-h-screen bg-background text-foreground antialiased">
  <!-- Header -->
  <header class="sticky top-0 z-40 border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
    <div class="container mx-auto px-4 h-16 flex items-center justify-between">
      <div class="flex items-center gap-6">
        <%= link_to root_path, class: "flex items-center gap-2" do %>
          <span class="text-xl font-bold">shadcn-rails</span>
        <% end %>
        <nav class="hidden md:flex items-center gap-6 text-sm">
          <%= link_to "Docs", docs_path, class: "font-medium transition-colors hover:text-foreground/80 #{controller_name == 'docs' ? 'text-foreground' : 'text-foreground/60'}" %>
          <%= link_to "Demo App", app_dashboard_path, class: "font-medium transition-colors hover:text-foreground/80 text-foreground/60" %>
          <%= link_to "Showcase", showcase_path, class: "font-medium transition-colors hover:text-foreground/80 text-foreground/60" %>
          <a href="https://github.com/iheanyi/shadcn-rails" target="_blank" class="font-medium transition-colors hover:text-foreground/80 text-foreground/60">GitHub</a>
        </nav>
      </div>
      <div class="flex items-center gap-4">
        <a href="https://rubygems.org/gems/shadcn-rails" target="_blank" class="text-sm text-muted-foreground hover:text-foreground transition-colors flex items-center gap-1.5" title="RubyGems">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8.77 11.25L12 7.94l3.23 3.31L12 14.56l-3.23-3.31zm9.93-.55l-2.3-2.36 2.3-2.36 2.3 2.36-2.3 2.36zm-2.3 2.36L12 9.16l-4.4 3.9 4.4 3.9 4.4-3.9zm-9.1-2.36l2.3 2.36-2.3 2.36-2.3-2.36 2.3-2.36zM12 2L2 9.7l3.7 4.2L12 22l6.3-8.1L22 9.7 12 2z"/>
          </svg>
          <span class="hidden lg:inline">RubyGems</span>
        </a>
        <a href="https://www.npmjs.com/package/shadcn-rails-stimulus" target="_blank" class="text-sm text-muted-foreground hover:text-foreground transition-colors flex items-center gap-1.5" title="npm">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M1.763 0C.786 0 0 .786 0 1.763v20.474C0 23.214.786 24 1.763 24h20.474c.977 0 1.763-.786 1.763-1.763V1.763C24 .786 23.214 0 22.237 0zM5.13 5.323l13.837.019-.009 13.836h-3.464l.01-10.382h-3.456L12.04 19.17H5.113z"/>
          </svg>
          <span class="hidden lg:inline">npm</span>
        </a>
      </div>
    </div>
  </header>

  <div class="container mx-auto flex-1 items-start md:grid md:grid-cols-[220px_minmax(0,1fr)] md:gap-6 lg:grid-cols-[240px_minmax(0,1fr)] lg:gap-10">
    <!-- Sidebar -->
    <aside class="docs-sidebar hidden md:block py-6 pr-2 lg:py-8">
      <nav class="flex flex-col gap-4">
        <!-- Getting Started -->
        <div class="flex flex-col gap-1">
          <h4 class="mb-1 px-2 text-sm font-semibold">Getting Started</h4>
          <%= link_to "Introduction", docs_path, class: "group flex w-full items-center rounded-md px-2 py-1.5 text-sm font-medium #{action_name == 'index' && !params[:slug] ? 'bg-accent text-accent-foreground' : 'hover:bg-accent hover:text-accent-foreground'}" %>
          <%= link_to "All Components", docs_components_path, class: "group flex w-full items-center rounded-md px-2 py-1.5 text-sm #{action_name == 'components' ? 'bg-accent text-accent-foreground font-medium' : 'text-muted-foreground hover:bg-accent hover:text-accent-foreground'}" %>
          <%= link_to "Editor Example", docs_editor_example_path, class: "group flex w-full items-center rounded-md px-2 py-1.5 text-sm #{action_name == 'editor_example' ? 'bg-accent text-accent-foreground font-medium' : 'text-muted-foreground hover:bg-accent hover:text-accent-foreground'}" %>
        </div>

        <!-- Components by Category -->
        <% DocsController::CATEGORIES.each do |category| %>
          <div class="flex flex-col gap-1">
            <h4 class="mb-1 px-2 text-sm font-semibold"><%= category %></h4>
            <% DocsController::COMPONENTS.select { |_, meta| meta[:category] == category }.each do |slug, meta| %>
              <%= link_to meta[:name], docs_component_path(slug: slug), class: "group flex w-full items-center rounded-md px-2 py-1.5 text-sm #{@slug == slug ? 'bg-accent text-accent-foreground font-medium' : 'text-muted-foreground hover:bg-accent hover:text-accent-foreground'}" %>
            <% end %>
          </div>
        <% end %>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="relative py-6 lg:py-8 lg:gap-10 xl:grid xl:grid-cols-[1fr_200px]">
      <div class="mx-auto w-full min-w-0">
        <!-- Breadcrumb -->
        <% if @component %>
          <nav class="mb-4 flex items-center text-sm text-muted-foreground">
            <%= link_to "Docs", docs_path, class: "hover:text-foreground" %>
            <svg class="mx-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <span>Components</span>
            <svg class="mx-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <span class="text-foreground"><%= @component[:name] %></span>
          </nav>
        <% end %>

        <%= yield %>
      </div>

      <!-- Table of Contents (for component pages) -->
      <% if content_for?(:toc) %>
        <div class="hidden xl:block">
          <div class="sticky top-16 -mt-10 pt-10">
            <div class="space-y-2">
              <p class="font-medium text-sm">On This Page</p>
              <%= yield(:toc) %>
            </div>
          </div>
        </div>
      <% end %>
    </main>
  </div>
</body>
</html>
