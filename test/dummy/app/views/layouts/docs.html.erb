<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= content_for?(:title) ? "#{yield(:title)} - " : "" %>shadcn-rails Documentation</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag rescue nil %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload" %>
  <%= shadcn_theme %>
  <style>
    <%= File.read(Shadcn::Rails::Registry.gem_path("app/assets/stylesheets/shadcn/components.css")).html_safe %>

    @keyframes caret-blink {
      0%, 70%, 100% { opacity: 1; }
      20%, 50% { opacity: 0; }
    }
    .animate-caret-blink {
      animation: caret-blink 1.2s ease-out infinite;
    }

    /* Code block styling */
    .code-block {
      background-color: hsl(var(--muted));
      border-radius: 0.5rem;
      padding: 1rem;
      padding-right: 4.5rem; /* Space for absolutely positioned Copy button */
      overflow-x: auto;
      font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 0.875rem;
      line-height: 1.5;
    }

    .code-block code {
      color: hsl(var(--foreground));
    }

    /* Sidebar navigation */
    .docs-sidebar {
      position: sticky;
      top: 4rem;
      height: calc(100vh - 4rem);
      overflow-y: auto;
    }

    .docs-sidebar::-webkit-scrollbar {
      width: 4px;
    }

    .docs-sidebar::-webkit-scrollbar-track {
      background: transparent;
    }

    .docs-sidebar::-webkit-scrollbar-thumb {
      background: hsl(var(--border));
      border-radius: 2px;
    }

    /* Component preview */
    .component-preview {
      border: 1px solid hsl(var(--border));
      border-radius: 0.5rem;
      padding: 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 150px;
      background-color: hsl(var(--background));
      overflow: visible;
    }
  </style>
</head>
<body class="min-h-screen bg-background text-foreground antialiased">
  <!-- Header -->
  <header class="sticky top-0 z-40 border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
    <div class="container mx-auto px-4 h-16 flex items-center justify-between">
      <div class="flex items-center gap-6">
        <%= link_to root_path, class: "flex items-center gap-2" do %>
          <span class="text-xl font-bold">shadcn-rails</span>
        <% end %>
        <nav class="hidden md:flex items-center gap-6 text-sm">
          <%= link_to "Docs", docs_path, class: "font-medium transition-colors hover:text-foreground/80 #{controller_name == 'docs' ? 'text-foreground' : 'text-foreground/60'}" %>
          <%= link_to "Demo App", app_dashboard_path, class: "font-medium transition-colors hover:text-foreground/80 text-foreground/60" %>
          <%= link_to "Showcase", showcase_path, class: "font-medium transition-colors hover:text-foreground/80 text-foreground/60" %>
          <a href="https://github.com/iheanyi/shadcn-rails" target="_blank" class="font-medium transition-colors hover:text-foreground/80 text-foreground/60">GitHub</a>
        </nav>
      </div>
      <div class="flex items-center gap-4">
        <a href="https://rubygems.org/gems/shadcn-rails" target="_blank" class="text-sm text-muted-foreground hover:text-foreground transition-colors flex items-center gap-1.5" title="RubyGems">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8.77 11.25L12 7.94l3.23 3.31L12 14.56l-3.23-3.31zm9.93-.55l-2.3-2.36 2.3-2.36 2.3 2.36-2.3 2.36zm-2.3 2.36L12 9.16l-4.4 3.9 4.4 3.9 4.4-3.9zm-9.1-2.36l2.3 2.36-2.3 2.36-2.3-2.36 2.3-2.36zM12 2L2 9.7l3.7 4.2L12 22l6.3-8.1L22 9.7 12 2z"/>
          </svg>
          <span class="hidden lg:inline">RubyGems</span>
        </a>
        <a href="https://www.npmjs.com/package/shadcn-rails-stimulus" target="_blank" class="text-sm text-muted-foreground hover:text-foreground transition-colors flex items-center gap-1.5" title="npm">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M1.763 0C.786 0 0 .786 0 1.763v20.474C0 23.214.786 24 1.763 24h20.474c.977 0 1.763-.786 1.763-1.763V1.763C24 .786 23.214 0 22.237 0zM5.13 5.323l13.837.019-.009 13.836h-3.464l.01-10.382h-3.456L12.04 19.17H5.113z"/>
          </svg>
          <span class="hidden lg:inline">npm</span>
        </a>
      </div>
    </div>
  </header>

  <div class="container mx-auto flex-1 items-start md:grid md:grid-cols-[220px_minmax(0,1fr)] md:gap-6 lg:grid-cols-[240px_minmax(0,1fr)] lg:gap-10">
    <!-- Sidebar -->
    <aside class="docs-sidebar hidden md:block py-6 pr-2 lg:py-8">
      <nav class="flex flex-col gap-4">
        <!-- Getting Started -->
        <div class="flex flex-col gap-1">
          <h4 class="mb-1 px-2 text-sm font-semibold">Getting Started</h4>
          <%= link_to "Introduction", docs_path, class: "group flex w-full items-center rounded-md px-2 py-1.5 text-sm font-medium #{action_name == 'index' && !params[:slug] ? 'bg-accent text-accent-foreground' : 'hover:bg-accent hover:text-accent-foreground'}" %>
          <%= link_to "All Components", docs_components_path, class: "group flex w-full items-center rounded-md px-2 py-1.5 text-sm #{action_name == 'components' ? 'bg-accent text-accent-foreground font-medium' : 'text-muted-foreground hover:bg-accent hover:text-accent-foreground'}" %>
          <%= link_to "Editor Example", docs_editor_example_path, class: "group flex w-full items-center rounded-md px-2 py-1.5 text-sm #{action_name == 'editor_example' ? 'bg-accent text-accent-foreground font-medium' : 'text-muted-foreground hover:bg-accent hover:text-accent-foreground'}" %>
        </div>

        <!-- Components by Category -->
        <% DocsController::CATEGORIES.each do |category| %>
          <div class="flex flex-col gap-1">
            <h4 class="mb-1 px-2 text-sm font-semibold"><%= category %></h4>
            <% DocsController::COMPONENTS.select { |_, meta| meta[:category] == category }.each do |slug, meta| %>
              <%= link_to meta[:name], docs_component_path(slug: slug), class: "group flex w-full items-center rounded-md px-2 py-1.5 text-sm #{@slug == slug ? 'bg-accent text-accent-foreground font-medium' : 'text-muted-foreground hover:bg-accent hover:text-accent-foreground'}" %>
            <% end %>
          </div>
        <% end %>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="relative py-6 lg:py-8 lg:gap-10 xl:grid xl:grid-cols-[1fr_200px]">
      <div class="mx-auto w-full min-w-0">
        <!-- Breadcrumb -->
        <% if @component %>
          <nav class="mb-4 flex items-center text-sm text-muted-foreground">
            <%= link_to "Docs", docs_path, class: "hover:text-foreground" %>
            <svg class="mx-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <span>Components</span>
            <svg class="mx-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <span class="text-foreground"><%= @component[:name] %></span>
          </nav>
        <% end %>

        <%= yield %>
      </div>

      <!-- Table of Contents (for component pages) -->
      <% if content_for?(:toc) %>
        <div class="hidden xl:block">
          <div class="sticky top-16 -mt-10 pt-10">
            <div class="space-y-2">
              <p class="font-medium text-sm">On This Page</p>
              <%= yield(:toc) %>
            </div>
          </div>
        </div>
      <% end %>
    </main>
  </div>
</body>
</html>
