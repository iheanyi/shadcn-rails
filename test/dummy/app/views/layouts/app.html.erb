<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Acme Inc - Dashboard</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag rescue nil %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "shadcn/components", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  <%= javascript_importmap_tags %>
  <%= shadcn_theme %>
  <style>
    .nav-item-active {
      background-color: hsl(var(--accent));
      color: hsl(var(--accent-foreground));
    }
  </style>
</head>
<body class="min-h-screen bg-background text-foreground antialiased">
  <div class="flex min-h-screen">
    <aside class="w-64 border-r bg-muted/30 flex flex-col">
      <div class="h-16 flex items-center px-6 border-b">
        <a href="/app" class="flex items-center gap-2 font-semibold">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
            <path d="M2 17l10 5 10-5"/>
            <path d="M2 12l10 5 10-5"/>
          </svg>
          <span>Acme Inc</span>
        </a>
      </div>

      <nav class="flex-1 p-4 space-y-1">
        <%= link_to app_dashboard_path, class: "flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium #{request.path == '/app/dashboard' || request.path == '/app' ? 'nav-item-active' : 'hover:bg-accent'}" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          Dashboard
        <% end %>

        <%= link_to app_notifications_path, class: "flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium #{request.path == '/app/notifications' ? 'nav-item-active' : 'hover:bg-accent'}" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
          </svg>
          Notifications
          <span class="ml-auto bg-primary text-primary-foreground text-xs px-2 py-0.5 rounded-full">3</span>
        <% end %>

        <div class="pt-4">
          <p class="px-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">Account</p>
        </div>

        <%= link_to app_profile_path, class: "flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium #{request.path == '/app/profile' ? 'nav-item-active' : 'hover:bg-accent'}" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          Profile
        <% end %>

        <%= link_to app_settings_path, class: "flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium #{request.path == '/app/settings' ? 'nav-item-active' : 'hover:bg-accent'}" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          Settings
        <% end %>
      </nav>

      <div class="p-4 border-t">
        <div class="flex items-center gap-3">
          <%= render Shadcn::Avatar.new(size: :sm) do |avatar| %>
            <% avatar.with_fallback { "JD" } %>
          <% end %>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate">John Doe</p>
            <p class="text-xs text-muted-foreground truncate">john@acme.com</p>
          </div>
        </div>
      </div>
    </aside>

    <div class="flex-1 flex flex-col">
      <header class="h-16 border-b flex items-center justify-between px-6">
        <div>
          <h1 class="text-lg font-semibold"><%= yield :page_title %></h1>
        </div>
        <div class="flex items-center gap-4">
          <%= link_to docs_path, class: "text-sm text-muted-foreground hover:text-foreground" do %>
            Back to Docs
          <% end %>
        </div>
      </header>

      <main class="flex-1 p-6 overflow-auto">
        <%= yield %>
      </main>
    </div>
  </div>
</body>
</html>
