<% content_for :title, "Date Picker" %>

<% content_for :toc do %>
  <div class="flex flex-col space-y-2 text-sm">
    <a href="#installation" class="text-muted-foreground hover:text-foreground">Installation</a>
    <a href="#usage" class="text-muted-foreground hover:text-foreground">Usage</a>
    <a href="#examples" class="text-muted-foreground hover:text-foreground">Examples</a>
    <a href="#api-reference" class="text-muted-foreground hover:text-foreground">API Reference</a>
  </div>
<% end %>

<div class="space-y-8">
  <!-- Header -->
  <div class="space-y-2">
    <h1 class="scroll-m-20 text-4xl font-bold tracking-tight">Date Picker</h1>
    <p class="text-xl text-muted-foreground">A date picker input with a button trigger that opens a calendar popover.</p>
    <div class="flex items-center gap-2 mt-4">
      <span class="inline-flex items-center rounded-md bg-blue-50 dark:bg-blue-950 px-2 py-1 text-xs font-medium text-blue-700 dark:text-blue-300 ring-1 ring-inset ring-blue-700/10 dark:ring-blue-300/10">
        Requires JavaScript
      </span>
    </div>
  </div>

  <!-- Preview -->
  <%= showcase("date-picker", :default) %>

  <!-- Installation -->
  <div id="installation" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Installation</h2>
    <p class="leading-7">Add the component to your project:</p>
    <%= render "docs/code_example", language: "bash", code: "rails generate shadcn:add date_picker" %>
  </div>

  <!-- Usage -->
  <div id="usage" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Usage</h2>
    <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/date-picker/usage.txt")) %>
  </div>

  <!-- Examples -->
  <div id="examples" class="space-y-8">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Examples</h2>

    <!-- Pre-selected Date -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Pre-selected Date</h3>
      <p class="text-sm text-muted-foreground">Use the <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">selected</code> prop to set an initial date.</p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::DatePickerComponent.new(selected: Date.today) %>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/date-picker/pre-selected-date.txt")) %>
    </div>

    <!-- Form Integration -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Form Integration</h3>
      <p class="text-sm text-muted-foreground">Use the <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">name</code> prop inside a Rails form to enable form submission.</p>
      <%= render "docs/demo_card" do %>
        <div class="space-y-4">
          <%= render Shadcn::LabelComponent.new { "Event Date" } %>
          <%= render Shadcn::DatePickerComponent.new(
            name: "event[date]",
            selected: Date.today,
            placeholder: "Select event date"
          ) %>
        </div>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/date-picker/form-integration.txt")) %>
    </div>

    <!-- Date Formats -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Date Formats</h3>
      <p class="text-sm text-muted-foreground">Use the <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">format</code> prop to change how dates are displayed.</p>
      <%= render "docs/demo_card" do %>
        <div class="flex flex-wrap gap-4">
          <div class="space-y-2">
            <p class="text-xs text-muted-foreground">Short</p>
            <%= render Shadcn::DatePickerComponent.new(selected: Date.today, format: :short) %>
          </div>
          <div class="space-y-2">
            <p class="text-xs text-muted-foreground">Medium (default)</p>
            <%= render Shadcn::DatePickerComponent.new(selected: Date.today, format: :medium) %>
          </div>
          <div class="space-y-2">
            <p class="text-xs text-muted-foreground">Long</p>
            <%= render Shadcn::DatePickerComponent.new(selected: Date.today, format: :long) %>
          </div>
        </div>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/date-picker/date-formats.txt")) %>
    </div>

    <!-- Date Constraints -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Date Constraints</h3>
      <p class="text-sm text-muted-foreground">Use <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">min_date</code> and <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">max_date</code> to limit selectable dates.</p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::DatePickerComponent.new(
          min_date: Date.today,
          max_date: Date.today + 30.days,
          placeholder: "Select date (next 30 days)"
        ) %>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/date-picker/date-constraints.txt")) %>
    </div>

    <!-- Disabled Dates -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Disabled Dates</h3>
      <p class="text-sm text-muted-foreground">Pass specific dates that should not be selectable.</p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::DatePickerComponent.new(
          selected: Date.today + 1.day,
          disabled_dates: [
            Date.today,
            Date.today + 2.days,
            Date.today + 5.days
          ],
          placeholder: "Select an available date"
        ) %>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/date-picker/disabled-dates.txt")) %>
    </div>

    <!-- Disabled State -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Disabled</h3>
      <p class="text-sm text-muted-foreground">The date picker can be disabled.</p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::DatePickerComponent.new(disabled: true) %>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/date-picker/disabled.txt")) %>
    </div>
  </div>

  <!-- API Reference -->
  <div id="api-reference">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight mb-4">API Reference</h2>

    <h3 class="text-lg font-semibold mt-6 mb-3">DatePickerComponent</h3>
    <%= render "docs/props_table", props: [
      { name: "selected", type: "Date", default: "nil", description: "Currently selected date" },
      { name: "month", type: "Date", default: "Date.today", description: "Month to display (defaults to selected date's month)" },
      { name: "min_date", type: "Date", default: "nil", description: "Minimum selectable date" },
      { name: "max_date", type: "Date", default: "nil", description: "Maximum selectable date" },
      { name: "name", type: "String", default: "nil", description: "Form field name for hidden input" },
      { name: "disabled_dates", type: "Array<Date>", default: "[]", description: "Specific dates that cannot be selected" },
      { name: "show_outside_days", type: "Boolean", default: "true", description: "Whether to show days outside current month" },
      { name: "placeholder", type: "String", default: '"Pick a date"', description: "Placeholder text when no date selected" },
      { name: "format", type: "Symbol", default: ":medium", description: "Date format (:short, :medium, :long, :iso)" },
      { name: "disabled", type: "Boolean", default: "false", description: "Whether the date picker is disabled" },
      { name: "class_name", type: "String", default: "nil", description: "Additional CSS classes" }
    ] %>

    <div class="mt-6 space-y-4">
      <h3 class="text-lg font-semibold">Date Formats</h3>
      <div class="rounded-lg border">
        <table class="w-full">
          <thead>
            <tr class="border-b bg-muted/50">
              <th class="text-left p-3 text-sm font-medium">Format</th>
              <th class="text-left p-3 text-sm font-medium">Example Output</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b">
              <td class="p-3 text-sm"><code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">:short</code></td>
              <td class="p-3 text-sm">11/26/2024</td>
            </tr>
            <tr class="border-b">
              <td class="p-3 text-sm"><code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">:medium</code></td>
              <td class="p-3 text-sm">November 26, 2024</td>
            </tr>
            <tr class="border-b">
              <td class="p-3 text-sm"><code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">:long</code></td>
              <td class="p-3 text-sm">Tuesday, November 26, 2024</td>
            </tr>
            <tr>
              <td class="p-3 text-sm"><code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">:iso</code></td>
              <td class="p-3 text-sm">2024-11-26</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Events -->
  <div class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Events</h2>
    <p class="leading-7">The Date Picker dispatches a <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">shadcn--date-picker:select</code> event when a date is selected.</p>
    <%= render "docs/code_example", language: "javascript", code: <<~CODE
element.addEventListener("shadcn--date-picker:select", (event) => {
  console.log(event.detail.date)        // JavaScript Date object
  console.log(event.detail.dateString)  // ISO date string (YYYY-MM-DD)
})
CODE
    %>
  </div>

  <!-- Accessibility -->
  <div class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Accessibility</h2>
    <ul class="ml-6 list-disc space-y-2 [&>li]:mt-2">
      <li>Trigger button has <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">aria-haspopup="dialog"</code></li>
      <li><code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">aria-expanded</code> reflects popover state</li>
      <li>Calendar uses <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">role="grid"</code></li>
      <li><code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">aria-selected</code> indicates selected date</li>
      <li>Pressing Escape closes the popover</li>
      <li>Clicking outside closes the popover</li>
    </ul>
  </div>
</div>
