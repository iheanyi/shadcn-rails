<% content_for :title, "Tooltip" %>

<% content_for :toc do %>
  <div class="flex flex-col space-y-2 text-sm">
    <a href="#installation" class="text-muted-foreground hover:text-foreground">Installation</a>
    <a href="#usage" class="text-muted-foreground hover:text-foreground">Usage</a>
    <a href="#examples" class="text-muted-foreground hover:text-foreground">Examples</a>
    <a href="#api-reference" class="text-muted-foreground hover:text-foreground">API Reference</a>
  </div>
<% end %>

<div class="space-y-8">
  <!-- Header -->
  <div class="space-y-2">
    <h1 class="scroll-m-20 text-4xl font-bold tracking-tight">Tooltip</h1>
    <p class="text-xl text-muted-foreground">A popup that displays information related to an element when the element receives keyboard focus or the mouse hovers over it.</p>
    <div class="flex items-center gap-2 mt-4">
      <span class="inline-flex items-center rounded-md bg-blue-50 dark:bg-blue-950 px-2 py-1 text-xs font-medium text-blue-700 dark:text-blue-300 ring-1 ring-inset ring-blue-700/10 dark:ring-blue-300/10">
        Stimulus: shadcn--tooltip
      </span>
    </div>
  </div>

  <!-- Preview -->
  <%= showcase("tooltip", :default) %>

  <!-- Installation -->
  <div id="installation" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Installation</h2>
    <p class="leading-7">Add the component to your project:</p>
    <%= render "docs/code_example", language: "bash", code: "rails generate shadcn:add tooltip" %>
  </div>

  <!-- Usage -->
  <div id="usage" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Usage</h2>
    <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/tooltip/usage.txt")) %>
  </div>

  <!-- Examples -->
  <div id="examples" class="space-y-8">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Examples</h2>

    <!-- Default -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Default</h3>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::TooltipComponent.new(text: "Hover me!") do %>
          <%= render Shadcn::ButtonComponent.new(variant: :outline) { "Hover" } %>
        <% end %>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/tooltip/default.txt")) %>
    </div>

    <!-- Positions -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Positions</h3>
      <p class="text-sm text-muted-foreground">Use the <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">side</code> prop to position the tooltip.</p>
      <%= render "docs/demo_card" do %>
        <div class="flex items-center gap-4">
          <%= render Shadcn::TooltipComponent.new(text: "Top tooltip", side: :top) do %>
            <%= render Shadcn::ButtonComponent.new(variant: :outline) { "Top" } %>
          <% end %>
          <%= render Shadcn::TooltipComponent.new(text: "Right tooltip", side: :right) do %>
            <%= render Shadcn::ButtonComponent.new(variant: :outline) { "Right" } %>
          <% end %>
          <%= render Shadcn::TooltipComponent.new(text: "Bottom tooltip", side: :bottom) do %>
            <%= render Shadcn::ButtonComponent.new(variant: :outline) { "Bottom" } %>
          <% end %>
          <%= render Shadcn::TooltipComponent.new(text: "Left tooltip", side: :left) do %>
            <%= render Shadcn::ButtonComponent.new(variant: :outline) { "Left" } %>
          <% end %>
        </div>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/tooltip/positions.txt")) %>
    </div>

    <!-- On Icons -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">On Icon Buttons</h3>
      <p class="text-sm text-muted-foreground">Tooltips are essential for icon-only buttons to provide accessible labels.</p>
      <%= render "docs/demo_card" do %>
        <div class="flex items-center gap-2">
          <%= render Shadcn::TooltipComponent.new(text: "Bold") do %>
            <%= render Shadcn::ButtonComponent.new(variant: :outline, size: :icon) do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/></svg>
            <% end %>
          <% end %>
          <%= render Shadcn::TooltipComponent.new(text: "Italic") do %>
            <%= render Shadcn::ButtonComponent.new(variant: :outline, size: :icon) do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" x2="10" y1="4" y2="4"/><line x1="14" x2="5" y1="20" y2="20"/><line x1="15" x2="9" y1="4" y2="20"/></svg>
            <% end %>
          <% end %>
          <%= render Shadcn::TooltipComponent.new(text: "Underline") do %>
            <%= render Shadcn::ButtonComponent.new(variant: :outline, size: :icon) do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4v6a6 6 0 0 0 12 0V4"/><line x1="4" x2="20" y1="20" y2="20"/></svg>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/tooltip/on-icon-buttons.txt")) %>
    </div>

    <!-- With Text Links -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">With Text</h3>
      <%= render "docs/demo_card" do %>
        <p class="text-sm">
          Hover over the
          <%= render Shadcn::TooltipComponent.new(text: "This is additional information") do %>
            <span class="underline decoration-dotted cursor-help">highlighted text</span>
          <% end %>
          to see more information.
        </p>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/tooltip/with-text.txt")) %>
    </div>

    <!-- Custom Delay -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Custom Delay</h3>
      <p class="text-sm text-muted-foreground">Adjust the <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">delay_duration</code> for different show timings.</p>
      <%= render "docs/demo_card" do %>
        <div class="flex items-center gap-4">
          <%= render Shadcn::TooltipComponent.new(text: "Instant (0ms)", delay_duration: 0) do %>
            <%= render Shadcn::ButtonComponent.new(variant: :outline) { "Instant" } %>
          <% end %>
          <%= render Shadcn::TooltipComponent.new(text: "Default (200ms)", delay_duration: 200) do %>
            <%= render Shadcn::ButtonComponent.new(variant: :outline) { "Default" } %>
          <% end %>
          <%= render Shadcn::TooltipComponent.new(text: "Slow (500ms)", delay_duration: 500) do %>
            <%= render Shadcn::ButtonComponent.new(variant: :outline) { "Slow" } %>
          <% end %>
        </div>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/tooltip/custom-delay.txt")) %>
    </div>
  </div>

    <!-- All Sides -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">All Sides</h3>
      <%= showcase("tooltip", :sides) %>
    </div>

    <!-- With Icon Button -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">With Icon Button</h3>
      <%= showcase("tooltip", :with_icon_button) %>
    </div>

    <!-- Top -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Top</h3>
      <%= showcase("tooltip", :top) %>
    </div>

    <!-- Right -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Right</h3>
      <%= showcase("tooltip", :right) %>
    </div>

    <!-- Bottom -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Bottom</h3>
      <%= showcase("tooltip", :bottom) %>
    </div>

    <!-- Left -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Left</h3>
      <%= showcase("tooltip", :left) %>
    </div>

    <!-- With Delay -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">With Delay</h3>
      <%= showcase("tooltip", :with_delay) %>
    </div>

    <!-- Multiple Tooltips -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Multiple Tooltips</h3>
      <%= showcase("tooltip", :multiple) %>
    </div>

  <!-- API Reference -->
  <div id="api-reference">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight mb-4">API Reference</h2>
    <%= render "docs/props_table", props: [
      { name: "text", type: "String", default: "nil", description: "Tooltip content text" },
      { name: "side", type: "Symbol", default: ":top", description: "Side to show tooltip (:top, :right, :bottom, :left)" },
      { name: "align", type: "Symbol", default: ":center", description: "Alignment relative to trigger (:start, :center, :end)" },
      { name: "delay_duration", type: "Integer", default: "200", description: "Delay before showing (milliseconds)" },
      { name: "skip_delay_duration", type: "Integer", default: "300", description: "Delay when moving between triggers (milliseconds)" },
      { name: "class_name", type: "String", default: "nil", description: "Additional CSS classes to apply" }
    ] %>
  </div>

  <!-- Stimulus Controller -->
  <%= render "docs/stimulus_docs",
    controller: "shadcn--tooltip",
    description: "Handles tooltip show/hide with positioning and delays.",
    values: [
      { name: "side", type: "String", description: "Side to position tooltip" },
      { name: "align", type: "String", description: "Alignment relative to trigger" },
      { name: "delay", type: "Number", description: "Show delay in milliseconds" },
      { name: "skipDelay", type: "Number", description: "Delay when moving between triggers" }
    ],
    targets: [
      { name: "trigger", description: "Element that triggers the tooltip" },
      { name: "content", description: "Tooltip content element" }
    ],
    actions: [
      { name: "show", description: "Shows the tooltip" },
      { name: "hide", description: "Hides the tooltip" }
    ]
  %>

  <!-- Accessibility -->
  <div class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Accessibility</h2>
    <ul class="ml-6 list-disc space-y-2 [&>li]:mt-2">
      <li>Tooltip content has <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">role="tooltip"</code></li>
      <li>Shows on hover and focus for keyboard users</li>
      <li>For icon-only buttons, tooltips provide the accessible name</li>
      <li>Do not put interactive content inside tooltips</li>
      <li>Keep tooltip text concise and informative</li>
    </ul>
  </div>
</div>
