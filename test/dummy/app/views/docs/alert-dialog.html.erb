<% content_for :title, "Alert Dialog" %>

<% content_for :toc do %>
  <div class="flex flex-col space-y-2 text-sm">
    <a href="#installation" class="text-muted-foreground hover:text-foreground">Installation</a>
    <a href="#usage" class="text-muted-foreground hover:text-foreground">Usage</a>
    <a href="#examples" class="text-muted-foreground hover:text-foreground">Examples</a>
    <a href="#api-reference" class="text-muted-foreground hover:text-foreground">API Reference</a>
    <a href="#stimulus-controller" class="text-muted-foreground hover:text-foreground">Stimulus Controller</a>
    <a href="#accessibility" class="text-muted-foreground hover:text-foreground">Accessibility</a>
  </div>
<% end %>

<div class="space-y-8">
  <!-- Header -->
  <div class="space-y-2">
    <h1 class="scroll-m-20 text-4xl font-bold tracking-tight">Alert Dialog</h1>
    <p class="text-xl text-muted-foreground">A modal dialog that interrupts the user with important content and requires a response.</p>
    <div class="flex items-center gap-2 mt-4">
      <span class="inline-flex items-center rounded-md bg-blue-50 dark:bg-blue-950 px-2 py-1 text-xs font-medium text-blue-700 dark:text-blue-300 ring-1 ring-inset ring-blue-700/10 dark:ring-blue-300/10">
        Requires JavaScript
      </span>
    </div>
  </div>

  <!-- Preview -->
  <%= showcase("alert-dialog", :default) %>

  <!-- Installation -->
  <div id="installation" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Installation</h2>
    <p class="leading-7">Add the component to your project:</p>
    <%= render "docs/code_example", language: "bash", code: "rails generate shadcn:add alert_dialog" %>
  </div>

  <!-- Usage -->
  <div id="usage" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Usage</h2>
    <p class="text-sm text-muted-foreground">This example now renders from the component preview source shown by the showcase block on this page.</p>
  </div>

  <!-- Examples -->
  <div id="examples" class="space-y-8">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Examples</h2>

    <!-- Basic Confirmation -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Basic Confirmation</h3>
      <p class="text-sm text-muted-foreground">A simple alert dialog for confirming an action.</p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::AlertDialogComponent.new do |dialog| %>
          <% dialog.with_trigger do %>
            <%= render Shadcn::ButtonComponent.new(variant: :outline) do %>Open<% end %>
          <% end %>
          <% dialog.with_body do |body| %>
            <% body.with_header do |header| %>
              <% header.with_title { "Confirm Action" } %>
              <% header.with_description { "Are you sure you want to proceed?" } %>
            <% end %>
            <% body.with_footer do |footer| %>
              <% footer.with_cancel { "Cancel" } %>
              <% footer.with_action { "Confirm" } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <p class="text-sm text-muted-foreground">This example now renders from the component preview source shown by the showcase block on this page.</p>
    </div>

    <!-- Destructive Action -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Destructive Action</h3>
      <p class="text-sm text-muted-foreground">
        Use for critical actions like deletions. Style the action button with destructive colors by passing
        <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">class_name</code> to customize its appearance.
      </p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::AlertDialogComponent.new do |dialog| %>
          <% dialog.with_trigger do %>
            <%= render Shadcn::ButtonComponent.new(variant: :destructive) do %>Delete Account<% end %>
          <% end %>
          <% dialog.with_body do |body| %>
            <% body.with_header do |header| %>
              <% header.with_title { "Are you absolutely sure?" } %>
              <% header.with_description { "This action cannot be undone. This will permanently delete your account and remove all your data from our servers." } %>
            <% end %>
            <% body.with_footer do |footer| %>
              <% footer.with_cancel { "Cancel" } %>
              <% footer.with_action(class_name: "bg-destructive text-destructive-foreground hover:bg-destructive/90") { "Yes, delete account" } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <p class="text-sm text-muted-foreground">This example now renders from the component preview source shown by the showcase block on this page.</p>
    </div>

    <!-- Custom Content -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Custom Content</h3>
      <p class="text-sm text-muted-foreground">
        Add custom content between the header and footer by including additional markup inside the
        <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">with_body</code> block.
      </p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::AlertDialogComponent.new do |dialog| %>
          <% dialog.with_trigger do %>
            <%= render Shadcn::ButtonComponent.new(variant: :outline) do %>Publish Post<% end %>
          <% end %>
          <% dialog.with_body do |body| %>
            <% body.with_header do |header| %>
              <% header.with_title { "Ready to publish?" } %>
              <% header.with_description { "Your post will be visible to all subscribers." } %>
            <% end %>
            <div class="py-4">
              <p class="text-sm text-muted-foreground">This action will notify all your followers.</p>
            </div>
            <% body.with_footer do |footer| %>
              <% footer.with_cancel { "Save as Draft" } %>
              <% footer.with_action { "Publish Now" } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <p class="text-sm text-muted-foreground">This example now renders from the component preview source shown by the showcase block on this page.</p>
    </div>
  </div>

  <!-- API Reference -->
  <div id="api-reference">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight mb-4">API Reference</h2>

    <h3 class="text-lg font-semibold mt-6 mb-3">AlertDialogComponent</h3>
    <%= render "docs/props_table", title: nil, props: [
      { name: "open", type: "Boolean", default: "false", description: "Whether the dialog starts in open state" }
    ] %>

    <h3 class="text-lg font-semibold mt-6 mb-3">Slots</h3>
    <div class="relative w-full overflow-auto">
      <table class="w-full caption-bottom text-sm">
        <thead class="[&_tr]:border-b">
          <tr class="border-b transition-colors">
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Slot</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Description</th>
          </tr>
        </thead>
        <tbody class="[&_tr:last-child]:border-0">
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_trigger</td>
            <td class="p-4 align-middle text-muted-foreground">The element that opens the dialog (usually a button)</td>
          </tr>
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_body</td>
            <td class="p-4 align-middle text-muted-foreground">The dialog content container (yields AlertDialogContentComponent)</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="text-lg font-semibold mt-6 mb-3">AlertDialogContentComponent Slots</h3>
    <div class="relative w-full overflow-auto">
      <table class="w-full caption-bottom text-sm">
        <thead class="[&_tr]:border-b">
          <tr class="border-b transition-colors">
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Slot</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Description</th>
          </tr>
        </thead>
        <tbody class="[&_tr:last-child]:border-0">
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_header</td>
            <td class="p-4 align-middle text-muted-foreground">Header section (yields with_title and with_description slots)</td>
          </tr>
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_footer</td>
            <td class="p-4 align-middle text-muted-foreground">Footer section (yields with_cancel and with_action slots)</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="text-lg font-semibold mt-6 mb-3">AlertDialogHeaderComponent Slots</h3>
    <div class="relative w-full overflow-auto">
      <table class="w-full caption-bottom text-sm">
        <thead class="[&_tr]:border-b">
          <tr class="border-b transition-colors">
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Slot</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Description</th>
          </tr>
        </thead>
        <tbody class="[&_tr:last-child]:border-0">
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_title</td>
            <td class="p-4 align-middle text-muted-foreground">Alert dialog title text (rendered as h2)</td>
          </tr>
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_description</td>
            <td class="p-4 align-middle text-muted-foreground">Alert dialog description text</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="text-lg font-semibold mt-6 mb-3">AlertDialogFooterComponent Slots</h3>
    <div class="relative w-full overflow-auto">
      <table class="w-full caption-bottom text-sm">
        <thead class="[&_tr]:border-b">
          <tr class="border-b transition-colors">
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Slot</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Props</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Description</th>
          </tr>
        </thead>
        <tbody class="[&_tr:last-child]:border-0">
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_cancel</td>
            <td class="p-4 align-middle"><code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">class_name:</code></td>
            <td class="p-4 align-middle text-muted-foreground">Cancel button (styled as outline variant)</td>
          </tr>
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_action</td>
            <td class="p-4 align-middle"><code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">class_name:</code></td>
            <td class="p-4 align-middle text-muted-foreground">Primary action button (styled as primary variant)</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Stimulus Controller -->
  <div id="stimulus-controller">
    <%= render "docs/stimulus_docs",
      controller_name: "shadcn--dialog",
      description: "Alert Dialog reuses the Dialog controller to manage open/close state, focus trapping, keyboard navigation, and accessibility.",
      targets: [
        { name: "trigger", description: "The element that triggers the alert dialog to open" },
        { name: "template", description: "Template containing the alert dialog content (for portal rendering)" },
        { name: "overlay", description: "The backdrop overlay element" },
        { name: "content", description: "The alert dialog content container" }
      ],
      values: [
        { name: "open", type: "Boolean", default: "false", description: "Current open/closed state" },
        { name: "modal", type: "Boolean", default: "true", description: "Always true for alert dialogs (requires user action)" }
      ],
      actions: [
        { name: "open", description: "Opens the alert dialog" },
        { name: "close", description: "Closes the alert dialog" }
      ]
    %>
  </div>

  <!-- Accessibility -->
  <div id="accessibility" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Accessibility</h2>
    <ul class="ml-6 list-disc space-y-2 [&>li]:mt-2">
      <li>Uses <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">role="alertdialog"</code> for proper screen reader announcement</li>
      <li>Sets <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">aria-modal="true"</code> to indicate modal behavior</li>
      <li>
        <strong>Important:</strong> Alert dialogs are always modal and require user action.
        Unlike regular dialogs, they cannot be dismissed by clicking the overlay or pressing
        <kbd class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm">Escape</kbd>.
      </li>
      <li>Traps focus within the dialog when open</li>
      <li>Returns focus to trigger element when closed via action buttons</li>
      <li>Title and description are properly linked via ARIA attributes for screen reader context</li>
      <li>Cancel and action buttons are clearly distinguished for keyboard navigation</li>
    </ul>

    <div class="rounded-lg border bg-card p-4 mt-4">
      <h4 class="font-semibold mb-2">Alert Dialog vs Dialog</h4>
      <p class="text-sm text-muted-foreground">
        Use Alert Dialog when the user must make a decision or acknowledge important information before continuing.
        Use regular Dialog for less critical interactions where the user can dismiss by clicking outside or pressing Escape.
      </p>
    </div>
  </div>
</div>
