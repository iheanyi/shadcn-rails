<% content_for :title, "Command" %>

<% content_for :toc do %>
  <div class="flex flex-col space-y-2 text-sm">
    <a href="#installation" class="text-muted-foreground hover:text-foreground">Installation</a>
    <a href="#usage" class="text-muted-foreground hover:text-foreground">Usage</a>
    <a href="#examples" class="text-muted-foreground hover:text-foreground">Examples</a>
    <a href="#api-reference" class="text-muted-foreground hover:text-foreground">API Reference</a>
  </div>
<% end %>

<div class="space-y-8">
  <!-- Header -->
  <div class="space-y-2">
    <h1 class="scroll-m-20 text-4xl font-bold tracking-tight">Command</h1>
    <p class="text-xl text-muted-foreground">A command menu with search input, keyboard navigation, and item selection.</p>
    <div class="flex items-center gap-2 mt-4">
      <span class="inline-flex items-center rounded-md bg-blue-50 dark:bg-blue-950 px-2 py-1 text-xs font-medium text-blue-700 dark:text-blue-300 ring-1 ring-inset ring-blue-700/10 dark:ring-blue-300/10">
        Requires JavaScript
      </span>
    </div>
  </div>

  <!-- Preview -->
  <%= showcase("command", :default) %>

  <!-- Installation -->
  <div id="installation" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Installation</h2>
    <p class="leading-7">Add the component to your project:</p>
    <%= render "docs/code_example", language: "bash", code: "rails generate shadcn:add command" %>
  </div>

  <!-- Usage -->
  <div id="usage" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Usage</h2>
    <p class="text-sm text-muted-foreground">This example now renders from the component preview source shown by the showcase block on this page.</p>
  </div>

  <!-- Examples -->
  <div id="examples" class="space-y-8">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Examples</h2>

    <!-- With Groups and Separator -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Groups with Separator</h3>
      <p class="text-sm text-muted-foreground">Organize commands into groups with separators.</p>
      <%= render "docs/demo_card" do %>
        <div class="rounded-lg border shadow-md w-full max-w-md">
          <%= render Shadcn::CommandComponent.new do |command| %>
            <% command.with_input(placeholder: "Search...") %>
            <% command.with_list do |list| %>
              <% list.with_empty { "No results found." } %>
              <% list.with_group(heading: "Applications") do |group| %>
                <% group.with_item(value: "calendar") do %>
                  <svg class="mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                  Calendar
                <% end %>
                <% group.with_item(value: "music") do %>
                  <svg class="mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                  Music
                <% end %>
              <% end %>
              <% list.with_separator %>
              <% list.with_group(heading: "Settings") do |group| %>
                <% group.with_item(value: "profile") do %>
                  <svg class="mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  Profile
                <% end %>
                <% group.with_item(value: "billing") do %>
                  <svg class="mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
                  Billing
                <% end %>
                <% group.with_item(value: "settings") do %>
                  <svg class="mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
                  Settings
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <p class="text-sm text-muted-foreground">This example now renders from the component preview source shown by the showcase block on this page.</p>
    </div>

    <!-- With Shortcuts -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">With Keyboard Shortcuts</h3>
      <p class="text-sm text-muted-foreground">Display keyboard shortcuts alongside commands.</p>
      <%= render "docs/demo_card" do %>
        <div class="rounded-lg border shadow-md w-full max-w-md">
          <%= render Shadcn::CommandComponent.new do |command| %>
            <% command.with_input(placeholder: "Type a command...") %>
            <% command.with_list do |list| %>
              <% list.with_group(heading: "Actions") do |group| %>
                <% group.with_item(value: "new-project") do |item| %>
                  <% item.with_shortcut { "⌘N" } %>
                  <svg class="mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M9 15h6"/><path d="M12 18v-6"/></svg>
                  New Project
                <% end %>
                <% group.with_item(value: "save") do |item| %>
                  <% item.with_shortcut { "⌘S" } %>
                  <svg class="mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                  Save
                <% end %>
                <% group.with_item(value: "settings") do |item| %>
                  <% item.with_shortcut { "⌘," } %>
                  <svg class="mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
                  Settings
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <p class="text-sm text-muted-foreground">This example now renders from the component preview source shown by the showcase block on this page.</p>
    </div>

    <!-- With Disabled Items -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">With Disabled Items</h3>
      <p class="text-sm text-muted-foreground">Disable specific items in the command list.</p>
      <%= render "docs/demo_card" do %>
        <div class="rounded-lg border shadow-md w-full max-w-md">
          <%= render Shadcn::CommandComponent.new do |command| %>
            <% command.with_input(placeholder: "Type a command...") %>
            <% command.with_list do |list| %>
              <% list.with_group(heading: "Actions") do |group| %>
                <% group.with_item(value: "new") { "New File" } %>
                <% group.with_item(value: "copy") { "Copy" } %>
                <% group.with_item(value: "delete", disabled: true) { "Delete (Disabled)" } %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <p class="text-sm text-muted-foreground">This example now renders from the component preview source shown by the showcase block on this page.</p>
    </div>

    <!-- Command Dialog -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Command Dialog</h3>
      <p class="text-sm text-muted-foreground">Use Command in a dialog with keyboard shortcut (⌘K).</p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::CommandDialogComponent.new(shortcut: "k") do |dialog| %>
          <% dialog.with_trigger do %>
            <%= render Shadcn::ButtonComponent.new(variant: :outline, class_name: "text-sm text-muted-foreground") do %>
              <span class="mr-2">Search...</span>
              <%= render Shadcn::KbdComponent.new(class_name: "pointer-events-none inline-flex h-5 select-none items-center gap-1 rounded border bg-muted px-1.5 font-mono text-[10px] font-medium text-muted-foreground ml-auto") do %>
                ⌘K
              <% end %>
            <% end %>
          <% end %>
          <% dialog.with_command do |command| %>
            <% command.with_input(placeholder: "Type a command or search...") %>
            <% command.with_list do |list| %>
              <% list.with_empty { "No results found." } %>
              <% list.with_group(heading: "Suggestions") do |group| %>
                <% group.with_item(value: "calendar") do %>
                  <svg class="mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                  Calendar
                <% end %>
                <% group.with_item(value: "search") do %>
                  <svg class="mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" x2="9.01" y1="9" y2="9"/><line x1="15" x2="15.01" y1="9" y2="9"/></svg>
                  Search Emoji
                <% end %>
                <% group.with_item(value: "calculator") do %>
                  <svg class="mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></svg>
                  Calculator
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <p class="text-sm text-muted-foreground">This example now renders from the component preview source shown by the showcase block on this page.</p>
    </div>
  </div>

  <!-- API Reference -->
  <div id="api-reference">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight mb-4">API Reference</h2>

    <h3 class="text-lg font-semibold mt-6 mb-3">CommandComponent</h3>
    <%= render "docs/props_table", props: [
      { name: "class_name", type: "String", default: "nil", description: "Additional CSS classes to apply" }
    ] %>

    <h3 class="text-lg font-semibold mt-6 mb-3">CommandInputComponent</h3>
    <%= render "docs/props_table", props: [
      { name: "placeholder", type: "String", default: '"Type a command or search..."', description: "Placeholder text for the input" },
      { name: "autofocus", type: "Boolean", default: "false", description: "Whether to autofocus the input" }
    ] %>

    <h3 class="text-lg font-semibold mt-6 mb-3">CommandGroupComponent</h3>
    <%= render "docs/props_table", props: [
      { name: "heading", type: "String", default: "nil", description: "Optional heading for the group" }
    ] %>

    <h3 class="text-lg font-semibold mt-6 mb-3">CommandItemComponent</h3>
    <%= render "docs/props_table", props: [
      { name: "value", type: "String", default: "nil", description: "The searchable value (defaults to content text)" },
      { name: "disabled", type: "Boolean", default: "false", description: "Whether the item is disabled" },
      { name: "on_select", type: "String", default: "nil", description: "JavaScript to execute on select" }
    ] %>

    <h3 class="text-lg font-semibold mt-6 mb-3">CommandDialogComponent</h3>
    <%= render "docs/props_table", props: [
      { name: "shortcut", type: "String", default: "nil", description: 'Keyboard shortcut to open (e.g., "k" for ⌘K)' }
    ] %>

    <div class="mt-6 space-y-4">
      <h3 class="text-lg font-semibold">Slots</h3>
      <div class="rounded-lg border">
        <table class="w-full">
          <thead>
            <tr class="border-b bg-muted/50">
              <th class="text-left p-3 text-sm font-medium">Slot</th>
              <th class="text-left p-3 text-sm font-medium">Description</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b">
              <td class="p-3 text-sm font-mono">with_input</td>
              <td class="p-3 text-sm">Search input with magnifying glass icon</td>
            </tr>
            <tr class="border-b">
              <td class="p-3 text-sm font-mono">with_list</td>
              <td class="p-3 text-sm">Container for groups and items with scrolling</td>
            </tr>
            <tr class="border-b">
              <td class="p-3 text-sm font-mono">with_empty</td>
              <td class="p-3 text-sm">Shown when no results match the search</td>
            </tr>
            <tr class="border-b">
              <td class="p-3 text-sm font-mono">with_group(heading:)</td>
              <td class="p-3 text-sm">Group of related items with optional heading</td>
            </tr>
            <tr class="border-b">
              <td class="p-3 text-sm font-mono">with_item(value:, disabled:)</td>
              <td class="p-3 text-sm">Individual selectable command item</td>
            </tr>
            <tr class="border-b">
              <td class="p-3 text-sm font-mono">with_separator</td>
              <td class="p-3 text-sm">Visual divider between groups</td>
            </tr>
            <tr>
              <td class="p-3 text-sm font-mono">with_shortcut</td>
              <td class="p-3 text-sm">Keyboard shortcut hint (inside item)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Keyboard Navigation -->
  <div class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Keyboard Navigation</h2>
    <div class="rounded-lg border">
      <table class="w-full">
        <thead>
          <tr class="border-b bg-muted/50">
            <th class="text-left p-3 text-sm font-medium">Key</th>
            <th class="text-left p-3 text-sm font-medium">Action</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b">
            <td class="p-3 text-sm"><kbd class="px-2 py-1 text-xs rounded bg-muted border">↑</kbd> / <kbd class="px-2 py-1 text-xs rounded bg-muted border">↓</kbd></td>
            <td class="p-3 text-sm">Navigate through items</td>
          </tr>
          <tr class="border-b">
            <td class="p-3 text-sm"><kbd class="px-2 py-1 text-xs rounded bg-muted border">Enter</kbd></td>
            <td class="p-3 text-sm">Select the highlighted item</td>
          </tr>
          <tr class="border-b">
            <td class="p-3 text-sm"><kbd class="px-2 py-1 text-xs rounded bg-muted border">Escape</kbd></td>
            <td class="p-3 text-sm">Clear search input or close dialog</td>
          </tr>
          <tr>
            <td class="p-3 text-sm"><kbd class="px-2 py-1 text-xs rounded bg-muted border">⌘K</kbd></td>
            <td class="p-3 text-sm">Open/close command dialog (if shortcut configured)</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Accessibility -->
  <div class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Accessibility</h2>
    <ul class="ml-6 list-disc space-y-2 [&>li]:mt-2">
      <li>Uses <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">role="option"</code> for items</li>
      <li>Uses <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">role="group"</code> for command groups</li>
      <li>Full keyboard navigation support (Arrow keys, Enter, Escape)</li>
      <li>Focus is managed within the command palette</li>
      <li>Dialog traps focus and returns it on close</li>
      <li>Screen readers announce when no results are found</li>
    </ul>
  </div>
</div>
