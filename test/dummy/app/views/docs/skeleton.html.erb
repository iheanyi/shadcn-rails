<% content_for :title, "Skeleton" %>

<% content_for :toc do %>
  <div class="flex flex-col space-y-2 text-sm">
    <a href="#installation" class="text-muted-foreground hover:text-foreground">Installation</a>
    <a href="#usage" class="text-muted-foreground hover:text-foreground">Usage</a>
    <a href="#examples" class="text-muted-foreground hover:text-foreground">Examples</a>
    <a href="#api-reference" class="text-muted-foreground hover:text-foreground">API Reference</a>
  </div>
<% end %>

<div class="space-y-8">
  <!-- Header -->
  <div class="space-y-2">
    <h1 class="scroll-m-20 text-4xl font-bold tracking-tight">Skeleton</h1>
    <p class="text-xl text-muted-foreground">Use to show a placeholder while content is loading.</p>
    <div class="flex items-center gap-2 mt-4">
      <span class="inline-flex items-center rounded-md bg-green-50 dark:bg-green-950 px-2 py-1 text-xs font-medium text-green-700 dark:text-green-300 ring-1 ring-inset ring-green-700/10 dark:ring-green-300/10">
        No JavaScript Required
      </span>
    </div>
  </div>

  <!-- Preview -->
  <%= showcase("skeleton", :default) %>

  <!-- Installation -->
  <div id="installation" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Installation</h2>
    <p class="leading-7">Add the component to your project:</p>
    <%= render "docs/code_example", language: "bash", code: "rails generate shadcn:add skeleton" %>
  </div>

  <!-- Usage -->
  <div id="usage" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Usage</h2>
    <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/skeleton/usage.txt")) %>
  </div>

  <!-- Examples -->
  <div id="examples" class="space-y-8">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Examples</h2>

    <!-- Basic Line -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Basic Line</h3>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::SkeletonComponent.new(class_name: "h-4 w-[250px]") %>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/skeleton/basic-line.txt")) %>
    </div>

    <!-- Avatar -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Avatar</h3>
      <p class="text-sm text-muted-foreground">Use <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">rounded-full</code> for circular shapes.</p>
      <%= render "docs/demo_card" do %>
        <div class="flex items-center space-x-4">
          <%= render Shadcn::SkeletonComponent.new(class_name: "h-12 w-12 rounded-full") %>
          <div class="space-y-2">
            <%= render Shadcn::SkeletonComponent.new(class_name: "h-4 w-[250px]") %>
            <%= render Shadcn::SkeletonComponent.new(class_name: "h-4 w-[200px]") %>
          </div>
        </div>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/skeleton/avatar.txt")) %>
    </div>

    <!-- Card -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Card</h3>
      <%= render "docs/demo_card" do %>
        <div class="flex flex-col space-y-3">
          <%= render Shadcn::SkeletonComponent.new(class_name: "h-[125px] w-[250px] rounded-xl") %>
          <div class="space-y-2">
            <%= render Shadcn::SkeletonComponent.new(class_name: "h-4 w-[250px]") %>
            <%= render Shadcn::SkeletonComponent.new(class_name: "h-4 w-[200px]") %>
          </div>
        </div>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/skeleton/card.txt")) %>
    </div>

    <!-- Article List -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Article List</h3>
      <%= render "docs/demo_card" do %>
        <div class="space-y-6 w-full max-w-md">
          <% 3.times do %>
            <div class="flex space-x-4">
              <%= render Shadcn::SkeletonComponent.new(class_name: "h-20 w-20 rounded-lg shrink-0") %>
              <div class="flex-1 space-y-2 py-1">
                <%= render Shadcn::SkeletonComponent.new(class_name: "h-4 w-3/4") %>
                <%= render Shadcn::SkeletonComponent.new(class_name: "h-4 w-full") %>
                <%= render Shadcn::SkeletonComponent.new(class_name: "h-4 w-1/2") %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/skeleton/article-list.txt")) %>
    </div>

    <!-- Table -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Table</h3>
      <%= render "docs/demo_card" do %>
        <div class="w-full max-w-lg space-y-3">
          <div class="flex space-x-4">
            <%= render Shadcn::SkeletonComponent.new(class_name: "h-4 w-1/4") %>
            <%= render Shadcn::SkeletonComponent.new(class_name: "h-4 w-1/4") %>
            <%= render Shadcn::SkeletonComponent.new(class_name: "h-4 w-1/4") %>
            <%= render Shadcn::SkeletonComponent.new(class_name: "h-4 w-1/4") %>
          </div>
          <%= render Shadcn::SeparatorComponent.new %>
          <% 4.times do %>
            <div class="flex space-x-4">
              <%= render Shadcn::SkeletonComponent.new(class_name: "h-4 w-1/4") %>
              <%= render Shadcn::SkeletonComponent.new(class_name: "h-4 w-1/4") %>
              <%= render Shadcn::SkeletonComponent.new(class_name: "h-4 w-1/4") %>
              <%= render Shadcn::SkeletonComponent.new(class_name: "h-4 w-1/4") %>
            </div>
          <% end %>
        </div>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/skeleton/table.txt")) %>
    </div>

    <!-- With Turbo Frame -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">With Turbo Frame</h3>
      <p class="text-sm text-muted-foreground">Skeletons work great as loading placeholders in Turbo Frames.</p>
      <%= render "docs/demo_card" do %>
        <div class="p-4 border rounded-lg border-dashed">
          <p class="text-xs text-muted-foreground mb-3 font-mono">&lt;turbo-frame id="user-profile"&gt;</p>
          <div class="flex items-center space-x-4">
            <%= render Shadcn::SkeletonComponent.new(class_name: "h-12 w-12 rounded-full") %>
            <div class="space-y-2">
              <%= render Shadcn::SkeletonComponent.new(class_name: "h-4 w-[150px]") %>
              <%= render Shadcn::SkeletonComponent.new(class_name: "h-4 w-[100px]") %>
            </div>
          </div>
          <p class="text-xs text-muted-foreground mt-3 font-mono">&lt;/turbo-frame&gt;</p>
        </div>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/skeleton/with-turbo-frame.txt")) %>
    </div>
  </div>

    <!-- Circle -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Circle</h3>
      <%= showcase("skeleton", :circle) %>
    </div>

    <!-- Rectangle -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Rectangle</h3>
      <%= showcase("skeleton", :rectangle) %>
    </div>

    <!-- Text Line -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Text Line</h3>
      <%= showcase("skeleton", :text_line) %>
    </div>

    <!-- Button -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Button</h3>
      <%= showcase("skeleton", :button) %>
    </div>

    <!-- Profile -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Profile</h3>
      <%= showcase("skeleton", :profile) %>
    </div>

    <!-- Article -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Article</h3>
      <%= showcase("skeleton", :article) %>
    </div>

  <!-- API Reference -->
  <div id="api-reference">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight mb-4">API Reference</h2>
    <%= render "docs/props_table", props: [
      { name: "class_name", type: "String", default: "nil", description: "CSS classes to control size and shape (h-*, w-*, rounded-*)" }
    ] %>

    <div class="mt-6 space-y-4">
      <h3 class="text-lg font-semibold">Common Class Patterns</h3>
      <div class="rounded-lg border">
        <table class="w-full">
          <thead>
            <tr class="border-b bg-muted/50">
              <th class="text-left p-3 text-sm font-medium">Use Case</th>
              <th class="text-left p-3 text-sm font-medium">Classes</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b">
              <td class="p-3 text-sm">Text line</td>
              <td class="p-3 text-sm font-mono">h-4 w-[200px]</td>
            </tr>
            <tr class="border-b">
              <td class="p-3 text-sm">Avatar</td>
              <td class="p-3 text-sm font-mono">h-12 w-12 rounded-full</td>
            </tr>
            <tr class="border-b">
              <td class="p-3 text-sm">Image/Card</td>
              <td class="p-3 text-sm font-mono">h-[125px] w-[250px] rounded-xl</td>
            </tr>
            <tr>
              <td class="p-3 text-sm">Button</td>
              <td class="p-3 text-sm font-mono">h-10 w-[100px]</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Accessibility -->
  <div class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Accessibility</h2>
    <ul class="ml-6 list-disc space-y-2 [&>li]:mt-2">
      <li>Skeletons use <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">animate-pulse</code> for subtle animation</li>
      <li>Consider adding <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">aria-busy="true"</code> to container elements while loading</li>
      <li>Use <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">aria-live="polite"</code> regions to announce when content loads</li>
      <li>Ensure skeleton layouts match the actual content layout to reduce layout shift</li>
    </ul>
  </div>
</div>
