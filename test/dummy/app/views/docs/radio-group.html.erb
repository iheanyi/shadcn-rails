<% content_for :title, "Radio Group" %>

<% content_for :toc do %>
  <div class="flex flex-col space-y-2 text-sm">
    <a href="#installation" class="text-muted-foreground hover:text-foreground">Installation</a>
    <a href="#usage" class="text-muted-foreground hover:text-foreground">Usage</a>
    <a href="#examples" class="text-muted-foreground hover:text-foreground">Examples</a>
    <a href="#api-reference" class="text-muted-foreground hover:text-foreground">API Reference</a>
    <a href="#stimulus" class="text-muted-foreground hover:text-foreground">Stimulus Controller</a>
    <a href="#accessibility" class="text-muted-foreground hover:text-foreground">Accessibility</a>
  </div>
<% end %>

<div class="space-y-8">
  <!-- Header -->
  <div class="space-y-2">
    <h1 class="scroll-m-20 text-4xl font-bold tracking-tight">Radio Group</h1>
    <p class="text-xl text-muted-foreground">A set of checkable buttons where only one can be checked at a time.</p>
    <div class="flex items-center gap-2 mt-4">
      <span class="inline-flex items-center rounded-md bg-blue-50 dark:bg-blue-950 px-2 py-1 text-xs font-medium text-blue-700 dark:text-blue-300 ring-1 ring-inset ring-blue-700/10 dark:ring-blue-300/10">
        Stimulus Controller: shadcn--radio-group
      </span>
    </div>
  </div>

  <!-- Preview -->
  <%= render "docs/demo_card" do %>
    <div class="flex justify-center">
      <%= render Shadcn::RadioGroupComponent.new(name: "preview", value: "comfortable") do |group| %>
        <div class="flex items-center space-x-2">
          <% group.with_item(value: "default", id: "preview-default") %>
          <%= render Shadcn::LabelComponent.new(for: "preview-default") { "Default" } %>
        </div>
        <div class="flex items-center space-x-2">
          <% group.with_item(value: "comfortable", id: "preview-comfortable") %>
          <%= render Shadcn::LabelComponent.new(for: "preview-comfortable") { "Comfortable" } %>
        </div>
        <div class="flex items-center space-x-2">
          <% group.with_item(value: "compact", id: "preview-compact") %>
          <%= render Shadcn::LabelComponent.new(for: "preview-compact") { "Compact" } %>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Installation -->
  <div id="installation" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Installation</h2>
    <p class="leading-7">Add the component to your project:</p>
    <%= render "docs/code_example", language: "bash", code: "rails generate shadcn:component radio-group" %>
    <p class="text-sm text-muted-foreground mt-2">
      This will also install the <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">Label</code> component if it's not already present.
    </p>
  </div>

  <!-- Usage -->
  <div id="usage" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Usage</h2>
    <%= erb_example("radio_group/usage") %>
  </div>

  <!-- Examples -->
  <div id="examples" class="space-y-8">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Examples</h2>

    <!-- Horizontal Layout -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Horizontal Layout</h3>
      <p class="text-sm text-muted-foreground">
        Set <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">orientation: :horizontal</code> to display radio buttons in a row.
      </p>
      <%= render "docs/demo_card" do %>
        <div class="flex justify-center">
          <%= render Shadcn::RadioGroupComponent.new(
            name: "layout",
            value: "grid",
            orientation: :horizontal
          ) do |group| %>
            <div class="flex items-center space-x-2">
              <% group.with_item(value: "list", id: "layout-list") %>
              <%= render Shadcn::LabelComponent.new(for: "layout-list") { "List" } %>
            </div>
            <div class="flex items-center space-x-2">
              <% group.with_item(value: "grid", id: "layout-grid") %>
              <%= render Shadcn::LabelComponent.new(for: "layout-grid") { "Grid" } %>
            </div>
            <div class="flex items-center space-x-2">
              <% group.with_item(value: "table", id: "layout-table") %>
              <%= render Shadcn::LabelComponent.new(for: "layout-table") { "Table" } %>
            </div>
          <% end %>
        </div>
      <% end %>
      <%= erb_example("radio_group/horizontal") %>
    </div>

    <!-- With Description -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">With Description</h3>
      <p class="text-sm text-muted-foreground">Add descriptive text below each option for clarity.</p>
      <%= render "docs/demo_card" do %>
        <div class="flex justify-center">
          <div class="max-w-md w-full">
            <%= render Shadcn::RadioGroupComponent.new(name: "plan", value: "pro") do |group| %>
              <div class="flex items-start space-x-3">
                <% group.with_item(value: "free", id: "plan-free") %>
                <div class="grid gap-1.5 leading-none">
                  <%= render Shadcn::LabelComponent.new(for: "plan-free") { "Free" } %>
                  <p class="text-sm text-muted-foreground">
                    Basic features for personal use
                  </p>
                </div>
              </div>
              <div class="flex items-start space-x-3">
                <% group.with_item(value: "pro", id: "plan-pro") %>
                <div class="grid gap-1.5 leading-none">
                  <%= render Shadcn::LabelComponent.new(for: "plan-pro") { "Pro" } %>
                  <p class="text-sm text-muted-foreground">
                    Advanced features for professionals
                  </p>
                </div>
              </div>
              <div class="flex items-start space-x-3">
                <% group.with_item(value: "enterprise", id: "plan-enterprise") %>
                <div class="grid gap-1.5 leading-none">
                  <%= render Shadcn::LabelComponent.new(for: "plan-enterprise") { "Enterprise" } %>
                  <p class="text-sm text-muted-foreground">
                    Full features for teams and organizations
                  </p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
      <%= erb_example("radio_group/with_description") %>
    </div>

    <!-- Disabled State -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Disabled State</h3>
      <p class="text-sm text-muted-foreground">Individual radio buttons can be disabled.</p>
      <%= render "docs/demo_card" do %>
        <div class="flex justify-center">
          <%= render Shadcn::RadioGroupComponent.new(name: "disabled-example", value: "comfortable") do |group| %>
            <div class="flex items-center space-x-2">
              <% group.with_item(value: "comfortable", id: "disabled-comfortable") %>
              <%= render Shadcn::LabelComponent.new(for: "disabled-comfortable") { "Comfortable" } %>
            </div>
            <div class="flex items-center space-x-2">
              <% group.with_item(value: "compact", id: "disabled-compact", disabled: true) %>
              <%= render Shadcn::LabelComponent.new(for: "disabled-compact") { "Compact (Disabled)" } %>
            </div>
          <% end %>
        </div>
      <% end %>
      <%= erb_example("radio_group/disabled") %>
    </div>

    <!-- Form Integration -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Form Integration</h3>
      <p class="text-sm text-muted-foreground">
        The radio group works seamlessly with Rails forms. The <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">name</code> attribute determines the form parameter name.
      </p>
      <%= erb_example("radio_group/form") %>
    </div>
  </div>

  <!-- API Reference -->
  <div id="api-reference">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight mb-4">API Reference</h2>

    <h3 class="text-lg font-semibold mt-6 mb-3">RadioGroupComponent</h3>
    <%= render "docs/props_table", title: nil, props: [
      { name: "name", type: "String", default: "required", description: "Input name attribute for form submission" },
      { name: "value", type: "String", default: "nil", description: "Currently selected value" },
      { name: "disabled", type: "Boolean", default: "false", description: "Whether the entire group is disabled" },
      { name: "required", type: "Boolean", default: "false", description: "Whether a selection is required" },
      { name: "orientation", type: "Symbol", default: ":vertical", description: "Layout orientation (:vertical or :horizontal)" },
      { name: "class_name", type: "String", default: "nil", description: "Additional CSS classes to apply" }
    ] %>

    <h3 class="text-lg font-semibold mt-6 mb-3">RadioGroupItemComponent (via with_item)</h3>
    <%= render "docs/props_table", title: nil, props: [
      { name: "value", type: "String", default: "required", description: "The value this radio button represents" },
      { name: "id", type: "String", default: "nil", description: "HTML id attribute for label association" },
      { name: "disabled", type: "Boolean", default: "false", description: "Whether this specific item is disabled" }
    ] %>
  </div>

  <!-- Stimulus Controller -->
  <div id="stimulus" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Stimulus Controller</h2>
    <p class="leading-7">
      The Radio Group component uses the <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">shadcn--radio-group</code> Stimulus controller
      to handle selection and keyboard navigation.
    </p>

    <h3 class="text-lg font-semibold mt-6 mb-3">Features</h3>
    <ul class="ml-6 list-disc space-y-2 [&>li]:mt-2">
      <li>Click to select radio buttons</li>
      <li>Arrow key navigation (Up/Down or Left/Right)</li>
      <li>Space/Enter to select focused item</li>
      <li>Automatic selection update with visual feedback</li>
      <li>Form compatibility with native input events</li>
    </ul>

    <h3 class="text-lg font-semibold mt-6 mb-3">Events</h3>
    <p class="text-sm text-muted-foreground mb-3">
      The controller dispatches a custom <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">shadcn--radio-group:change</code> event
      when the selection changes.
    </p>
    <%= render "docs/code_example", language: "javascript", code: %{// Listen for changes
document.addEventListener('shadcn--radio-group:change', (event) => {
  const { value, name } = event.detail
  console.log(`Radio group "${name}" changed to: ${value}`)
})} %>

    <h3 class="text-lg font-semibold mt-6 mb-3">Targets</h3>
    <div class="relative w-full overflow-auto">
      <table class="w-full caption-bottom text-sm">
        <thead class="[&_tr]:border-b">
          <tr class="border-b transition-colors">
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Target</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Description</th>
          </tr>
        </thead>
        <tbody class="[&_tr:last-child]:border-0">
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">item</td>
            <td class="p-4 align-middle text-muted-foreground">Individual radio button elements</td>
          </tr>
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">indicator</td>
            <td class="p-4 align-middle text-muted-foreground">Visual indicator (circle) shown when selected</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="text-lg font-semibold mt-6 mb-3">Values</h3>
    <div class="relative w-full overflow-auto">
      <table class="w-full caption-bottom text-sm">
        <thead class="[&_tr]:border-b">
          <tr class="border-b transition-colors">
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Value</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Type</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Description</th>
          </tr>
        </thead>
        <tbody class="[&_tr:last-child]:border-0">
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">name</td>
            <td class="p-4 align-middle font-mono text-sm">String</td>
            <td class="p-4 align-middle text-muted-foreground">Input name for form submission</td>
          </tr>
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">value</td>
            <td class="p-4 align-middle font-mono text-sm">String</td>
            <td class="p-4 align-middle text-muted-foreground">Currently selected value</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Accessibility -->
  <div id="accessibility" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Accessibility</h2>
    <ul class="ml-6 list-disc space-y-2 [&>li]:mt-2">
      <li>Uses <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">role="radiogroup"</code> for the container</li>
      <li>Each item has <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">role="radio"</code></li>
      <li>Selection state communicated via <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">aria-checked</code> attribute</li>
      <li>Supports keyboard navigation with Arrow keys, Space, and Enter</li>
      <li>Only the selected item or first item is in tab order (roving tabindex)</li>
      <li>Required state indicated with <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">aria-required</code></li>
      <li>Disabled state indicated with <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">aria-disabled</code></li>
      <li>Associates labels using <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">for</code> and <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">id</code> attributes</li>
    </ul>
    <p class="text-sm text-muted-foreground mt-4">
      Follows the <a href="https://www.w3.org/WAI/ARIA/apg/patterns/radio/" target="_blank" class="underline hover:text-foreground">WAI-ARIA Radio Group Pattern</a>.
    </p>
  </div>
</div>
