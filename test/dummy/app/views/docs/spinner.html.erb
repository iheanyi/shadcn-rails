<% content_for :title, "Spinner" %>

<% content_for :toc do %>
  <div class="flex flex-col space-y-2 text-sm">
    <a href="#installation" class="text-muted-foreground hover:text-foreground">Installation</a>
    <a href="#usage" class="text-muted-foreground hover:text-foreground">Usage</a>
    <a href="#examples" class="text-muted-foreground hover:text-foreground">Examples</a>
    <a href="#api-reference" class="text-muted-foreground hover:text-foreground">API Reference</a>
  </div>
<% end %>

<div class="space-y-8">
  <!-- Header -->
  <div class="space-y-2">
    <h1 class="scroll-m-20 text-4xl font-bold tracking-tight">Spinner</h1>
    <p class="text-xl text-muted-foreground">A loading spinner animation for indicating loading states.</p>
    <div class="flex items-center gap-2 mt-4">
      <span class="inline-flex items-center rounded-md bg-green-50 dark:bg-green-950 px-2 py-1 text-xs font-medium text-green-700 dark:text-green-300 ring-1 ring-inset ring-green-700/10 dark:ring-green-300/10">
        No JavaScript Required
      </span>
    </div>
  </div>

  <!-- Preview -->
  <%= render "docs/demo_card" do %>
    <%= render Shadcn::SpinnerComponent.new %>
  <% end %>

  <!-- Installation -->
  <div id="installation" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Installation</h2>
    <p class="leading-7">Add the component to your project:</p>
    <%= render "docs/code_example", language: "bash", code: "rails generate shadcn:add spinner" %>
  </div>

  <!-- Usage -->
  <div id="usage" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Usage</h2>
    <%= render "docs/code_example", language: "erb", code: '<%%= render Shadcn::SpinnerComponent.new %>' %>
  </div>

  <!-- Examples -->
  <div id="examples" class="space-y-8">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Examples</h2>

    <!-- Sizes -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Sizes</h3>
      <%= render "docs/demo_card" do %>
        <div class="flex items-center gap-4">
          <%= render Shadcn::SpinnerComponent.new(size: :sm) %>
          <%= render Shadcn::SpinnerComponent.new(size: :default) %>
          <%= render Shadcn::SpinnerComponent.new(size: :lg) %>
          <%= render Shadcn::SpinnerComponent.new(size: :xl) %>
        </div>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: <<~ERB
<%%= render Shadcn::SpinnerComponent.new(size: :sm) %>
<%%= render Shadcn::SpinnerComponent.new(size: :default) %>
<%%= render Shadcn::SpinnerComponent.new(size: :lg) %>
<%%= render Shadcn::SpinnerComponent.new(size: :xl) %>
ERB
      %>
    </div>

    <!-- With Button -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">With Button</h3>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::ButtonComponent.new(disabled: true) do %>
          <%= render Shadcn::SpinnerComponent.new(size: :sm, class_name: "mr-2") %>
          Loading...
        <% end %>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: <<~ERB
<%%= render Shadcn::ButtonComponent.new(disabled: true) do %>
  <%%= render Shadcn::SpinnerComponent.new(size: :sm, class_name: "mr-2") %>
  Loading...
<%% end %>
ERB
      %>
    </div>

    <!-- Custom Color -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Custom Color</h3>
      <%= render "docs/demo_card" do %>
        <div class="flex items-center gap-4">
          <%= render Shadcn::SpinnerComponent.new(class_name: "text-primary") %>
          <%= render Shadcn::SpinnerComponent.new(class_name: "text-destructive") %>
          <%= render Shadcn::SpinnerComponent.new(class_name: "text-blue-500") %>
        </div>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: <<~ERB
<%%= render Shadcn::SpinnerComponent.new(class_name: "text-primary") %>
<%%= render Shadcn::SpinnerComponent.new(class_name: "text-destructive") %>
<%%= render Shadcn::SpinnerComponent.new(class_name: "text-blue-500") %>
ERB
      %>
    </div>

    <!-- Loading State -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Loading State</h3>
      <%= render "docs/demo_card" do %>
        <div class="flex flex-col items-center gap-2">
          <%= render Shadcn::SpinnerComponent.new(size: :lg) %>
          <span class="text-sm text-muted-foreground">Loading content...</span>
        </div>
      <% end %>
    </div>
  </div>

  <!-- API Reference -->
  <div id="api-reference">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight mb-4">API Reference</h2>
    <%= render "docs/props_table", props: [
      { name: "size", type: "Symbol", default: ":default", description: "Spinner size (:sm, :default, :lg, :xl)" },
      { name: "class_name", type: "String", default: "nil", description: "Additional CSS classes to apply" }
    ] %>
  </div>

  <!-- Accessibility -->
  <div class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Accessibility</h2>
    <ul class="ml-6 list-disc space-y-2 [&>li]:mt-2">
      <li>Includes <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">role="status"</code> to indicate loading state</li>
      <li>Has <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">aria-label="Loading"</code> for screen readers</li>
      <li>Consider adding descriptive text for context when using in loading states</li>
    </ul>
  </div>
</div>
