<% content_for :title, "Pagination" %>

<% content_for :toc do %>
  <div class="flex flex-col space-y-2 text-sm">
    <a href="#installation" class="text-muted-foreground hover:text-foreground">Installation</a>
    <a href="#usage" class="text-muted-foreground hover:text-foreground">Usage</a>
    <a href="#examples" class="text-muted-foreground hover:text-foreground">Examples</a>
    <a href="#gem-integration" class="text-muted-foreground hover:text-foreground">Gem Integration</a>
    <a href="#api-reference" class="text-muted-foreground hover:text-foreground">API Reference</a>
  </div>
<% end %>

<div class="space-y-8">
  <!-- Header -->
  <div class="space-y-2">
    <h1 class="scroll-m-20 text-4xl font-bold tracking-tight">Pagination</h1>
    <p class="text-xl text-muted-foreground">Pagination with page navigation, next and previous links.</p>
    <div class="flex items-center gap-2 mt-4">
      <span class="inline-flex items-center rounded-md bg-green-50 dark:bg-green-950 px-2 py-1 text-xs font-medium text-green-700 dark:text-green-300 ring-1 ring-inset ring-green-700/10 dark:ring-green-300/10">
        No JavaScript Required
      </span>
    </div>
  </div>

  <!-- Preview -->
  <%= render "docs/demo_card" do %>
    <%= render Shadcn::PaginationComponent.new do |pagination| %>
      <% pagination.with_pagination_content do |content| %>
        <% content.with_previous(href: "#") %>
        <% content.with_item(href: "#") { "1" } %>
        <% content.with_item(href: "#", active: true) { "2" } %>
        <% content.with_item(href: "#") { "3" } %>
        <% content.with_ellipse %>
        <% content.with_item(href: "#") { "10" } %>
        <% content.with_next_page(href: "#") %>
      <% end %>
    <% end %>
  <% end %>

  <!-- Installation -->
  <div id="installation" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Installation</h2>
    <p class="leading-7">Add the component to your project:</p>
    <%= render "docs/code_example", language: "bash", code: "rails generate shadcn:add pagination" %>
  </div>

  <!-- Usage -->
  <div id="usage" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Usage</h2>
    <p class="leading-7">There are three ways to use the Pagination component:</p>

    <h3 class="text-lg font-semibold mt-4">1. Slot-based API (Full Control)</h3>
    <%= erb_example("pagination/usage_slot") %>

    <h3 class="text-lg font-semibold mt-6">2. Collection-based API (Kaminari/will_paginate)</h3>
    <%= erb_example("pagination/usage_collection") %>

    <h3 class="text-lg font-semibold mt-6">3. Pagy-based API</h3>
    <%= erb_example("pagination/usage_pagy") %>
  </div>

  <!-- Examples -->
  <div id="examples" class="space-y-8">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Examples</h2>

    <!-- Basic Pagination -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Basic</h3>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::PaginationComponent.new do |pagination| %>
          <% pagination.with_pagination_content do |content| %>
            <% content.with_previous(href: "#") %>
            <% content.with_item(href: "#") { "1" } %>
            <% content.with_item(href: "#", active: true) { "2" } %>
            <% content.with_item(href: "#") { "3" } %>
            <% content.with_next_page(href: "#") %>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <!-- With Ellipsis -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">With Ellipsis</h3>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::PaginationComponent.new do |pagination| %>
          <% pagination.with_pagination_content do |content| %>
            <% content.with_previous(href: "#") %>
            <% content.with_item(href: "#") { "1" } %>
            <% content.with_ellipse %>
            <% content.with_item(href: "#") { "4" } %>
            <% content.with_item(href: "#", active: true) { "5" } %>
            <% content.with_item(href: "#") { "6" } %>
            <% content.with_ellipse %>
            <% content.with_item(href: "#") { "10" } %>
            <% content.with_next_page(href: "#") %>
          <% end %>
        <% end %>
      <% end %>
      <%= erb_example("pagination/ellipse") %>
    </div>

    <!-- Disabled Navigation -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Disabled Navigation</h3>
      <p class="text-sm text-muted-foreground">On the first or last page, disable the previous/next buttons:</p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::PaginationComponent.new do |pagination| %>
          <% pagination.with_pagination_content do |content| %>
            <% content.with_previous(disabled: true) %>
            <% content.with_item(href: "#", active: true) { "1" } %>
            <% content.with_item(href: "#") { "2" } %>
            <% content.with_item(href: "#") { "3" } %>
            <% content.with_next_page(href: "#") %>
          <% end %>
        <% end %>
      <% end %>
      <%= erb_example("pagination/disabled") %>
    </div>
  </div>

  <!-- Gem Integration -->
  <div id="gem-integration" class="space-y-8">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Gem Integration</h2>
    <p class="leading-7">
      The pagination component works seamlessly with popular pagination gems.
      Just pass your paginated collection or Pagy object directly.
    </p>

    <!-- Kaminari -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Kaminari</h3>
      <p class="text-sm text-muted-foreground">
        <a href="https://github.com/kaminari/kaminari" target="_blank" class="underline hover:text-foreground">Kaminari</a>
        is the most popular pagination gem for Rails.
      </p>
      <%= ruby_example("pagination/kaminari_controller", title: "Controller") %>
      <%= erb_example("pagination/kaminari_view", title: "View") %>
    </div>

    <!-- will_paginate -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">will_paginate</h3>
      <p class="text-sm text-muted-foreground">
        <a href="https://github.com/mislav/will_paginate" target="_blank" class="underline hover:text-foreground">will_paginate</a>
        is a classic pagination library.
      </p>
      <%= ruby_example("pagination/will_paginate_controller", title: "Controller") %>
      <%= erb_example("pagination/will_paginate_view", title: "View") %>
    </div>

    <!-- Pagy -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Pagy</h3>
      <p class="text-sm text-muted-foreground">
        <a href="https://github.com/ddnexus/pagy" target="_blank" class="underline hover:text-foreground">Pagy</a>
        is the fastest pagination gem with the smallest memory footprint.
      </p>
      <%= ruby_example("pagination/pagy_controller", title: "Controller") %>
      <%= erb_example("pagination/pagy_view", title: "View") %>
    </div>

    <!-- Custom URL Builder -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Custom URL Builder</h3>
      <p class="text-sm text-muted-foreground">
        The <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">url_builder</code> lambda receives the page number
        and should return the URL for that page. This gives you full control over URL generation.
      </p>
      <%= erb_example("pagination/url_builder") %>
    </div>

    <!-- Window Size -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Window Size</h3>
      <p class="text-sm text-muted-foreground">
        Control how many pages are shown around the current page with the <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">window</code> option.
      </p>
      <%= erb_example("pagination/window") %>
    </div>
  </div>

  <!-- API Reference -->
  <div id="api-reference">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight mb-4">API Reference</h2>

    <h3 class="text-lg font-semibold mt-6 mb-3">PaginationComponent</h3>
    <%= render "docs/props_table", title: nil, props: [
      { name: "collection", type: "Object", default: "nil", description: "Kaminari or will_paginate collection" },
      { name: "pagy", type: "Pagy", default: "nil", description: "Pagy pagination object" },
      { name: "url_builder", type: "Proc", default: '->(page) { "?page=#{page}" }', description: "Lambda to generate page URLs, receives page number" },
      { name: "window", type: "Integer", default: "2", description: "Number of pages to show around current page" }
    ] %>

    <h3 class="text-lg font-semibold mt-6 mb-3">PaginationContentComponent Slots</h3>
    <div class="relative w-full overflow-auto">
      <table class="w-full caption-bottom text-sm">
        <thead class="[&_tr]:border-b">
          <tr class="border-b transition-colors">
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Slot</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Props</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Description</th>
          </tr>
        </thead>
        <tbody class="[&_tr:last-child]:border-0">
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_previous</td>
            <td class="p-4 align-middle"><code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">href:</code>, <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">disabled:</code></td>
            <td class="p-4 align-middle text-muted-foreground">Previous page link</td>
          </tr>
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_next_page</td>
            <td class="p-4 align-middle"><code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">href:</code>, <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">disabled:</code></td>
            <td class="p-4 align-middle text-muted-foreground">Next page link</td>
          </tr>
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_item</td>
            <td class="p-4 align-middle"><code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">href:</code>, <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">active:</code></td>
            <td class="p-4 align-middle text-muted-foreground">Page number link (yields page number)</td>
          </tr>
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_ellipse</td>
            <td class="p-4 align-middle">-</td>
            <td class="p-4 align-middle text-muted-foreground">Ellipsis indicator for skipped pages</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Accessibility -->
  <div class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Accessibility</h2>
    <ul class="ml-6 list-disc space-y-2 [&>li]:mt-2">
      <li>Uses <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">&lt;nav&gt;</code> element with <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">role="navigation"</code></li>
      <li>Has <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">aria-label="pagination"</code> for screen readers</li>
      <li>Current page marked with <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">aria-current="page"</code></li>
      <li>Disabled links have <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">aria-disabled="true"</code></li>
    </ul>
  </div>
</div>
