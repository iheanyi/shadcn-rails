<% content_for :title, "Slider" %>

<% content_for :toc do %>
  <div class="flex flex-col space-y-2 text-sm">
    <a href="#installation" class="text-muted-foreground hover:text-foreground">Installation</a>
    <a href="#usage" class="text-muted-foreground hover:text-foreground">Usage</a>
    <a href="#examples" class="text-muted-foreground hover:text-foreground">Examples</a>
    <a href="#api-reference" class="text-muted-foreground hover:text-foreground">API Reference</a>
  </div>
<% end %>

<div class="space-y-8">
  <!-- Header -->
  <div class="space-y-2">
    <h1 class="scroll-m-20 text-4xl font-bold tracking-tight">Slider</h1>
    <p class="text-xl text-muted-foreground">An input where the user selects a value from within a given range.</p>
    <div class="flex items-center gap-2 mt-4">
      <span class="inline-flex items-center rounded-md bg-blue-50 dark:bg-blue-950 px-2 py-1 text-xs font-medium text-blue-700 dark:text-blue-300 ring-1 ring-inset ring-blue-700/10 dark:ring-blue-300/10">
        Stimulus: shadcn--slider
      </span>
    </div>
  </div>

  <!-- Preview -->
  <%= showcase("slider", :default) %>

  <!-- Installation -->
  <div id="installation" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Installation</h2>
    <p class="leading-7">Add the component to your project:</p>
    <%= render "docs/code_example", language: "bash", code: "rails generate shadcn:add slider" %>
  </div>

  <!-- Usage -->
  <div id="usage" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Usage</h2>
    <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/slider/usage.txt")) %>
  </div>

  <!-- Examples -->
  <div id="examples" class="space-y-8">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Examples</h2>

    <!-- Default -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Default</h3>
      <%= render "docs/demo_card" do %>
        <div class="w-[60%] space-y-2">
          <div class="flex justify-between">
            <span class="text-sm font-medium">Value</span>
            <span id="default-slider-value" class="text-sm text-muted-foreground">33</span>
          </div>
          <%= render Shadcn::SliderComponent.new(value: 33, data: { "output-target": "default-slider-value", "output-format": "{value}" }) %>
        </div>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/slider/default.txt")) %>
    </div>

    <!-- With Synced Label -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">With Synced Label</h3>
      <p class="text-sm text-muted-foreground">Use <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">data-output-target</code> and <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">data-output-format</code> to sync value labels.</p>
      <%= render "docs/demo_card" do %>
        <div class="space-y-4 w-full max-w-md">
          <div class="flex justify-between">
            <%= render Shadcn::LabelComponent.new { "Volume" } %>
            <span id="volume-label" class="text-sm text-muted-foreground">75%</span>
          </div>
          <%= render Shadcn::SliderComponent.new(
            value: 75,
            max: 100,
            data: { "output-target": "volume-label", "output-format": "{value}%" }
          ) %>
        </div>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/slider/with-synced-label.txt")) %>
    </div>

    <!-- Two-Way Input Binding -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Two-Way Input Binding</h3>
      <p class="text-sm text-muted-foreground">Use <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">data-input-target</code> to bind a slider to a number input for two-way sync. Changes to either element update the other.</p>
      <%= render "docs/demo_card" do %>
        <div class="space-y-4 w-full max-w-md">
          <div class="flex items-center justify-between gap-4">
            <%= render Shadcn::LabelComponent.new(for: "brightness-input") { "Brightness" } %>
            <%= render Shadcn::InputComponent.new(
              id: "brightness-input",
              type: "number",
              value: 75,
              min: 0,
              max: 100,
              class_name: "w-20 text-center"
            ) %>
          </div>
          <%= render Shadcn::SliderComponent.new(
            value: 75,
            max: 100,
            data: {
              "input-target": "brightness-input"
            }
          ) %>
          <p class="text-xs text-muted-foreground">
            Change the slider or type a value in the input - both stay in sync.
          </p>
        </div>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/slider/two-way-input-binding.txt")) %>
    </div>

    <!-- Custom Range -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Custom Range</h3>
      <p class="text-sm text-muted-foreground">Use <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">min</code> and <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">max</code> to set a custom range.</p>
      <%= render "docs/demo_card" do %>
        <div class="space-y-4 w-full max-w-md">
          <div class="flex justify-between">
            <%= render Shadcn::LabelComponent.new { "Temperature" } %>
            <span id="temp-label" class="text-sm text-muted-foreground">20°C</span>
          </div>
          <%= render Shadcn::SliderComponent.new(value: 20, min: 10, max: 30, data: { "output-target": "temp-label", "output-format": "{value}°C" }) %>
          <div class="flex justify-between text-xs text-muted-foreground">
            <span>10°C</span>
            <span>30°C</span>
          </div>
        </div>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/slider/custom-range.txt")) %>
    </div>

    <!-- With Steps -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">With Steps</h3>
      <p class="text-sm text-muted-foreground">Use <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">step</code> to set discrete intervals.</p>
      <%= render "docs/demo_card" do %>
        <div class="space-y-4 w-full max-w-md">
          <div class="flex justify-between">
            <%= render Shadcn::LabelComponent.new { "Rating" } %>
            <span id="rating-label" class="text-sm text-muted-foreground">3 stars</span>
          </div>
          <%= render Shadcn::SliderComponent.new(value: 3, min: 1, max: 5, step: 1, data: { "output-target": "rating-label", "output-format": "{value} stars" }) %>
          <div class="flex justify-between text-xs text-muted-foreground">
            <span>1</span>
            <span>2</span>
            <span>3</span>
            <span>4</span>
            <span>5</span>
          </div>
        </div>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/slider/with-steps.txt")) %>
    </div>

    <!-- Decimal Steps -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Decimal Steps</h3>
      <p class="text-sm text-muted-foreground">Use decimal values for <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">step</code> for fine-grained control.</p>
      <%= render "docs/demo_card" do %>
        <div class="space-y-4 w-full max-w-md">
          <div class="flex justify-between">
            <%= render Shadcn::LabelComponent.new { "Opacity" } %>
            <span id="opacity-label" class="text-sm text-muted-foreground">0.5</span>
          </div>
          <%= render Shadcn::SliderComponent.new(value: 0.5, min: 0, max: 1, step: 0.1, data: { "output-target": "opacity-label", "output-format": "{value}" }) %>
          <div class="flex justify-between text-xs text-muted-foreground">
            <span>0</span>
            <span>0.5</span>
            <span>1</span>
          </div>
        </div>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/slider/decimal-steps.txt")) %>
    </div>

    <!-- Disabled -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Disabled</h3>
      <%= render "docs/demo_card" do %>
        <div class="space-y-4 w-full max-w-md">
          <%= render Shadcn::LabelComponent.new { "Disabled Slider" } %>
          <%= render Shadcn::SliderComponent.new(value: 50, disabled: true) %>
        </div>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/slider/disabled.txt")) %>
    </div>

    <!-- In a Form -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">In a Form</h3>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::CardComponent.new(class_name: "w-full max-w-md") do |card| %>
          <% card.with_header do |header| %>
            <% header.with_title { "Audio Settings" } %>
            <% header.with_description { "Adjust your audio preferences." } %>
          <% end %>
          <% card.with_content do %>
            <div class="space-y-6">
              <div class="space-y-2">
                <div class="flex justify-between">
                  <%= render Shadcn::LabelComponent.new { "Master Volume" } %>
                  <span id="master-vol-label" class="text-sm text-muted-foreground">80%</span>
                </div>
                <%= render Shadcn::SliderComponent.new(name: "master_volume", value: 80, data: { "output-target": "master-vol-label", "output-format": "{value}%" }) %>
              </div>
              <div class="space-y-2">
                <div class="flex justify-between">
                  <%= render Shadcn::LabelComponent.new { "Music" } %>
                  <span id="music-vol-label" class="text-sm text-muted-foreground">60%</span>
                </div>
                <%= render Shadcn::SliderComponent.new(name: "music_volume", value: 60, data: { "output-target": "music-vol-label", "output-format": "{value}%" }) %>
              </div>
              <div class="space-y-2">
                <div class="flex justify-between">
                  <%= render Shadcn::LabelComponent.new { "Sound Effects" } %>
                  <span id="sfx-vol-label" class="text-sm text-muted-foreground">90%</span>
                </div>
                <%= render Shadcn::SliderComponent.new(name: "sfx_volume", value: 90, data: { "output-target": "sfx-vol-label", "output-format": "{value}%" }) %>
              </div>
            </div>
          <% end %>
          <% card.with_footer do %>
            <%= render Shadcn::ButtonComponent.new { "Save Settings" } %>
          <% end %>
        <% end %>
      <% end %>
      <%= render "docs/code_example", language: "erb", code: File.read(Rails.root.join("app/code_examples/slider/in-a-form.txt")) %>
    </div>
  </div>

    <!-- Rating -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Rating</h3>
      <%= showcase("slider", :rating) %>
    </div>

    <!-- Volume Control -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Volume Control</h3>
      <%= showcase("slider", :volume) %>
    </div>

    <!-- Temperature -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Temperature</h3>
      <%= showcase("slider", :temperature) %>
    </div>

    <!-- With Label -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">With Label</h3>
      <%= showcase("slider", :with_label) %>
    </div>

  <!-- API Reference -->
  <div id="api-reference">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight mb-4">API Reference</h2>
    <%= render "docs/props_table", props: [
      { name: "name", type: "String", default: "nil", description: "Input name for form submission" },
      { name: "value", type: "Numeric", default: "0", description: "Current slider value" },
      { name: "min", type: "Numeric", default: "0", description: "Minimum value" },
      { name: "max", type: "Numeric", default: "100", description: "Maximum value" },
      { name: "step", type: "Numeric", default: "1", description: "Step increment" },
      { name: "disabled", type: "Boolean", default: "false", description: "Whether the slider is disabled" },
      { name: "class_name", type: "String", default: "nil", description: "Additional CSS classes to apply" }
    ] %>
  </div>

  <!-- Stimulus Controller -->
  <%= render "docs/stimulus_docs",
    controller_name: "shadcn--slider",
    description: "Updates the slider's visual fill and supports one-way output sync and two-way input binding.",
    values: [
      { name: "outputFormat", type: "String", default: '"{value}"', description: "Format string for output ({value} and {percent} placeholders)" }
    ],
    targets: [
      { name: "output", description: "Element to display the current value (auto-synced on change)" }
    ],
    actions: [
      { name: "updateStyle", description: "Updates CSS fill, syncs output target, and updates linked input on change" }
    ]
  %>

  <!-- Data Attributes -->
  <div class="space-y-4 mt-8">
    <h3 class="text-lg font-semibold">Data Attributes</h3>
    <p class="text-sm text-muted-foreground">These attributes can be added to the slider's native <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">&lt;input type="range"&gt;</code> element:</p>
    <%= render "docs/props_table", props: [
      { name: "data-output-target", type: "String", default: "nil", description: "ID of element to display value (one-way: slider → output)" },
      { name: "data-output-format", type: "String", default: "{value}", description: "Format string with {value} and {percent} placeholders" },
      { name: "data-input-target", type: "String", default: "nil", description: "ID of input element for two-way binding (slider ↔ input)" }
    ] %>
  </div>

  <!-- Accessibility -->
  <div class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Accessibility</h2>
    <ul class="ml-6 list-disc space-y-2 [&>li]:mt-2">
      <li>Uses native <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">&lt;input type="range"&gt;</code> for built-in accessibility</li>
      <li>Keyboard navigation: Arrow keys to adjust value</li>
      <li>Always pair with a visible label or <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">aria-label</code></li>
      <li>Consider showing the current value for screen readers</li>
    </ul>
  </div>
</div>
