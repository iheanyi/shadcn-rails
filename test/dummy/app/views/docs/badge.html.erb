<% content_for :title, "Badge" %>

<% content_for :toc do %>
  <div class="flex flex-col space-y-2 text-sm">
    <a href="#installation" class="text-muted-foreground hover:text-foreground">Installation</a>
    <a href="#usage" class="text-muted-foreground hover:text-foreground">Usage</a>
    <a href="#examples" class="text-muted-foreground hover:text-foreground">Examples</a>
    <a href="#api-reference" class="text-muted-foreground hover:text-foreground">API Reference</a>
  </div>
<% end %>

<div class="space-y-8">
  <!-- Header -->
  <div class="space-y-2">
    <h1 class="scroll-m-20 text-4xl font-bold tracking-tight">Badge</h1>
    <p class="text-xl text-muted-foreground">Displays a badge or a component that looks like a badge.</p>
    <div class="flex items-center gap-2 mt-4">
      <span class="inline-flex items-center rounded-md bg-green-50 dark:bg-green-950 px-2 py-1 text-xs font-medium text-green-700 dark:text-green-300 ring-1 ring-inset ring-green-700/10 dark:ring-green-300/10">
        No JavaScript Required
      </span>
    </div>
  </div>

  <!-- Preview -->
  <%= render "docs/demo_card" do %>
    <%= render Shadcn::BadgeComponent.new { "Badge" } %>
  <% end %>

  <!-- Installation -->
  <div id="installation" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Installation</h2>
    <p class="leading-7">Add the component to your project:</p>
    <%= render "docs/code_example", language: "bash", code: "rails generate shadcn:component badge" %>
  </div>

  <!-- Usage -->
  <div id="usage" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Usage</h2>
    <%= erb_example("badge/usage") %>
  </div>

  <!-- Examples -->
  <div id="examples" class="space-y-8">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Examples</h2>

    <!-- Default -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Default</h3>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::BadgeComponent.new { "Default" } %>
      <% end %>
    </div>

    <!-- Secondary -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Secondary</h3>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::BadgeComponent.new(variant: :secondary) { "Secondary" } %>
      <% end %>
      <%= erb_example("badge/secondary") %>
    </div>

    <!-- Destructive -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Destructive</h3>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::BadgeComponent.new(variant: :destructive) { "Destructive" } %>
      <% end %>
      <%= erb_example("badge/destructive") %>
    </div>

    <!-- Outline -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Outline</h3>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::BadgeComponent.new(variant: :outline) { "Outline" } %>
      <% end %>
      <%= erb_example("badge/outline") %>
    </div>

    <!-- All Variants -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">All Variants</h3>
      <%= render "docs/demo_card" do %>
        <div class="flex flex-wrap gap-2">
          <%= render Shadcn::BadgeComponent.new { "Default" } %>
          <%= render Shadcn::BadgeComponent.new(variant: :secondary) { "Secondary" } %>
          <%= render Shadcn::BadgeComponent.new(variant: :destructive) { "Destructive" } %>
          <%= render Shadcn::BadgeComponent.new(variant: :outline) { "Outline" } %>
        </div>
      <% end %>
    </div>

    <!-- Use Cases -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Common Use Cases</h3>
      <%= render "docs/demo_card" do %>
        <div class="flex flex-wrap gap-4">
          <div class="flex items-center gap-2">
            <span class="text-sm font-medium">Status:</span>
            <%= render Shadcn::BadgeComponent.new { "Active" } %>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-sm font-medium">Version:</span>
            <%= render Shadcn::BadgeComponent.new(variant: :outline) { "v2.0.0" } %>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-sm font-medium">Draft:</span>
            <%= render Shadcn::BadgeComponent.new(variant: :secondary) { "Draft" } %>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-sm font-medium">Error:</span>
            <%= render Shadcn::BadgeComponent.new(variant: :destructive) { "Failed" } %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- API Reference -->
  <div id="api-reference">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight mb-4">API Reference</h2>
    <%= render "docs/props_table", props: [
      { name: "variant", type: "Symbol", default: ":default", description: "Badge style variant (:default, :secondary, :destructive, :outline)" },
      { name: "class_name", type: "String", default: "nil", description: "Additional CSS classes to apply" }
    ] %>
  </div>

  <!-- Accessibility -->
  <div class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Accessibility</h2>
    <ul class="ml-6 list-disc space-y-2 [&>li]:mt-2">
      <li>Badges are purely visual and don't convey semantic meaning to screen readers</li>
      <li>If badges represent important status information, ensure the context provides that information in an accessible way</li>
      <li>Consider using <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">aria-label</code> or visually hidden text for important statuses</li>
    </ul>
  </div>
</div>
