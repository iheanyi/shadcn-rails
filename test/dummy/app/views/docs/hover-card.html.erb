<% content_for :title, "Hover Card" %>

<% content_for :toc do %>
  <div class="flex flex-col space-y-2 text-sm">
    <a href="#installation" class="text-muted-foreground hover:text-foreground">Installation</a>
    <a href="#usage" class="text-muted-foreground hover:text-foreground">Usage</a>
    <a href="#examples" class="text-muted-foreground hover:text-foreground">Examples</a>
    <a href="#api-reference" class="text-muted-foreground hover:text-foreground">API Reference</a>
    <a href="#stimulus-controller" class="text-muted-foreground hover:text-foreground">Stimulus Controller</a>
    <a href="#accessibility" class="text-muted-foreground hover:text-foreground">Accessibility</a>
  </div>
<% end %>

<div class="space-y-8">
  <!-- Header -->
  <div class="space-y-2">
    <h1 class="scroll-m-20 text-4xl font-bold tracking-tight">Hover Card</h1>
    <p class="text-xl text-muted-foreground">For sighted users to preview content available behind a link.</p>
    <div class="flex items-center gap-2 mt-4">
      <span class="inline-flex items-center rounded-md bg-blue-50 dark:bg-blue-950 px-2 py-1 text-xs font-medium text-blue-700 dark:text-blue-300 ring-1 ring-inset ring-blue-700/10 dark:ring-blue-300/10">
        Requires JavaScript
      </span>
    </div>
  </div>

  <!-- Preview -->
  <%= render "docs/demo_card" do %>
    <%= render Shadcn::HoverCardComponent.new do |card| %>
      <% card.with_trigger do %>
        <a href="#" class="underline">@nextjs</a>
      <% end %>
      <% card.with_card_content do %>
        <div class="flex justify-between space-x-4">
          <%= render Shadcn::AvatarComponent.new do |avatar| %>
            <% avatar.with_image(src: "https://github.com/vercel.png", alt: "@nextjs") %>
            <% avatar.with_fallback { "VR" } %>
          <% end %>
          <div class="space-y-1">
            <h4 class="text-sm font-semibold">@nextjs</h4>
            <p class="text-sm">The React Framework - created and maintained by @vercel.</p>
            <div class="flex items-center pt-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 opacity-70" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
              </svg>
              <span class="text-xs text-muted-foreground">Joined December 2021</span>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <!-- Installation -->
  <div id="installation" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Installation</h2>
    <p class="leading-7">Add the component to your project:</p>
    <%= render "docs/code_example", language: "bash", code: "rails generate shadcn:component hover_card" %>
  </div>

  <!-- Usage -->
  <div id="usage" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Usage</h2>
    <%= erb_example("hover_card/usage") %>
  </div>

  <!-- Examples -->
  <div id="examples" class="space-y-8">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Examples</h2>

    <!-- Basic Hover Card -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Basic</h3>
      <p class="text-sm text-muted-foreground">A simple hover card with text content.</p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::HoverCardComponent.new do |card| %>
          <% card.with_trigger do %>
            <span class="underline cursor-pointer">Hover over me</span>
          <% end %>
          <% card.with_card_content do %>
            <p class="text-sm">This is the hover card content.</p>
          <% end %>
        <% end %>
      <% end %>
      <%= erb_example("hover_card/basic") %>
    </div>

    <!-- User Profile Preview -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">User Profile Preview</h3>
      <p class="text-sm text-muted-foreground">Display user information on hover, commonly used for social media style mentions.</p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::HoverCardComponent.new do |card| %>
          <% card.with_trigger do %>
            <a href="#" class="underline">@nextjs</a>
          <% end %>
          <% card.with_card_content do %>
            <div class="flex justify-between space-x-4">
              <%= render Shadcn::AvatarComponent.new do |avatar| %>
                <% avatar.with_image(src: "https://github.com/vercel.png", alt: "@nextjs") %>
                <% avatar.with_fallback { "VR" } %>
              <% end %>
              <div class="space-y-1">
                <h4 class="text-sm font-semibold">@nextjs</h4>
                <p class="text-sm">The React Framework - created and maintained by @vercel.</p>
                <div class="flex items-center pt-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 opacity-70" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
                  </svg>
                  <span class="text-xs text-muted-foreground">Joined December 2021</span>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      <% end %>
      <%= erb_example("hover_card/user_profile") %>
    </div>

    <!-- Link Preview -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Link Preview</h3>
      <p class="text-sm text-muted-foreground">Show a preview of external links on hover.</p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::HoverCardComponent.new do |card| %>
          <% card.with_trigger do %>
            <a href="https://github.com/rails/rails" class="text-primary hover:underline">
              Ruby on Rails
            </a>
          <% end %>
          <% card.with_card_content do %>
            <div class="space-y-2">
              <h4 class="text-sm font-semibold">Ruby on Rails</h4>
              <p class="text-sm text-muted-foreground">
                A web-application framework that includes everything needed to create
                database-backed web applications according to the Model-View-Controller (MVC) pattern.
              </p>
              <div class="flex items-center pt-2">
                <span class="text-xs text-muted-foreground">github.com/rails/rails</span>
              </div>
            </div>
          <% end %>
        <% end %>
      <% end %>
      <%= erb_example("hover_card/link_preview") %>
    </div>

    <!-- Custom Delays -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Custom Delays</h3>
      <p class="text-sm text-muted-foreground">
        Customize the delay before the card opens and closes. Useful for adjusting the hover sensitivity.
      </p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::HoverCardComponent.new(open_delay: 200, close_delay: 100) do |card| %>
          <% card.with_trigger do %>
            <span class="underline cursor-pointer">Quick hover (200ms open, 100ms close)</span>
          <% end %>
          <% card.with_card_content do %>
            <p class="text-sm">This card appears faster and closes quicker.</p>
          <% end %>
        <% end %>
      <% end %>
      <%= erb_example("hover_card/custom_delay") %>
    </div>

    <!-- Positioning -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Positioning</h3>
      <p class="text-sm text-muted-foreground">
        Control where the hover card appears relative to the trigger using the <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">side</code> and <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">align</code> options.
      </p>
      <%= render "docs/demo_card" do %>
        <div class="flex gap-4 flex-wrap">
          <%= render Shadcn::HoverCardComponent.new do |card| %>
            <% card.with_trigger do %>
              <%= render Shadcn::ButtonComponent.new(variant: :outline) { "Top" } %>
            <% end %>
            <% card.with_card_content(side: :top) do %>
              <p class="text-sm">Appears on top</p>
            <% end %>
          <% end %>

          <%= render Shadcn::HoverCardComponent.new do |card| %>
            <% card.with_trigger do %>
              <%= render Shadcn::ButtonComponent.new(variant: :outline) { "Right" } %>
            <% end %>
            <% card.with_card_content(side: :right) do %>
              <p class="text-sm">Appears on right</p>
            <% end %>
          <% end %>

          <%= render Shadcn::HoverCardComponent.new do |card| %>
            <% card.with_trigger do %>
              <%= render Shadcn::ButtonComponent.new(variant: :outline) { "Bottom" } %>
            <% end %>
            <% card.with_card_content(side: :bottom) do %>
              <p class="text-sm">Appears on bottom</p>
            <% end %>
          <% end %>

          <%= render Shadcn::HoverCardComponent.new do |card| %>
            <% card.with_trigger do %>
              <%= render Shadcn::ButtonComponent.new(variant: :outline) { "Left" } %>
            <% end %>
            <% card.with_card_content(side: :left) do %>
              <p class="text-sm">Appears on left</p>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <%= erb_example("hover_card/positioning") %>
    </div>
  </div>

  <!-- API Reference -->
  <div id="api-reference">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight mb-4">API Reference</h2>

    <h3 class="text-lg font-semibold mt-6 mb-3">HoverCardComponent</h3>
    <%= render "docs/props_table", title: nil, props: [
      { name: "open_delay", type: "Integer", default: "700", description: "Delay in milliseconds before the card opens on hover" },
      { name: "close_delay", type: "Integer", default: "300", description: "Delay in milliseconds before the card closes after mouse leaves" }
    ] %>

    <h3 class="text-lg font-semibold mt-6 mb-3">Slots</h3>
    <div class="relative w-full overflow-auto">
      <table class="w-full caption-bottom text-sm">
        <thead class="[&_tr]:border-b">
          <tr class="border-b transition-colors">
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Slot</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Props</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Description</th>
          </tr>
        </thead>
        <tbody class="[&_tr:last-child]:border-0">
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_trigger</td>
            <td class="p-4 align-middle">-</td>
            <td class="p-4 align-middle text-muted-foreground">The element that triggers the hover card (link, button, etc.)</td>
          </tr>
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_card_content</td>
            <td class="p-4 align-middle">
              <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">side:</code>,
              <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">align:</code>
            </td>
            <td class="p-4 align-middle text-muted-foreground">The content to display in the hover card</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="text-lg font-semibold mt-6 mb-3">HoverCardContentComponent</h3>
    <%= render "docs/props_table", title: nil, props: [
      { name: "side", type: "Symbol", default: ":bottom", description: "Position of the card relative to trigger: :top, :right, :bottom, :left" },
      { name: "align", type: "Symbol", default: ":center", description: "Alignment of the card: :start, :center, :end" }
    ] %>
  </div>

  <!-- Stimulus Controller -->
  <div id="stimulus-controller">
    <%= render "docs/stimulus_docs",
      controller_name: "shadcn--hover-card",
      description: "Manages hover card visibility with configurable delays for opening and closing. Handles mouse and keyboard events for accessibility.",
      targets: [
        { name: "trigger", description: "The element that triggers the hover card to appear" },
        { name: "content", description: "The hover card content container" }
      ],
      values: [
        { name: "openDelay", type: "Number", default: "700", description: "Delay in milliseconds before opening" },
        { name: "closeDelay", type: "Number", default: "300", description: "Delay in milliseconds before closing" }
      ],
      actions: [
        { name: "open", description: "Opens the hover card immediately" },
        { name: "close", description: "Closes the hover card immediately" },
        { name: "scheduleOpen", description: "Schedules the card to open after openDelay" },
        { name: "scheduleClose", description: "Schedules the card to close after closeDelay" }
      ]
    %>
  </div>

  <!-- Accessibility -->
  <div id="accessibility" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Accessibility</h2>
    <ul class="ml-6 list-disc space-y-2 [&>li]:mt-2">
      <li>Uses <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">role="tooltip"</code> for proper screen reader announcement</li>
      <li>Responds to both mouse hover and keyboard focus events</li>
      <li>Content appears on hover and focus, disappears on blur and mouse leave</li>
      <li>Configurable delays prevent accidental triggers from brief mouse movements</li>
      <li>Mouse can move over the card content without it closing</li>
      <li>For sighted users only - does not provide accessible alternative for screen reader users</li>
      <li>Consider providing the same information through other means for non-sighted users</li>
    </ul>
  </div>
</div>
