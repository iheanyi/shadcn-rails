<% content_for :title, "Drawer" %>

<% content_for :toc do %>
  <div class="flex flex-col space-y-2 text-sm">
    <a href="#installation" class="text-muted-foreground hover:text-foreground">Installation</a>
    <a href="#usage" class="text-muted-foreground hover:text-foreground">Usage</a>
    <a href="#examples" class="text-muted-foreground hover:text-foreground">Examples</a>
    <a href="#api-reference" class="text-muted-foreground hover:text-foreground">API Reference</a>
    <a href="#stimulus-controller" class="text-muted-foreground hover:text-foreground">Stimulus Controller</a>
    <a href="#accessibility" class="text-muted-foreground hover:text-foreground">Accessibility</a>
  </div>
<% end %>

<div class="space-y-8">
  <!-- Header -->
  <div class="space-y-2">
    <h1 class="scroll-m-20 text-4xl font-bold tracking-tight">Drawer</h1>
    <p class="text-xl text-muted-foreground">A slide-out panel that can appear from any edge of the screen. Perfect for mobile-optimized navigation, forms, and detail views.</p>
    <div class="flex items-center gap-2 mt-4">
      <span class="inline-flex items-center rounded-md bg-blue-50 dark:bg-blue-950 px-2 py-1 text-xs font-medium text-blue-700 dark:text-blue-300 ring-1 ring-inset ring-blue-700/10 dark:ring-blue-300/10">
        Requires JavaScript
      </span>
    </div>
  </div>

  <!-- Preview -->
  <%= render "docs/demo_card" do %>
    <%= render Shadcn::DrawerComponent.new do |drawer| %>
      <% drawer.with_trigger do %>
        <%= render Shadcn::ButtonComponent.new(variant: :outline) do %>Open Drawer<% end %>
      <% end %>
      <% drawer.with_body do |content| %>
        <% content.with_header do |header| %>
          <% header.with_title { "Edit Profile" } %>
          <% header.with_description { "Make changes to your profile here. Click save when you're done." } %>
        <% end %>
        <div class="p-4 space-y-4">
          <div class="space-y-2">
            <%= render Shadcn::LabelComponent.new(for: "drawer-name") { "Name" } %>
            <%= render Shadcn::InputComponent.new(id: "drawer-name", value: "John Doe") %>
          </div>
          <div class="space-y-2">
            <%= render Shadcn::LabelComponent.new(for: "drawer-username") { "Username" } %>
            <%= render Shadcn::InputComponent.new(id: "drawer-username", value: "@johndoe") %>
          </div>
        </div>
        <% content.with_footer do %>
          <%= render Shadcn::ButtonComponent.new(type: "submit", class_name: "w-full") { "Save changes" } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <!-- Installation -->
  <div id="installation" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Installation</h2>
    <p class="leading-7">Add the component to your project:</p>
    <%= render "docs/code_example", language: "bash", code: "rails generate shadcn:add drawer" %>
  </div>

  <!-- Usage -->
  <div id="usage" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Usage</h2>
    <%= erb_example("drawer/usage") %>
  </div>

  <!-- Examples -->
  <div id="examples" class="space-y-8">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Examples</h2>

    <!-- Basic Drawer -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Basic Drawer</h3>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::DrawerComponent.new do |drawer| %>
          <% drawer.with_trigger do %>
            <%= render Shadcn::ButtonComponent.new(variant: :outline) do %>Basic Drawer<% end %>
          <% end %>
          <% drawer.with_body do |content| %>
            <% content.with_header do |header| %>
              <% header.with_title { "Are you sure?" } %>
              <% header.with_description { "This action cannot be undone." } %>
            <% end %>
            <% content.with_footer do %>
              <div class="flex gap-2 justify-end">
                <%= render Shadcn::ButtonComponent.new(variant: :outline, data: { action: "click->shadcn--drawer#close" }) { "Cancel" } %>
                <%= render Shadcn::ButtonComponent.new(variant: :destructive) { "Delete" } %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
      <%= erb_example("drawer/basic") %>
    </div>

    <!-- With Form -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">With Form</h3>
      <p class="text-sm text-muted-foreground">
        Drawers are perfect for forms and data entry on mobile devices.
      </p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::DrawerComponent.new do |drawer| %>
          <% drawer.with_trigger do %>
            <%= render Shadcn::ButtonComponent.new do %>Edit Profile<% end %>
          <% end %>
          <% drawer.with_body do |content| %>
            <% content.with_header do |header| %>
              <% header.with_title { "Edit Profile" } %>
              <% header.with_description { "Make changes to your profile here." } %>
            <% end %>
            <div class="p-4 space-y-4">
              <div class="space-y-2">
                <%= render Shadcn::LabelComponent.new(for: "form-name") { "Name" } %>
                <%= render Shadcn::InputComponent.new(id: "form-name", value: "John Doe") %>
              </div>
              <div class="space-y-2">
                <%= render Shadcn::LabelComponent.new(for: "form-username") { "Username" } %>
                <%= render Shadcn::InputComponent.new(id: "form-username", value: "@johndoe") %>
              </div>
            </div>
            <% content.with_footer do %>
              <%= render Shadcn::ButtonComponent.new(type: "submit", class_name: "w-full") { "Save changes" } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
      <%= erb_example("drawer/with_form") %>
    </div>

    <!-- Different Directions -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Different Directions</h3>
      <p class="text-sm text-muted-foreground">
        Drawers can slide in from any edge: bottom (default), top, left, or right.
      </p>
      <%= render "docs/demo_card" do %>
        <div class="flex flex-wrap gap-2">
          <%= render Shadcn::DrawerComponent.new(direction: :bottom) do |drawer| %>
            <% drawer.with_trigger do %>
              <%= render Shadcn::ButtonComponent.new(variant: :outline) do %>Bottom<% end %>
            <% end %>
            <% drawer.with_body(direction: :bottom) do |content| %>
              <% content.with_header do |header| %>
                <% header.with_title { "Bottom Drawer" } %>
                <% header.with_description { "Content slides in from the bottom." } %>
              <% end %>
              <div class="p-4">
                <p>Drawer content here.</p>
              </div>
            <% end %>
          <% end %>

          <%= render Shadcn::DrawerComponent.new(direction: :top) do |drawer| %>
            <% drawer.with_trigger do %>
              <%= render Shadcn::ButtonComponent.new(variant: :outline) do %>Top<% end %>
            <% end %>
            <% drawer.with_body(direction: :top) do |content| %>
              <% content.with_header do |header| %>
                <% header.with_title { "Top Drawer" } %>
                <% header.with_description { "Content slides in from the top." } %>
              <% end %>
              <div class="p-4">
                <p>Drawer content here.</p>
              </div>
            <% end %>
          <% end %>

          <%= render Shadcn::DrawerComponent.new(direction: :left) do |drawer| %>
            <% drawer.with_trigger do %>
              <%= render Shadcn::ButtonComponent.new(variant: :outline) do %>Left<% end %>
            <% end %>
            <% drawer.with_body(direction: :left) do |content| %>
              <% content.with_header do |header| %>
                <% header.with_title { "Left Drawer" } %>
                <% header.with_description { "Content slides in from the left." } %>
              <% end %>
              <div class="p-4 flex-1">
                <p>Drawer content here.</p>
              </div>
            <% end %>
          <% end %>

          <%= render Shadcn::DrawerComponent.new(direction: :right) do |drawer| %>
            <% drawer.with_trigger do %>
              <%= render Shadcn::ButtonComponent.new(variant: :outline) do %>Right<% end %>
            <% end %>
            <% drawer.with_body(direction: :right) do |content| %>
              <% content.with_header do |header| %>
                <% header.with_title { "Right Drawer" } %>
                <% header.with_description { "Content slides in from the right." } %>
              <% end %>
              <div class="p-4 flex-1">
                <p>Drawer content here.</p>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <div class="space-y-4">
        <h4 class="text-sm font-semibold">From Left</h4>
        <%= erb_example("drawer/from_left") %>

        <h4 class="text-sm font-semibold">From Right</h4>
        <%= erb_example("drawer/from_right") %>

        <h4 class="text-sm font-semibold">From Top</h4>
        <%= erb_example("drawer/from_top") %>
      </div>
    </div>

    <!-- Custom Close Button -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Custom Close Action</h3>
      <p class="text-sm text-muted-foreground">
        Use <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">data-action="click->shadcn--drawer#close"</code> on any element to close the drawer.
      </p>
    </div>
  </div>

  <!-- API Reference -->
  <div id="api-reference">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight mb-4">API Reference</h2>

    <h3 class="text-lg font-semibold mt-6 mb-3">DrawerComponent</h3>
    <%= render "docs/props_table", title: nil, props: [
      { name: "open", type: "Boolean", default: "false", description: "Whether the drawer starts in open state" },
      { name: "direction", type: "Symbol", default: ":bottom", description: "Which edge the drawer slides from (:bottom, :top, :left, :right)" }
    ] %>

    <h3 class="text-lg font-semibold mt-6 mb-3">Slots</h3>
    <div class="relative w-full overflow-auto">
      <table class="w-full caption-bottom text-sm">
        <thead class="[&_tr]:border-b">
          <tr class="border-b transition-colors">
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Slot</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Description</th>
          </tr>
        </thead>
        <tbody class="[&_tr:last-child]:border-0">
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_trigger</td>
            <td class="p-4 align-middle text-muted-foreground">The element that opens the drawer (usually a button)</td>
          </tr>
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_body</td>
            <td class="p-4 align-middle text-muted-foreground">The drawer content container (yields DrawerContentComponent)</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="text-lg font-semibold mt-6 mb-3">DrawerContentComponent Slots</h3>
    <div class="relative w-full overflow-auto">
      <table class="w-full caption-bottom text-sm">
        <thead class="[&_tr]:border-b">
          <tr class="border-b transition-colors">
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Slot</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Description</th>
          </tr>
        </thead>
        <tbody class="[&_tr:last-child]:border-0">
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_header</td>
            <td class="p-4 align-middle text-muted-foreground">Header section (yields with_title and with_description slots)</td>
          </tr>
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_title</td>
            <td class="p-4 align-middle text-muted-foreground">Drawer title text (via header)</td>
          </tr>
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_description</td>
            <td class="p-4 align-middle text-muted-foreground">Drawer description text (via header)</td>
          </tr>
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_footer</td>
            <td class="p-4 align-middle text-muted-foreground">Footer section (usually contains action buttons)</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="mt-6 rounded-lg border border-blue-200 dark:border-blue-800 bg-blue-50 dark:bg-blue-950/50 p-4">
      <p class="text-sm text-blue-900 dark:text-blue-200">
        <strong>Note:</strong> Mobile gesture support (swipe to close) is planned for a future release.
      </p>
    </div>
  </div>

  <!-- Stimulus Controller -->
  <div id="stimulus-controller">
    <%= render "docs/stimulus_docs",
      controller_name: "shadcn--drawer",
      description: "Manages drawer open/close state, portal rendering, keyboard navigation, and animations.",
      targets: [
        { name: "trigger", description: "The element that triggers the drawer to open" },
        { name: "template", description: "Template containing the drawer content (for portal rendering)" },
        { name: "overlay", description: "The backdrop overlay element" },
        { name: "content", description: "The drawer content container" }
      ],
      values: [
        { name: "open", type: "Boolean", default: "false", description: "Current open/closed state" },
        { name: "direction", type: "String", default: "bottom", description: "Which edge the drawer slides from" }
      ],
      actions: [
        { name: "open", description: "Opens the drawer" },
        { name: "close", description: "Closes the drawer" },
        { name: "toggle", description: "Toggles the drawer open/closed state" }
      ]
    %>
  </div>

  <!-- Accessibility -->
  <div class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Accessibility</h2>
    <ul class="ml-6 list-disc space-y-2 [&>li]:mt-2">
      <li>Uses <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">role="dialog"</code> for proper screen reader announcement</li>
      <li>Sets <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">aria-modal="true"</code> to indicate modal behavior</li>
      <li>Focuses the drawer content when opened</li>
      <li>Pressing <kbd class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm">Escape</kbd> closes the drawer</li>
      <li>Prevents body scroll when drawer is open</li>
      <li>Handle bar is shown for bottom/top drawers to indicate draggable behavior (visual only)</li>
      <li>Clicking the overlay backdrop closes the drawer</li>
    </ul>
  </div>
</div>
