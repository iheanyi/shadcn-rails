<% content_for :title, "Context Menu" %>

<% content_for :toc do %>
  <div class="flex flex-col space-y-2 text-sm">
    <a href="#installation" class="text-muted-foreground hover:text-foreground">Installation</a>
    <a href="#usage" class="text-muted-foreground hover:text-foreground">Usage</a>
    <a href="#examples" class="text-muted-foreground hover:text-foreground">Examples</a>
    <a href="#api-reference" class="text-muted-foreground hover:text-foreground">API Reference</a>
    <a href="#stimulus-controller" class="text-muted-foreground hover:text-foreground">Stimulus Controller</a>
    <a href="#accessibility" class="text-muted-foreground hover:text-foreground">Accessibility</a>
  </div>
<% end %>

<div class="space-y-8">
  <!-- Header -->
  <div class="space-y-2">
    <h1 class="scroll-m-20 text-4xl font-bold tracking-tight">Context Menu</h1>
    <p class="text-xl text-muted-foreground">Displays a menu to the user triggered by a right-click with a list of actions or functions.</p>
    <div class="flex items-center gap-2 mt-4">
      <span class="inline-flex items-center rounded-md bg-blue-50 dark:bg-blue-950 px-2 py-1 text-xs font-medium text-blue-700 dark:text-blue-300 ring-1 ring-inset ring-blue-700/10 dark:ring-blue-300/10">
        Requires JavaScript
      </span>
    </div>
  </div>

  <!-- Preview -->
  <%= render "docs/demo_card" do %>
    <%= render Shadcn::ContextMenuComponent.new do |menu| %>
      <% menu.with_trigger do %>
        <div class="flex h-[150px] w-[300px] items-center justify-center rounded-md border border-dashed text-sm">
          Right click here
        </div>
      <% end %>
      <% menu.with_menu do |content| %>
        <% content.with_label { "Actions" } %>
        <% content.with_separator %>
        <% content.with_item(href: "#") do |item| %>
          Back
          <% item.with_shortcut { "⌘[" } %>
        <% end %>
        <% content.with_item(href: "#", disabled: true) do |item| %>
          Forward
          <% item.with_shortcut { "⌘]" } %>
        <% end %>
        <% content.with_item(href: "#") do |item| %>
          Reload
          <% item.with_shortcut { "⌘R" } %>
        <% end %>
        <% content.with_separator %>
        <% content.with_item(href: "#") do |item| %>
          Save As...
          <% item.with_shortcut { "⇧⌘S" } %>
        <% end %>
        <% content.with_item(href: "#") { "Print" } %>
      <% end %>
    <% end %>
  <% end %>

  <!-- Installation -->
  <div id="installation" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Installation</h2>
    <p class="leading-7">Add the component to your project:</p>
    <%= render "docs/code_example", language: "bash", code: "rails generate shadcn:component context_menu" %>
  </div>

  <!-- Usage -->
  <div id="usage" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Usage</h2>
    <%= erb_example("context_menu/usage") %>
  </div>

  <!-- Examples -->
  <div id="examples" class="space-y-8">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Examples</h2>

    <!-- Basic -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Basic</h3>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::ContextMenuComponent.new do |menu| %>
          <% menu.with_trigger do %>
            <div class="flex h-[100px] w-[200px] items-center justify-center rounded-md border border-dashed text-sm">
              Right click
            </div>
          <% end %>
          <% menu.with_menu do |content| %>
            <% content.with_item(href: "#") { "Edit" } %>
            <% content.with_item(href: "#") { "Duplicate" } %>
            <% content.with_item(href: "#") { "Archive" } %>
          <% end %>
        <% end %>
      <% end %>
      <%= erb_example("context_menu/basic") %>
    </div>

    <!-- With Icons -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">With Icons</h3>
      <p class="text-sm text-muted-foreground">Add icons to menu items for better visual clarity.</p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::ContextMenuComponent.new do |menu| %>
          <% menu.with_trigger do %>
            <div class="flex h-[100px] w-[200px] items-center justify-center rounded-md border border-dashed text-sm">
              Right click
            </div>
          <% end %>
          <% menu.with_menu do |content| %>
            <% content.with_item(href: "#") do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
              Edit
            <% end %>
            <% content.with_item(href: "#") do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
              Copy
            <% end %>
            <% content.with_item(href: "#") do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
              Delete
            <% end %>
          <% end %>
        <% end %>
      <% end %>
      <%= erb_example("context_menu/with_icons") %>
    </div>

    <!-- With Separators and Labels -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">With Separators and Labels</h3>
      <p class="text-sm text-muted-foreground">Use separators and labels to organize menu items into logical groups.</p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::ContextMenuComponent.new do |menu| %>
          <% menu.with_trigger do %>
            <div class="flex h-[100px] w-[200px] items-center justify-center rounded-md border border-dashed text-sm">
              Right click
            </div>
          <% end %>
          <% menu.with_menu do |content| %>
            <% content.with_label { "Edit" } %>
            <% content.with_separator %>
            <% content.with_item(href: "#") { "Cut" } %>
            <% content.with_item(href: "#") { "Copy" } %>
            <% content.with_item(href: "#") { "Paste" } %>
            <% content.with_separator %>
            <% content.with_label { "View" } %>
            <% content.with_separator %>
            <% content.with_item(href: "#") { "Zoom In" } %>
            <% content.with_item(href: "#") { "Zoom Out" } %>
          <% end %>
        <% end %>
      <% end %>
      <%= erb_example("context_menu/with_separators") %>
    </div>

    <!-- With Keyboard Shortcuts -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">With Keyboard Shortcuts</h3>
      <p class="text-sm text-muted-foreground">Display keyboard shortcuts to help users discover shortcuts.</p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::ContextMenuComponent.new do |menu| %>
          <% menu.with_trigger do %>
            <div class="flex h-[100px] w-[200px] items-center justify-center rounded-md border border-dashed text-sm">
              Right click
            </div>
          <% end %>
          <% menu.with_menu do |content| %>
            <% content.with_item(href: "#") do |item| %>
              Cut
              <% item.with_shortcut { "⌘X" } %>
            <% end %>
            <% content.with_item(href: "#") do |item| %>
              Copy
              <% item.with_shortcut { "⌘C" } %>
            <% end %>
            <% content.with_item(href: "#") do |item| %>
              Paste
              <% item.with_shortcut { "⌘V" } %>
            <% end %>
            <% content.with_separator %>
            <% content.with_item(href: "#") do |item| %>
              Select All
              <% item.with_shortcut { "⌘A" } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
      <%= erb_example("context_menu/with_shortcuts") %>
    </div>

    <!-- Destructive Items -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Destructive Items</h3>
      <p class="text-sm text-muted-foreground">Use the destructive variant for dangerous actions.</p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::ContextMenuComponent.new do |menu| %>
          <% menu.with_trigger do %>
            <div class="flex h-[100px] w-[200px] items-center justify-center rounded-md border border-dashed text-sm">
              Right click
            </div>
          <% end %>
          <% menu.with_menu do |content| %>
            <% content.with_item(href: "#") { "View Details" } %>
            <% content.with_item(href: "#") { "Edit" } %>
            <% content.with_separator %>
            <% content.with_item(variant: :destructive, href: "#") { "Delete" } %>
          <% end %>
        <% end %>
      <% end %>
      <%= erb_example("context_menu/destructive") %>
    </div>

    <!-- Disabled Items -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Disabled Items</h3>
      <p class="text-sm text-muted-foreground">Disable menu items when an action is unavailable.</p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::ContextMenuComponent.new do |menu| %>
          <% menu.with_trigger do %>
            <div class="flex h-[100px] w-[200px] items-center justify-center rounded-md border border-dashed text-sm">
              Right click
            </div>
          <% end %>
          <% menu.with_menu do |content| %>
            <% content.with_item(href: "#") { "Copy" } %>
            <% content.with_item(href: "#", disabled: true) { "Paste (clipboard empty)" } %>
            <% content.with_item(href: "#") { "Select All" } %>
          <% end %>
        <% end %>
      <% end %>
      <%= erb_example("context_menu/disabled") %>
    </div>

    <!-- With Checkbox Items -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">With Checkbox Items</h3>
      <p class="text-sm text-muted-foreground">Use checkbox items for toggleable options within the context menu.</p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::ContextMenuComponent.new do |menu| %>
          <% menu.with_trigger do %>
            <div class="flex h-[100px] w-[200px] items-center justify-center rounded-md border border-dashed text-sm">
              Right click
            </div>
          <% end %>
          <% menu.with_menu do |content| %>
            <% content.with_label { "View Options" } %>
            <% content.with_separator %>
            <% content.with_checkbox_item(checked: true) do |item| %>
              Show Toolbar
              <% item.with_shortcut { "⌘T" } %>
            <% end %>
            <% content.with_checkbox_item(checked: true) { "Show Sidebar" } %>
            <% content.with_checkbox_item(checked: false) { "Show Status Bar" } %>
            <% content.with_separator %>
            <% content.with_checkbox_item(checked: false) { "Full Screen" } %>
          <% end %>
        <% end %>
      <% end %>
      <%= erb_example("context_menu/checkbox_items") %>
    </div>

    <!-- With Radio Items -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">With Radio Items</h3>
      <p class="text-sm text-muted-foreground">Use radio groups for mutually exclusive options.</p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::ContextMenuComponent.new do |menu| %>
          <% menu.with_trigger do %>
            <div class="flex h-[100px] w-[200px] items-center justify-center rounded-md border border-dashed text-sm">
              Right click
            </div>
          <% end %>
          <% menu.with_menu do |content| %>
            <% content.with_label { "People" } %>
            <% content.with_separator %>
            <% content.with_radio_group(value: "pedro") do |group| %>
              <% group.with_item(value: "pedro", checked: true) { "Pedro Duarte" } %>
              <% group.with_item(value: "colm") { "Colm Tuite" } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
      <%= erb_example("context_menu/radio_items") %>
    </div>
  </div>

  <!-- API Reference -->
  <div id="api-reference">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight mb-4">API Reference</h2>

    <h3 class="text-lg font-semibold mt-6 mb-3">ContextMenuComponent</h3>
    <p class="text-sm text-muted-foreground mb-4">The main context menu wrapper component. Triggered by right-clicking on the trigger area.</p>

    <h3 class="text-lg font-semibold mt-6 mb-3">Slots</h3>
    <div class="relative w-full overflow-auto">
      <table class="w-full caption-bottom text-sm">
        <thead class="[&_tr]:border-b">
          <tr class="border-b transition-colors">
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Slot</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Description</th>
          </tr>
        </thead>
        <tbody class="[&_tr:last-child]:border-0">
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_trigger</td>
            <td class="p-4 align-middle text-muted-foreground">The area that responds to right-clicks</td>
          </tr>
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_menu</td>
            <td class="p-4 align-middle text-muted-foreground">The context menu content container (yields ContextMenuContentComponent)</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="text-lg font-semibold mt-6 mb-3">ContextMenuContentComponent Slots</h3>
    <div class="relative w-full overflow-auto">
      <table class="w-full caption-bottom text-sm">
        <thead class="[&_tr]:border-b">
          <tr class="border-b transition-colors">
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Slot</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Props</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Description</th>
          </tr>
        </thead>
        <tbody class="[&_tr:last-child]:border-0">
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_item</td>
            <td class="p-4 align-middle"><code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">href:</code>, <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">variant:</code>, <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">disabled:</code>, <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">inset:</code></td>
            <td class="p-4 align-middle text-muted-foreground">Menu item (can be a link or div)</td>
          </tr>
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_checkbox_item</td>
            <td class="p-4 align-middle"><code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">checked:</code>, <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">disabled:</code></td>
            <td class="p-4 align-middle text-muted-foreground">Toggleable checkbox menu item</td>
          </tr>
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_radio_group</td>
            <td class="p-4 align-middle"><code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">value:</code></td>
            <td class="p-4 align-middle text-muted-foreground">Group of mutually exclusive radio items</td>
          </tr>
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_label</td>
            <td class="p-4 align-middle"><code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">inset:</code></td>
            <td class="p-4 align-middle text-muted-foreground">Section label for grouping items</td>
          </tr>
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_separator</td>
            <td class="p-4 align-middle">-</td>
            <td class="p-4 align-middle text-muted-foreground">Visual separator between menu sections</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="text-lg font-semibold mt-6 mb-3">ContextMenuItemComponent</h3>
    <%= render "docs/props_table", title: nil, props: [
      { name: "href", type: "String", default: "nil", description: "Link URL (renders as <a> if provided, <div> otherwise)" },
      { name: "variant", type: "Symbol", default: ":default", description: "Item variant (:default, :destructive)" },
      { name: "disabled", type: "Boolean", default: "false", description: "Whether the item is disabled" },
      { name: "inset", type: "Boolean", default: "false", description: "Whether to add left padding for icon alignment" }
    ] %>

    <h3 class="text-lg font-semibold mt-6 mb-3">ContextMenuItemComponent Slots</h3>
    <div class="relative w-full overflow-auto">
      <table class="w-full caption-bottom text-sm">
        <thead class="[&_tr]:border-b">
          <tr class="border-b transition-colors">
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Slot</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Description</th>
          </tr>
        </thead>
        <tbody class="[&_tr:last-child]:border-0">
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle font-mono text-sm">with_shortcut</td>
            <td class="p-4 align-middle text-muted-foreground">Keyboard shortcut hint displayed on the right</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Stimulus Controller -->
  <div id="stimulus-controller">
    <%= render "docs/stimulus_docs",
      controller_name: "shadcn--context-menu",
      description: "Manages context menu open/close state, positioning at mouse cursor, keyboard navigation, and item selection.",
      targets: [
        { name: "trigger", description: "The area that responds to right-click events" },
        { name: "content", description: "The context menu content container" },
        { name: "item", description: "Individual menu items for keyboard navigation" }
      ],
      values: [
        { name: "open", type: "Boolean", default: "false", description: "Current open/closed state" }
      ],
      actions: [
        { name: "show", description: "Opens the context menu at mouse position" },
        { name: "hide", description: "Closes the context menu" },
        { name: "close", description: "Alias for hide" },
        { name: "selectItem", description: "Handles item selection and closes menu" }
      ]
    %>
  </div>

  <!-- Implementing Keyboard Shortcuts -->
  <div id="keyboard-shortcuts" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Implementing Keyboard Shortcuts</h2>
    <div class="rounded-md bg-muted/50 p-4">
      <p class="text-sm text-muted-foreground">
        <strong>Note:</strong> The keyboard shortcuts displayed in context menu items (via <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">with_shortcut</code>) are <strong>visual hints only</strong>.
        They do not automatically execute when the keys are pressed. This matches the behavior of shadcn/ui's Context Menu.
      </p>
    </div>
    <p class="leading-7">
      To implement actual keyboard shortcuts, you'll need to add a global keydown listener. Here's an example using a Stimulus controller:
    </p>
    <%= render "docs/code_example", language: "javascript", code: %{// app/javascript/controllers/keyboard_shortcuts_controller.js
import { Controller } from "@hotwired/stimulus"

export default class extends Controller {
  connect() {
    this.boundHandleKeydown = this.handleKeydown.bind(this)
    document.addEventListener("keydown", this.boundHandleKeydown)
  }

  disconnect() {
    document.removeEventListener("keydown", this.boundHandleKeydown)
  }

  handleKeydown(event) {
    // Check for Cmd (Mac) or Ctrl (Windows/Linux)
    const modifier = event.metaKey || event.ctrlKey

    if (modifier && event.key === "z") {
      event.preventDefault()
      this.undo()
    } else if (modifier && event.key === "c") {
      event.preventDefault()
      this.copy()
    } else if (modifier && event.key === "v") {
      event.preventDefault()
      this.paste()
    }
  }

  undo() { /* implement undo logic */ }
  copy() { /* implement copy logic */ }
  paste() { /* implement paste logic */ }
}} %>
    <p class="text-sm text-muted-foreground mt-4">
      Then apply the controller to your page or application layout:
    </p>
    <%= render "docs/code_example", language: "erb", code: %{<body data-controller="keyboard-shortcuts">
  <!-- Your page content -->
</body>} %>
  </div>

  <!-- Accessibility -->
  <div id="accessibility" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Accessibility</h2>
    <ul class="ml-6 list-disc space-y-2 [&>li]:mt-2">
      <li>Uses <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">role="menu"</code> for the context menu content</li>
      <li>Sets <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">role="menuitem"</code> on each item</li>
      <li>Supports full keyboard navigation:
        <ul class="ml-6 list-disc mt-2">
          <li><kbd class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm">Escape</kbd> - Closes the menu</li>
          <li><kbd class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm">↓</kbd> / <kbd class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm">↑</kbd> - Navigate through menu items</li>
          <li><kbd class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm">Home</kbd> / <kbd class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm">End</kbd> - Jump to first/last item</li>
          <li><kbd class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm">Enter</kbd> / <kbd class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm">Space</kbd> - Select focused item</li>
        </ul>
      </li>
      <li>Disabled items use <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">data-disabled</code> attribute and are skipped in keyboard navigation</li>
      <li>Automatically closes when clicking outside the context menu</li>
      <li>Menu is positioned at mouse cursor location, adjusted to stay within viewport</li>
      <li>Focus is automatically moved to the first menu item when opened</li>
    </ul>
  </div>
</div>
