<% content_for :title, "Toggle" %>

<% content_for :toc do %>
  <div class="flex flex-col space-y-2 text-sm">
    <a href="#installation" class="text-muted-foreground hover:text-foreground">Installation</a>
    <a href="#usage" class="text-muted-foreground hover:text-foreground">Usage</a>
    <a href="#examples" class="text-muted-foreground hover:text-foreground">Examples</a>
    <a href="#api-reference" class="text-muted-foreground hover:text-foreground">API Reference</a>
  </div>
<% end %>

<div class="space-y-8">
  <!-- Header -->
  <div class="space-y-2">
    <h1 class="scroll-m-20 text-4xl font-bold tracking-tight">Toggle</h1>
    <p class="text-xl text-muted-foreground">A two-state button that can be either on or off.</p>
    <div class="flex items-center gap-2 mt-4">
      <span class="inline-flex items-center rounded-md bg-blue-50 dark:bg-blue-950 px-2 py-1 text-xs font-medium text-blue-700 dark:text-blue-300 ring-1 ring-inset ring-blue-700/10 dark:ring-blue-300/10">
        Stimulus: shadcn--toggle
      </span>
    </div>
  </div>

  <!-- Preview -->
  <%= render "docs/demo_card" do %>
    <%= render Shadcn::ToggleComponent.new(aria_label: "Toggle italic") do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" x2="10" y1="4" y2="4"/><line x1="14" x2="5" y1="20" y2="20"/><line x1="15" x2="9" y1="4" y2="20"/></svg>
    <% end %>
  <% end %>

  <!-- Installation -->
  <div id="installation" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Installation</h2>
    <p class="leading-7">Add the component to your project:</p>
    <%= render "docs/code_example", language: "bash", code: "rails generate shadcn:add toggle" %>
  </div>

  <!-- Usage -->
  <div id="usage" class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Usage</h2>
    <%= erb_example("toggle/usage") %>
  </div>

  <!-- Examples -->
  <div id="examples" class="space-y-8">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Examples</h2>

    <!-- Default -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Default</h3>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::ToggleComponent.new(aria_label: "Toggle italic") do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" x2="10" y1="4" y2="4"/><line x1="14" x2="5" y1="20" y2="20"/><line x1="15" x2="9" y1="4" y2="20"/></svg>
        <% end %>
      <% end %>
    </div>

    <!-- Outline -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Outline</h3>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::ToggleComponent.new(variant: :outline, aria_label: "Toggle italic") do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" x2="10" y1="4" y2="4"/><line x1="14" x2="5" y1="20" y2="20"/><line x1="15" x2="9" y1="4" y2="20"/></svg>
        <% end %>
      <% end %>
      <%= erb_example("toggle/outline") %>
    </div>

    <!-- With Text -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">With Text</h3>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::ToggleComponent.new(aria_label: "Toggle italic") do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><line x1="19" x2="10" y1="4" y2="4"/><line x1="14" x2="5" y1="20" y2="20"/><line x1="15" x2="9" y1="4" y2="20"/></svg>
          Italic
        <% end %>
      <% end %>
      <%= erb_example("toggle/with_text") %>
    </div>

    <!-- Sizes -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Sizes</h3>
      <%= render "docs/demo_card" do %>
        <div class="flex items-center gap-4">
          <%= render Shadcn::ToggleComponent.new(size: :sm, aria_label: "Toggle small") do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" x2="10" y1="4" y2="4"/><line x1="14" x2="5" y1="20" y2="20"/><line x1="15" x2="9" y1="4" y2="20"/></svg>
          <% end %>
          <%= render Shadcn::ToggleComponent.new(size: :default, aria_label: "Toggle default") do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" x2="10" y1="4" y2="4"/><line x1="14" x2="5" y1="20" y2="20"/><line x1="15" x2="9" y1="4" y2="20"/></svg>
          <% end %>
          <%= render Shadcn::ToggleComponent.new(size: :lg, aria_label: "Toggle large") do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" x2="10" y1="4" y2="4"/><line x1="14" x2="5" y1="20" y2="20"/><line x1="15" x2="9" y1="4" y2="20"/></svg>
          <% end %>
        </div>
      <% end %>
      <%= erb_example("toggle/sizes") %>
    </div>

    <!-- Pressed -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Pressed (Default On)</h3>
      <p class="text-sm text-muted-foreground">Set <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">pressed: true</code> to render the toggle in its "on" state.</p>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::ToggleComponent.new(pressed: true, aria_label: "Toggle pressed") do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" x2="10" y1="4" y2="4"/><line x1="14" x2="5" y1="20" y2="20"/><line x1="15" x2="9" y1="4" y2="20"/></svg>
        <% end %>
      <% end %>
      <%= erb_example("toggle/pressed") %>
    </div>

    <!-- Disabled -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold">Disabled</h3>
      <%= render "docs/demo_card" do %>
        <%= render Shadcn::ToggleComponent.new(disabled: true, aria_label: "Toggle disabled") do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" x2="10" y1="4" y2="4"/><line x1="14" x2="5" y1="20" y2="20"/><line x1="15" x2="9" y1="4" y2="20"/></svg>
        <% end %>
      <% end %>
      <%= erb_example("toggle/disabled") %>
    </div>
  </div>

  <!-- API Reference -->
  <div id="api-reference">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight mb-4">API Reference</h2>
    <%= render "docs/props_table", props: [
      { name: "variant", type: "Symbol", default: ":default", description: "Visual style variant (:default, :outline)" },
      { name: "size", type: "Symbol", default: ":default", description: "Size of the toggle (:sm, :default, :lg)" },
      { name: "pressed", type: "Boolean", default: "false", description: "Initial pressed/on state" },
      { name: "disabled", type: "Boolean", default: "false", description: "Whether the toggle is disabled" },
      { name: "aria_label", type: "String", default: "nil", description: "Accessibility label for screen readers" }
    ] %>
  </div>

  <!-- Stimulus Controller -->
  <%= render "docs/stimulus_docs",
    controller: "shadcn--toggle",
    description: "Handles toggle state changes and updates aria-pressed attribute.",
    values: [
      { name: "pressed", type: "Boolean", description: "Current pressed state" }
    ],
    actions: [
      { name: "toggle", description: "Toggles the pressed state" }
    ]
  %>

  <!-- Accessibility -->
  <div class="space-y-4">
    <h2 class="scroll-m-20 border-b pb-2 text-2xl font-semibold tracking-tight">Accessibility</h2>
    <ul class="ml-6 list-disc space-y-2 [&>li]:mt-2">
      <li>Uses <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">button</code> element with <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">type="button"</code></li>
      <li>Has <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">aria-pressed</code> attribute that reflects current state</li>
      <li>Supports <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">aria-label</code> for accessible name</li>
      <li>Uses <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">data-state</code> attribute for CSS styling ("on" or "off")</li>
      <li>Disabled state uses native <code class="rounded bg-muted px-1 py-0.5 font-mono text-sm">disabled</code> attribute</li>
    </ul>
  </div>
</div>
