<div class="max-w-4xl mx-auto space-y-12">
  <div>
    <h1 class="text-3xl font-bold">Buttons</h1>
    <p class="mt-2 text-muted-foreground">Displays a button or a component that looks like a button.</p>
  </div>

  <section class="space-y-4">
    <h2 class="text-xl font-semibold">Variants</h2>
    <div class="flex flex-wrap gap-4">
      <%= render(Shadcn::ButtonComponent.new) { "Default" } %>
      <%= render(Shadcn::ButtonComponent.new(variant: :destructive)) { "Destructive" } %>
      <%= render(Shadcn::ButtonComponent.new(variant: :outline)) { "Outline" } %>
      <%= render(Shadcn::ButtonComponent.new(variant: :secondary)) { "Secondary" } %>
      <%= render(Shadcn::ButtonComponent.new(variant: :ghost)) { "Ghost" } %>
      <%= render(Shadcn::ButtonComponent.new(variant: :link)) { "Link" } %>
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-xl font-semibold">Sizes</h2>
    <div class="flex flex-wrap items-center gap-4">
      <%= render(Shadcn::ButtonComponent.new(size: :sm)) { "Small" } %>
      <%= render(Shadcn::ButtonComponent.new) { "Default" } %>
      <%= render(Shadcn::ButtonComponent.new(size: :lg)) { "Large" } %>
      <%= render Shadcn::ButtonComponent.new(size: :icon) do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
      <% end %>
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-xl font-semibold">States</h2>
    <div class="flex flex-wrap gap-4">
      <%= render(Shadcn::ButtonComponent.new) { "Normal" } %>
      <%= render(Shadcn::ButtonComponent.new(disabled: true)) { "Disabled" } %>
      <%= render(Shadcn::ButtonComponent.new(loading: true)) { "Loading" } %>
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-xl font-semibold">With Icons</h2>
    <div class="flex flex-wrap gap-4">
      <%= render Shadcn::ButtonComponent.new do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        Login with Email
      <% end %>
      <%= render Shadcn::ButtonComponent.new(variant: :outline) do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="mr-2"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        Login with GitHub
      <% end %>
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-xl font-semibold">As Link</h2>
    <div class="flex flex-wrap gap-4">
      <%= render(Shadcn::ButtonComponent.new(href: "#", variant: :outline)) { "Link Button" } %>
      <%= render(Shadcn::ButtonComponent.new(href: "#", variant: :link)) { "Link Variant" } %>
    </div>
  </section>
</div>
