<% content_for :title, @component.titleize %>

<div class="container mx-auto px-4 py-8">
  <div class="flex flex-col gap-4">
    <div class="flex items-center gap-2 text-sm text-muted-foreground">
      <a href="/components" class="hover:text-foreground">Components</a>
      <span>/</span>
      <span><%= @component.titleize %></span>
    </div>
    <h1 class="text-3xl font-bold tracking-tight capitalize"><%= @component.titleize %></h1>
  </div>

  <div class="mt-8">
    <div class="rounded-lg border">
      <div class="border-b px-4 py-3">
        <h2 class="font-semibold">Preview</h2>
      </div>
      <div class="p-6">
        <% begin %>
          <%= render "components/#{@component}_preview" %>
        <% rescue ActionView::MissingTemplate %>
          <p class="text-muted-foreground">Preview not available for this component yet.</p>
        <% rescue => e %>
          <% if Rails.env.development? %>
            <div class="rounded-md border border-destructive bg-destructive/10 p-4">
              <p class="font-medium text-destructive"><%= e.class %>: <%= e.message %></p>
              <pre class="mt-2 text-xs text-muted-foreground overflow-auto"><%= e.backtrace.first(5).join("\n") %></pre>
            </div>
          <% else %>
            <p class="text-muted-foreground">Preview not available</p>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="mt-6 rounded-lg border">
      <div class="border-b px-4 py-3">
        <h2 class="font-semibold">Usage</h2>
      </div>
      <div class="p-6">
        <pre class="overflow-x-auto rounded-md bg-muted p-4 text-sm"><code><%= component_usage(@component) %></code></pre>
      </div>
    </div>
  </div>
</div>
