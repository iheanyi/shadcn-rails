<div class="max-w-6xl mx-auto space-y-8" id="theme-customizer">
  <div class="text-center space-y-4">
    <h1 class="text-4xl font-bold">Live Theme Customization</h1>
    <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
      Adjust CSS variables in real-time. Changes are instant - no page reload needed!
    </p>
  </div>

  <!-- Theme Presets & Mode Toggle -->
  <div class="flex flex-wrap items-center justify-center gap-4">
    <!-- Dark Mode Toggle -->
    <div class="flex items-center gap-2 px-4 py-2 rounded-lg border bg-card">
      <span class="text-sm font-medium">Light</span>
      <button
        id="dark-mode-toggle"
        class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors bg-input"
        role="switch"
        aria-checked="false"
      >
        <span class="inline-block h-4 w-4 transform rounded-full bg-background shadow-sm transition-transform translate-x-1"></span>
      </button>
      <span class="text-sm font-medium">Dark</span>
    </div>

    <div class="h-8 w-px bg-border"></div>

    <!-- Theme Presets -->
    <div class="flex flex-wrap gap-2">
      <button class="theme-preset px-3 py-1.5 text-sm font-medium rounded-md border bg-card hover:bg-accent transition-colors" data-theme="neutral">
        <span class="inline-block w-3 h-3 rounded-full mr-1.5 bg-neutral-900"></span>Neutral
      </button>
      <button class="theme-preset px-3 py-1.5 text-sm font-medium rounded-md border bg-card hover:bg-accent transition-colors" data-theme="blue">
        <span class="inline-block w-3 h-3 rounded-full mr-1.5" style="background: hsl(221.2 83.2% 53.3%)"></span>Blue
      </button>
      <button class="theme-preset px-3 py-1.5 text-sm font-medium rounded-md border bg-card hover:bg-accent transition-colors" data-theme="green">
        <span class="inline-block w-3 h-3 rounded-full mr-1.5" style="background: hsl(142.1 76.2% 36.3%)"></span>Green
      </button>
      <button class="theme-preset px-3 py-1.5 text-sm font-medium rounded-md border bg-card hover:bg-accent transition-colors" data-theme="red">
        <span class="inline-block w-3 h-3 rounded-full mr-1.5" style="background: hsl(0 72.2% 50.6%)"></span>Red
      </button>
      <button class="theme-preset px-3 py-1.5 text-sm font-medium rounded-md border bg-card hover:bg-accent transition-colors" data-theme="rose">
        <span class="inline-block w-3 h-3 rounded-full mr-1.5" style="background: hsl(346.8 77.2% 49.8%)"></span>Rose
      </button>
      <button class="theme-preset px-3 py-1.5 text-sm font-medium rounded-md border bg-card hover:bg-accent transition-colors" data-theme="orange">
        <span class="inline-block w-3 h-3 rounded-full mr-1.5" style="background: hsl(24.6 95% 53.1%)"></span>Orange
      </button>
      <button class="theme-preset px-3 py-1.5 text-sm font-medium rounded-md border bg-card hover:bg-accent transition-colors" data-theme="violet">
        <span class="inline-block w-3 h-3 rounded-full mr-1.5" style="background: hsl(262.1 83.3% 57.8%)"></span>Violet
      </button>
    </div>
  </div>

  <!-- Customization Controls -->
  <div class="grid md:grid-cols-2 gap-8">
    <!-- Left: Controls -->
    <div class="space-y-6">
      <%= render Shadcn::CardComponent.new do |card| %>
        <% card.with_header do |header| %>
          <% header.with_title { "Theme Controls" } %>
          <% header.with_description { "Fine-tune CSS variables to see instant changes" } %>
        <% end %>
        <% card.with_content_slot do %>
          <div class="space-y-6">
            <!-- Radius Control -->
            <div class="space-y-2">
              <%= render Shadcn::LabelComponent.new(for: "radius") { "Border Radius" } %>
              <div class="flex items-center gap-4">
                <input type="range" id="radius" min="0" max="20" value="8" class="flex-1 h-2 rounded-full appearance-none bg-secondary cursor-pointer" />
                <span id="radius-value" class="text-sm font-mono w-16 text-right">0.5rem</span>
              </div>
            </div>

            <!-- Primary Color -->
            <div class="space-y-2">
              <%= render Shadcn::LabelComponent.new(for: "primary-hue") { "Primary Color" } %>
              <div class="flex items-center gap-4">
                <input type="range" id="primary-hue" min="0" max="360" value="0" class="flex-1 h-2 rounded-full appearance-none cursor-pointer" style="background: linear-gradient(to right, hsl(0 70% 50%), hsl(60 70% 50%), hsl(120 70% 50%), hsl(180 70% 50%), hsl(240 70% 50%), hsl(300 70% 50%), hsl(360 70% 50%))" />
                <div id="primary-swatch" class="w-6 h-6 rounded border" style="background: hsl(0 0% 9%)"></div>
              </div>
            </div>

            <!-- Secondary Color -->
            <div class="space-y-2">
              <%= render Shadcn::LabelComponent.new(for: "secondary-hue") { "Secondary Color" } %>
              <div class="flex items-center gap-4">
                <input type="range" id="secondary-hue" min="0" max="360" value="0" class="flex-1 h-2 rounded-full appearance-none cursor-pointer" style="background: linear-gradient(to right, hsl(0 10% 90%), hsl(60 10% 90%), hsl(120 10% 90%), hsl(180 10% 90%), hsl(240 10% 90%), hsl(300 10% 90%), hsl(360 10% 90%))" />
                <div id="secondary-swatch" class="w-6 h-6 rounded border" style="background: hsl(0 0% 96.1%)"></div>
              </div>
            </div>

            <!-- Accent Color -->
            <div class="space-y-2">
              <%= render Shadcn::LabelComponent.new(for: "accent-hue") { "Accent Color" } %>
              <div class="flex items-center gap-4">
                <input type="range" id="accent-hue" min="0" max="360" value="0" class="flex-1 h-2 rounded-full appearance-none cursor-pointer" style="background: linear-gradient(to right, hsl(0 10% 90%), hsl(60 10% 90%), hsl(120 10% 90%), hsl(180 10% 90%), hsl(240 10% 90%), hsl(300 10% 90%), hsl(360 10% 90%))" />
                <div id="accent-swatch" class="w-6 h-6 rounded border" style="background: hsl(0 0% 96.1%)"></div>
              </div>
            </div>

            <!-- Destructive Color -->
            <div class="space-y-2">
              <%= render Shadcn::LabelComponent.new(for: "destructive-hue") { "Destructive Color" } %>
              <div class="flex items-center gap-4">
                <input type="range" id="destructive-hue" min="0" max="360" value="0" class="flex-1 h-2 rounded-full appearance-none cursor-pointer" style="background: linear-gradient(to right, hsl(0 84% 60%), hsl(60 84% 60%), hsl(120 84% 60%), hsl(180 84% 60%), hsl(240 84% 60%), hsl(300 84% 60%), hsl(360 84% 60%))" />
                <div id="destructive-swatch" class="w-6 h-6 rounded border" style="background: hsl(0 84.2% 60.2%)"></div>
              </div>
            </div>

            <!-- Reset Button -->
            <div class="pt-4 flex gap-2">
              <%= render Shadcn::ButtonComponent.new(variant: :outline, id: "reset-btn") { "Reset to Defaults" } %>
              <%= render Shadcn::ButtonComponent.new(variant: :secondary, id: "copy-btn") { "Copy CSS" } %>
            </div>
          </div>
        <% end %>
      <% end %>

      <!-- Generated CSS -->
      <%= render Shadcn::CardComponent.new do |card| %>
        <% card.with_header do |header| %>
          <% header.with_title { "Generated CSS" } %>
          <% header.with_description { "Copy this to your stylesheet" } %>
        <% end %>
        <% card.with_content_slot do %>
          <pre class="bg-muted p-4 rounded-lg text-xs font-mono overflow-x-auto max-h-64"><code id="css-output">:root {
  --radius: 0.5rem;
  --primary: 0 0% 9%;
  --primary-foreground: 0 0% 98%;
  --secondary: 0 0% 96.1%;
  --secondary-foreground: 0 0% 9%;
  --accent: 0 0% 96.1%;
  --accent-foreground: 0 0% 9%;
  --destructive: 0 84.2% 60.2%;
}</code></pre>
        <% end %>
      <% end %>
    </div>

    <!-- Right: Live Preview -->
    <div class="space-y-6">
      <%= render Shadcn::CardComponent.new do |card| %>
        <% card.with_header do |header| %>
          <% header.with_title { "Live Preview" } %>
          <% header.with_description { "Real shadcn components responding to CSS variables" } %>
        <% end %>
        <% card.with_content_slot do %>
          <div class="space-y-6">
            <!-- Buttons -->
            <div class="space-y-2">
              <p class="text-sm font-medium">Buttons</p>
              <div class="flex flex-wrap gap-2">
                <%= render Shadcn::ButtonComponent.new { "Primary" } %>
                <%= render Shadcn::ButtonComponent.new(variant: :secondary) { "Secondary" } %>
                <%= render Shadcn::ButtonComponent.new(variant: :destructive) { "Destructive" } %>
                <%= render Shadcn::ButtonComponent.new(variant: :outline) { "Outline" } %>
                <%= render Shadcn::ButtonComponent.new(variant: :ghost) { "Ghost" } %>
              </div>
            </div>

            <!-- Badges -->
            <div class="space-y-2">
              <p class="text-sm font-medium">Badges</p>
              <div class="flex flex-wrap gap-2">
                <%= render Shadcn::BadgeComponent.new { "Default" } %>
                <%= render Shadcn::BadgeComponent.new(variant: :secondary) { "Secondary" } %>
                <%= render Shadcn::BadgeComponent.new(variant: :destructive) { "Destructive" } %>
                <%= render Shadcn::BadgeComponent.new(variant: :outline) { "Outline" } %>
              </div>
            </div>

            <!-- Input -->
            <div class="space-y-2">
              <p class="text-sm font-medium">Input</p>
              <%= render Shadcn::InputComponent.new(placeholder: "Type something...") %>
            </div>

            <!-- Alert -->
            <div class="space-y-2">
              <p class="text-sm font-medium">Alert</p>
              <%= render Shadcn::AlertComponent.new do |alert| %>
                <% alert.with_title { "Heads up!" } %>
                <% alert.with_description { "This alert uses theme colors and border radius." } %>
              <% end %>
            </div>

            <!-- Nested Card -->
            <div class="space-y-2">
              <p class="text-sm font-medium">Nested Card</p>
              <%= render Shadcn::CardComponent.new(class_name: "bg-muted/50") do |inner| %>
                <% inner.with_content_slot do %>
                  <p class="text-sm">Notice how the border radius changes!</p>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>

      <!-- More Components -->
      <%= render Shadcn::CardComponent.new do |card| %>
        <% card.with_header do |header| %>
          <% header.with_title { "More Components" } %>
        <% end %>
        <% card.with_content_slot do %>
          <div class="space-y-4">
            <!-- Progress -->
            <div class="space-y-2">
              <p class="text-sm font-medium">Progress</p>
              <%= render Shadcn::ProgressComponent.new(value: 60) %>
            </div>

            <!-- Switch -->
            <div class="space-y-2">
              <p class="text-sm font-medium">Switch</p>
              <div class="flex items-center gap-2">
                <%= render Shadcn::SwitchComponent.new(checked: true) %>
                <span class="text-sm">Enabled</span>
              </div>
            </div>

            <!-- Checkbox -->
            <div class="space-y-2">
              <p class="text-sm font-medium">Checkbox</p>
              <div class="flex items-center gap-2">
                <%= render Shadcn::CheckboxComponent.new(checked: true) %>
                <span class="text-sm">Checked</span>
              </div>
            </div>

            <!-- Kbd -->
            <div class="space-y-2">
              <p class="text-sm font-medium">Keyboard</p>
              <div class="flex gap-1">
                <%= render Shadcn::KbdComponent.new { "⌘" } %>
                <%= render Shadcn::KbdComponent.new { "K" } %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- How It Works -->
  <div class="space-y-6">
    <%= render Shadcn::CardComponent.new do |card| %>
      <% card.with_header do |header| %>
        <% header.with_title { "How It Works" } %>
        <% header.with_description { "Understanding the CSS variable theming system" } %>
      <% end %>
      <% card.with_content_slot do %>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="space-y-2">
            <h4 class="font-semibold">1. CSS Variables in base.css</h4>
            <p class="text-sm text-muted-foreground">
              All theme values are defined as CSS custom properties in <code class="bg-muted px-1 rounded">:root</code>.
            </p>
            <pre class="bg-muted p-3 rounded text-xs font-mono">:root {
  --primary: 0 0% 9%;
  --radius: 0.5rem;
}</pre>
          </div>

          <div class="space-y-2">
            <h4 class="font-semibold">2. Tailwind Maps Variables</h4>
            <p class="text-sm text-muted-foreground">
              The <code class="bg-muted px-1 rounded">tailwind-v4.css</code> maps Tailwind classes to variables.
            </p>
            <pre class="bg-muted p-3 rounded text-xs font-mono">@theme {
  --color-primary: hsl(var(--primary));
  --radius-lg: var(--radius);
}</pre>
          </div>

          <div class="space-y-2">
            <h4 class="font-semibold">3. Override to Customize</h4>
            <p class="text-sm text-muted-foreground">
              Override variables in your CSS. Changes apply instantly!
            </p>
            <pre class="bg-muted p-3 rounded text-xs font-mono">/* Your custom theme */
:root {
  --primary: 221 83% 53%;
  --radius: 1rem;
}</pre>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

