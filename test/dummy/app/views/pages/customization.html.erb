      light: {
        primary: '262.1 83.3% 57.8%',
        primaryForeground: '210 20% 98%',
        secondary: '220 14.3% 95.9%',
        secondaryForeground: '220.9 39.3% 11%',
        accent: '220 14.3% 95.9%',
        accentForeground: '220.9 39.3% 11%',
        destructive: '0 84.2% 60.2%',
        destructiveForeground: '210 20% 98%',
        background: '0 0% 100%',
        foreground: '224 71.4% 4.1%',
        card: '0 0% 100%',
        cardForeground: '224 71.4% 4.1%',
        muted: '220 14.3% 95.9%',
        mutedForeground: '220 8.9% 46.1%',
        border: '220 13% 91%',
        input: '220 13% 91%',
        ring: '262.1 83.3% 57.8%'
      },
      dark: {
        primary: '263.4 70% 50.4%',
        primaryForeground: '210 20% 98%',
        secondary: '215 27.9% 16.9%',
        secondaryForeground: '210 20% 98%',
        accent: '215 27.9% 16.9%',
        accentForeground: '210 20% 98%',
        destructive: '0 62.8% 30.6%',
        destructiveForeground: '210 20% 98%',
        background: '224 71.4% 4.1%',
        foreground: '210 20% 98%',
        card: '224 71.4% 4.1%',
        cardForeground: '210 20% 98%',
        muted: '215 27.9% 16.9%',
        mutedForeground: '217.9 10.6% 64.9%',
        border: '215 27.9% 16.9%',
        input: '215 27.9% 16.9%',
        ring: '263.4 70% 50.4%'
      }
    }
  };

  // Detect initial dark mode from system preference or existing .dark class
  let isDark = document.documentElement.classList.contains('dark') ||
               window.matchMedia('(prefers-color-scheme: dark)').matches;
  let currentTheme = 'neutral';

  // Elements
  const darkModeToggle = document.getElementById('dark-mode-toggle');
  const radiusSlider = document.getElementById('radius');
  const radiusValue = document.getElementById('radius-value');
  const primarySlider = document.getElementById('primary-hue');
  const primarySwatch = document.getElementById('primary-swatch');
  const secondarySlider = document.getElementById('secondary-hue');
  const secondarySwatch = document.getElementById('secondary-swatch');
  const accentSlider = document.getElementById('accent-hue');
  const accentSwatch = document.getElementById('accent-swatch');
  const destructiveSlider = document.getElementById('destructive-hue');
  const destructiveSwatch = document.getElementById('destructive-swatch');
  const cssOutput = document.getElementById('css-output');
  const resetBtn = document.getElementById('reset-btn');
  const copyBtn = document.getElementById('copy-btn');
  const themePresets = document.querySelectorAll('.theme-preset');

  function applyTheme(themeName, dark = isDark) {
    const theme = themes[themeName];
    if (!theme) return;

    const mode = dark ? theme.dark : theme.light;
    const root = document.documentElement;

    // Apply all CSS variables
    root.style.setProperty('--primary', mode.primary);
    root.style.setProperty('--primary-foreground', mode.primaryForeground);
    root.style.setProperty('--secondary', mode.secondary);
    root.style.setProperty('--secondary-foreground', mode.secondaryForeground);
    root.style.setProperty('--accent', mode.accent);
    root.style.setProperty('--accent-foreground', mode.accentForeground);
    root.style.setProperty('--destructive', mode.destructive);
    root.style.setProperty('--destructive-foreground', mode.destructiveForeground);
    root.style.setProperty('--background', mode.background);
    root.style.setProperty('--foreground', mode.foreground);
    root.style.setProperty('--card', mode.card);
    root.style.setProperty('--card-foreground', mode.cardForeground);
    root.style.setProperty('--muted', mode.muted);
    root.style.setProperty('--muted-foreground', mode.mutedForeground);
    root.style.setProperty('--border', mode.border);
    root.style.setProperty('--input', mode.input);
    root.style.setProperty('--ring', mode.ring);

    // Update swatches
    primarySwatch.style.background = `hsl(${mode.primary})`;
    secondarySwatch.style.background = `hsl(${mode.secondary})`;
    accentSwatch.style.background = `hsl(${mode.accent})`;
    destructiveSwatch.style.background = `hsl(${mode.destructive})`;

    // Update active state
    themePresets.forEach(btn => {
      btn.classList.toggle('ring-2', btn.dataset.theme === themeName);
      btn.classList.toggle('ring-primary', btn.dataset.theme === themeName);
    });

    currentTheme = themeName;
    updateCssOutput();
  }

  function updateCssOutput() {
    const root = document.documentElement;
    const getVar = (name) => getComputedStyle(root).getPropertyValue(name).trim();

    const selector = isDark ? '.dark' : ':root';
    cssOutput.textContent = `${selector} {
  --radius: ${getVar('--radius')};
  --background: ${getVar('--background')};
  --foreground: ${getVar('--foreground')};
  --primary: ${getVar('--primary')};
  --primary-foreground: ${getVar('--primary-foreground')};
  --secondary: ${getVar('--secondary')};
  --secondary-foreground: ${getVar('--secondary-foreground')};
  --accent: ${getVar('--accent')};
  --accent-foreground: ${getVar('--accent-foreground')};
  --destructive: ${getVar('--destructive')};
  --muted: ${getVar('--muted')};
  --muted-foreground: ${getVar('--muted-foreground')};
  --border: ${getVar('--border')};
  --input: ${getVar('--input')};
  --ring: ${getVar('--ring')};
}`;
  }

  // Dark mode toggle
  darkModeToggle.addEventListener('click', function() {
    isDark = !isDark;
    document.documentElement.classList.toggle('dark', isDark);
    this.setAttribute('aria-checked', isDark);
    this.querySelector('span').classList.toggle('translate-x-1', !isDark);
    this.querySelector('span').classList.toggle('translate-x-6', isDark);
    this.classList.toggle('bg-primary', isDark);
    this.classList.toggle('bg-input', !isDark);
    applyTheme(currentTheme, isDark);
  });

  // Theme preset buttons
  themePresets.forEach(btn => {
    btn.addEventListener('click', function() {
      applyTheme(this.dataset.theme);
    });
  });

  // Radius slider
  radiusSlider.addEventListener('input', function(e) {
    const value = e.target.value;
    const rem = (value / 16).toFixed(3).replace(/\.?0+$/, '') + 'rem';
    document.documentElement.style.setProperty('--radius', rem);
    radiusValue.textContent = rem;
    updateCssOutput();
  });

  // Color sliders
  primarySlider.addEventListener('input', function(e) {
    const hue = e.target.value;
    const value = hue == 0 ? (isDark ? '0 0% 98%' : '0 0% 9%') : `${hue} 70% ${isDark ? '60%' : '50%'}`;
    document.documentElement.style.setProperty('--primary', value);
    document.documentElement.style.setProperty('--primary-foreground', isDark ? '0 0% 9%' : '0 0% 98%');
    document.documentElement.style.setProperty('--ring', value);
    primarySwatch.style.background = `hsl(${value})`;
    updateCssOutput();
  });

  secondarySlider.addEventListener('input', function(e) {
    const hue = e.target.value;
    const value = hue == 0 ? (isDark ? '0 0% 14.9%' : '0 0% 96.1%') : `${hue} 10% ${isDark ? '15%' : '96%'}`;
    document.documentElement.style.setProperty('--secondary', value);
    document.documentElement.style.setProperty('--secondary-foreground', isDark ? '0 0% 98%' : '0 0% 9%');
    secondarySwatch.style.background = `hsl(${value})`;
    updateCssOutput();
  });

  accentSlider.addEventListener('input', function(e) {
    const hue = e.target.value;
    const value = hue == 0 ? (isDark ? '0 0% 14.9%' : '0 0% 96.1%') : `${hue} 10% ${isDark ? '15%' : '96%'}`;
    document.documentElement.style.setProperty('--accent', value);
    document.documentElement.style.setProperty('--accent-foreground', isDark ? '0 0% 98%' : '0 0% 9%');
    accentSwatch.style.background = `hsl(${value})`;
    updateCssOutput();
  });

  destructiveSlider.addEventListener('input', function(e) {
    const hue = e.target.value;
    const value = `${hue} 84% ${isDark ? '30%' : '60%'}`;
    document.documentElement.style.setProperty('--destructive', value);
    destructiveSwatch.style.background = `hsl(${value})`;
    updateCssOutput();
  });

  // Reset button
  resetBtn.addEventListener('click', function() {
    // Remove all inline styles
    const root = document.documentElement;
    const vars = ['--radius', '--primary', '--primary-foreground', '--secondary', '--secondary-foreground',
                  '--accent', '--accent-foreground', '--destructive', '--destructive-foreground',
                  '--background', '--foreground', '--card', '--card-foreground', '--muted', '--muted-foreground',
                  '--border', '--input', '--ring'];
    vars.forEach(v => root.style.removeProperty(v));

    // Reset to light mode
    isDark = false;
    root.classList.remove('dark');
    darkModeToggle.setAttribute('aria-checked', 'false');
    darkModeToggle.querySelector('span').classList.add('translate-x-1');
    darkModeToggle.querySelector('span').classList.remove('translate-x-6');
    darkModeToggle.classList.remove('bg-primary');
    darkModeToggle.classList.add('bg-input');

    // Reset sliders
    radiusSlider.value = 8;
    primarySlider.value = 0;
    secondarySlider.value = 0;
    accentSlider.value = 0;
    destructiveSlider.value = 0;

    // Reset display
    radiusValue.textContent = '0.5rem';
    primarySwatch.style.background = 'hsl(0 0% 9%)';
    secondarySwatch.style.background = 'hsl(0 0% 96.1%)';
    accentSwatch.style.background = 'hsl(0 0% 96.1%)';
    destructiveSwatch.style.background = 'hsl(0 84.2% 60.2%)';

    // Reset theme buttons
    themePresets.forEach(btn => {
      btn.classList.remove('ring-2', 'ring-primary');
    });
    currentTheme = 'neutral';

    updateCssOutput();
  });

  // Copy button
  copyBtn.addEventListener('click', function() {
    navigator.clipboard.writeText(cssOutput.textContent).then(() => {
      const originalText = this.textContent;
      this.textContent = 'Copied!';
      setTimeout(() => { this.textContent = originalText; }, 2000);
    });
  });

  // Initialize dark mode state on page load
  if (isDark) {
    document.documentElement.classList.add('dark');
    darkModeToggle.setAttribute('aria-checked', 'true');
    darkModeToggle.querySelector('span').classList.remove('translate-x-1');
    darkModeToggle.querySelector('span').classList.add('translate-x-6');
    darkModeToggle.classList.add('bg-primary');
    darkModeToggle.classList.remove('bg-input');
  }

  // Apply the default theme with correct mode
  applyTheme(currentTheme, isDark);
});
</script>
