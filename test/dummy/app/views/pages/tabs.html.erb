<div class="max-w-4xl mx-auto space-y-12">
  <div>
    <h1 class="text-3xl font-bold">Tabs</h1>
    <p class="mt-2 text-muted-foreground">A set of layered sections of content, known as tab panels, that display one panel at a time.</p>
  </div>

  <section class="space-y-4">
    <h2 class="text-xl font-semibold">Default</h2>
    <p class="text-sm text-muted-foreground">Basic tabs with text content.</p>
    <%= render Shadcn::TabsComponent.new(default_value: "account") do |tabs| %>
      <% tabs.with_list do |list| %>
        <% list.with_trigger(value: "account") { "Account" } %>
        <% list.with_trigger(value: "password") { "Password" } %>
      <% end %>
      <% tabs.with_panel(value: "account") do %>
        <div class="p-4 border rounded-lg mt-2">
          <h3 class="font-medium">Account Settings</h3>
          <p class="text-sm text-muted-foreground mt-2">Make changes to your account here. Click save when you're done.</p>
          <div class="mt-4 space-y-4">
            <div>
              <%= render Shadcn::InputComponent.new(type: "text", placeholder: "Name", value: "John Doe") %>
            </div>
            <div>
              <%= render Shadcn::InputComponent.new(type: "email", placeholder: "Email", value: "john@example.com") %>
            </div>
            <%= render(Shadcn::ButtonComponent.new) { "Save changes" } %>
          </div>
        </div>
      <% end %>
      <% tabs.with_panel(value: "password") do %>
        <div class="p-4 border rounded-lg mt-2">
          <h3 class="font-medium">Password</h3>
          <p class="text-sm text-muted-foreground mt-2">Change your password here. After saving, you'll be logged out.</p>
          <div class="mt-4 space-y-4">
            <div>
              <%= render Shadcn::InputComponent.new(type: "password", placeholder: "Current password") %>
            </div>
            <div>
              <%= render Shadcn::InputComponent.new(type: "password", placeholder: "New password") %>
            </div>
            <%= render(Shadcn::ButtonComponent.new) { "Change password" } %>
          </div>
        </div>
      <% end %>
    <% end %>
  </section>

  <section class="space-y-4">
    <h2 class="text-xl font-semibold">With Cards</h2>
    <p class="text-sm text-muted-foreground">Tabs with card-styled content panels.</p>
    <%= render Shadcn::TabsComponent.new(default_value: "overview") do |tabs| %>
      <% tabs.with_list do |list| %>
        <% list.with_trigger(value: "overview") { "Overview" } %>
        <% list.with_trigger(value: "analytics") { "Analytics" } %>
        <% list.with_trigger(value: "reports") { "Reports" } %>
        <% list.with_trigger(value: "notifications") { "Notifications" } %>
      <% end %>
      <% tabs.with_panel(value: "overview") do %>
        <%= render Shadcn::CardComponent.new(class: "mt-2") do |card| %>
          <% card.with_header do |header| %>
            <% header.with_title { "Overview" } %>
            <% header.with_description { "Your account overview and activity summary." } %>
          <% end %>
          <% card.with_content_slot do %>
            <div class="space-y-2">
              <div class="flex justify-between items-center p-3 bg-muted rounded-lg">
                <span class="text-sm font-medium">Total Projects</span>
                <span class="text-2xl font-bold">12</span>
              </div>
              <div class="flex justify-between items-center p-3 bg-muted rounded-lg">
                <span class="text-sm font-medium">Active Tasks</span>
                <span class="text-2xl font-bold">24</span>
              </div>
            </div>
          <% end %>
        <% end %>
      <% end %>
      <% tabs.with_panel(value: "analytics") do %>
        <%= render Shadcn::CardComponent.new(class: "mt-2") do |card| %>
          <% card.with_header do |header| %>
            <% header.with_title { "Analytics" } %>
            <% header.with_description { "Track your performance metrics." } %>
          <% end %>
          <% card.with_content_slot do %>
            <p class="text-sm text-muted-foreground">Analytics dashboard coming soon...</p>
          <% end %>
        <% end %>
      <% end %>
      <% tabs.with_panel(value: "reports") do %>
        <%= render Shadcn::CardComponent.new(class: "mt-2") do |card| %>
          <% card.with_header do |header| %>
            <% header.with_title { "Reports" } %>
            <% header.with_description { "Generate and download reports." } %>
          <% end %>
          <% card.with_content_slot do %>
            <div class="space-y-2">
              <%= render(Shadcn::ButtonComponent.new(variant: :outline)) { "Download Weekly Report" } %>
              <%= render(Shadcn::ButtonComponent.new(variant: :outline)) { "Download Monthly Report" } %>
            </div>
          <% end %>
        <% end %>
      <% end %>
      <% tabs.with_panel(value: "notifications") do %>
        <%= render Shadcn::CardComponent.new(class: "mt-2") do |card| %>
          <% card.with_header do |header| %>
            <% header.with_title { "Notifications" } %>
            <% header.with_description { "Configure your notification preferences." } %>
          <% end %>
          <% card.with_content_slot do %>
            <p class="text-sm text-muted-foreground">Notification settings panel...</p>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </section>

  <section class="space-y-4">
    <h2 class="text-xl font-semibold">URL Sync</h2>
    <p class="text-sm text-muted-foreground">Tabs that sync with URL query parameters. Click a tab and notice the URL changes. You can also bookmark or share specific tabs!</p>
    <%= render Shadcn::TabsComponent.new(default_value: "general", url_param: "settings") do |tabs| %>
      <% tabs.with_list do |list| %>
        <% list.with_trigger(value: "general") { "General" } %>
        <% list.with_trigger(value: "security") { "Security" } %>
        <% list.with_trigger(value: "billing") { "Billing" } %>
      <% end %>
      <% tabs.with_panel(value: "general") do %>
        <div class="p-4 border rounded-lg mt-2">
          <h3 class="font-medium">General Settings</h3>
          <p class="text-sm text-muted-foreground mt-2">Configure your general preferences. Notice the URL now shows <code class="bg-muted px-1 rounded">?settings=general</code></p>
        </div>
      <% end %>
      <% tabs.with_panel(value: "security") do %>
        <div class="p-4 border rounded-lg mt-2">
          <h3 class="font-medium">Security Settings</h3>
          <p class="text-sm text-muted-foreground mt-2">Manage your security options. The URL shows <code class="bg-muted px-1 rounded">?settings=security</code></p>
        </div>
      <% end %>
      <% tabs.with_panel(value: "billing") do %>
        <div class="p-4 border rounded-lg mt-2">
          <h3 class="font-medium">Billing Settings</h3>
          <p class="text-sm text-muted-foreground mt-2">Update your billing information. The URL shows <code class="bg-muted px-1 rounded">?settings=billing</code></p>
        </div>
      <% end %>
    <% end %>
  </section>

  <section class="space-y-4">
    <h2 class="text-xl font-semibold">Disabled Tab</h2>
    <p class="text-sm text-muted-foreground">Tabs with a disabled option.</p>
    <%= render Shadcn::TabsComponent.new(default_value: "active") do |tabs| %>
      <% tabs.with_list do |list| %>
        <% list.with_trigger(value: "active") { "Active" } %>
        <% list.with_trigger(value: "disabled", disabled: true) { "Disabled" } %>
        <% list.with_trigger(value: "another") { "Another" } %>
      <% end %>
      <% tabs.with_panel(value: "active") do %>
        <div class="p-4 border rounded-lg mt-2">
          <p class="text-sm">This is the active tab content.</p>
        </div>
      <% end %>
      <% tabs.with_panel(value: "disabled") do %>
        <div class="p-4 border rounded-lg mt-2">
          <p class="text-sm">You can't see this because the tab is disabled.</p>
        </div>
      <% end %>
      <% tabs.with_panel(value: "another") do %>
        <div class="p-4 border rounded-lg mt-2">
          <p class="text-sm">This is another tab content.</p>
        </div>
      <% end %>
    <% end %>
  </section>
</div>
